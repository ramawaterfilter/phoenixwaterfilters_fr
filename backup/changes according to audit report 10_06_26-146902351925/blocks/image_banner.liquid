
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .banner-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .banner-background-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height_desktop }}px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner-background-{{ ai_gen_id }}--desktop {
    {% if block.settings.desktop_image %}
      background-image: url('{{ block.settings.desktop_image | image_url: width: 2000 }}');
    {% else %}
      background-color: #f4f4f4;
    {% endif %}
  }

  .banner-background-{{ ai_gen_id }}--mobile {
    display: none;
  }

  .banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .banner-content-wrapper-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top_desktop }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom_desktop }}px;
    width: 100%;
  }

  .banner-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .banner-heading-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    line-height: 1.2;
    margin: 0;
  }

  .banner-text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_button_gap }}px;
    justify-content: center;
    align-items: center;
  }

  .banner-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size_desktop }}px;
    line-height: 1.5;
    margin: 0;
    text-align: center;
  }

  .banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    cursor: pointer;
  }

  .banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .banner-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height_desktop }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .banner-background-{{ ai_gen_id }}--desktop {
      display: none;
    }

    .banner-background-{{ ai_gen_id }}--mobile {
      display: flex;
      min-height: {{ block.settings.min_height_mobile }}px;
      {% if block.settings.mobile_image %}
        background-image: url('{{ block.settings.mobile_image | image_url: width: 1000 }}');
      {% elsif block.settings.desktop_image %}
        background-image: url('{{ block.settings.desktop_image | image_url: width: 1000 }}');
      {% else %}
        background-color: #f4f4f4;
      {% endif %}
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .banner-content-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .banner-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_stack_gap }}px;
      text-align: center;
    }

    .banner-heading-column-{{ ai_gen_id }} {
      text-align: center;
    }

    .banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .banner-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .banner-placeholder-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }
  }
{% endstyle %}

<banner-block-{{ ai_gen_id }} class="banner-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.desktop_image or block.settings.mobile_image %}
    <div class="banner-background-{{ ai_gen_id }} banner-background-{{ ai_gen_id }}--desktop">
      <div class="banner-overlay-{{ ai_gen_id }}"></div>
      <div class="banner-content-wrapper-{{ ai_gen_id }}">
        <div class="banner-grid-{{ ai_gen_id }}">
          <div class="banner-heading-column-{{ ai_gen_id }}">
            {% if block.settings.heading != blank %}
              <h2 class="banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
            {% endif %}
          </div>
          <div class="banner-text-column-{{ ai_gen_id }}">
            {% if block.settings.text != blank %}
              <div class="banner-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="banner-button-{{ ai_gen_id }}">
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <div class="banner-background-{{ ai_gen_id }} banner-background-{{ ai_gen_id }}--mobile">
      <div class="banner-overlay-{{ ai_gen_id }}"></div>
      <div class="banner-content-wrapper-{{ ai_gen_id }}">
        <div class="banner-grid-{{ ai_gen_id }}">
          <div class="banner-heading-column-{{ ai_gen_id }}">
            {% if block.settings.heading != blank %}
              <h2 class="banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
            {% endif %}
          </div>
          <div class="banner-text-column-{{ ai_gen_id }}">
            {% if block.settings.text != blank %}
              <div class="banner-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="banner-button-{{ ai_gen_id }}">
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div class="banner-placeholder-{{ ai_gen_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
      <div class="banner-empty-state-{{ ai_gen_id }}">
        Next, add desktop and mobile background images
      </div>
    </div>
  {% endif %}
</banner-block-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('banner-block-{{ ai_gen_id }}', BannerBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
