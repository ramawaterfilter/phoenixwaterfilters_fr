{% doc %}
  @prompt
    i neeed the collection section to add the colection its selft jest select the collection and show the collection product 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-collection-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.spacing_below_title }}px;
  }

  .ai-collection-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-collection-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-collection-grid__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.spacing_above_grid }}px;
  }

  .ai-collection-grid__product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
    margin-bottom: 12px;
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-grid__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-grid__product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-collection-grid__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-collection-grid__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} {
    display: inline-block;
    max-width: 170px;
    overflow: visible;
    color: #002b5c;
    font-size: 16px;
    line-height: 1.15;
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} .jdgm-prev-badge {
    display: inline-block !important;
    overflow: visible;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} .jdgm-prev-badge__stars {
    display: inline-flex !important;
    align-items: center;
    overflow: visible;
    color: #ffad32;
    font-size: 16px;
    line-height: 1;
    margin-right: 0;
    vertical-align: middle;
    margin-bottom: 5px;
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} .jdgm-star {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 15px !important;
    height: 15px !important;
    margin: 0 3px 0 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain !important;
    color: #ffad32 !important;
    font-size: 16px !important;
    line-height: 1 !important;
    vertical-align: middle;
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} .jdgm-star:before {
    color: inherit !important;
    font-size: inherit !important;
    line-height: 1 !important;
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} .jdgm-star:last-child {
    margin-right: 3px !important;
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} .jdgm-prev-badge__text {
    display: inline;
    color: #002b5c;
    font-size: 16px;
    line-height: 1.15;
    text-transform: uppercase;
    vertical-align: baseline;
  }

  .ai-collection-grid__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-collection-grid__empty-state-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  .ai-collection-grid__empty-message-{{ ai_gen_id }} {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .ai-collection-grid__empty-hint-{{ ai_gen_id }} {
    font-size: 14px;
    color: #999;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-grid__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-collection-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-collection-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-collection-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }
  }
{% endstyle %}

<div class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% if block.settings.collection != blank %}
      {% if block.settings.show_collection_title or block.settings.show_collection_description %}
        <div class="ai-collection-grid__header-{{ ai_gen_id }}">
          {% if block.settings.show_collection_title and block.settings.collection.title != blank %}
            <h2 class="ai-collection-grid__title-{{ ai_gen_id }}">
              {{ block.settings.collection.title }}
            </h2>
          {% endif %}
          {% if block.settings.show_collection_description and block.settings.collection.description != blank %}
            <div class="ai-collection-grid__description-{{ ai_gen_id }}">
              {{ block.settings.collection.description }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.collection.products.size > 0 %}
        <div class="ai-collection-grid__products-{{ ai_gen_id }}">
          {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
            <a href="{{ product.url }}" class="ai-collection-grid__product-{{ ai_gen_id }}">
              <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-collection-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-collection-grid__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-collection-grid__product-info-{{ ai_gen_id }}">
                <h3 class="ai-collection-grid__product-title-{{ ai_gen_id }}">
                  {{ product.title }}
                </h3>

            {% comment %} <!-- Start of Judge.me code --> {% endcomment %}
      <div class='ai-collection-grid__rating-{{ ai_gen_id }} jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
      </div>
      <!-- End of Judge.me code -->
 {% comment %}Modified on June 3, for Appstle      {% endcomment %}
                <div class="ai-collection-grid__product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-collection-grid__empty-state-{{ ai_gen_id }}">
          {{ 'collection-1' | placeholder_svg_tag }}
          <div class="ai-collection-grid__empty-message-{{ ai_gen_id }}">
            This collection is empty
          </div>
          <div class="ai-collection-grid__empty-hint-{{ ai_gen_id }}">
            Add products to this collection to display them here
          </div>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-collection-grid__empty-state-{{ ai_gen_id }}">
        {{ 'collection-1' | placeholder_svg_tag }}
        <div class="ai-collection-grid__empty-message-{{ ai_gen_id }}">
          Select a collection
        </div>
        <div class="ai-collection-grid__empty-hint-{{ ai_gen_id }}">
          Choose a collection from the block settings to display products
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 50,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Collection info"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": false
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on tablet",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Grid gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "spacing_below_title",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Spacing below title",
      "default": 30
    },
    {
      "type": "range",
      "id": "spacing_above_grid",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Spacing above grid",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Product title size",
      "default": 16
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Product price",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "product_price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Product price size",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Collection products"
    }
  ]
}
{% endschema %}
