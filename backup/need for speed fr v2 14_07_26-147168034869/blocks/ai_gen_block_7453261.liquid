
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .responsive-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height_desktop }}px;
    overflow: hidden;
    display: block;
  }

  .responsive__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
.responsive__container-{{ ai_gen_id }} {
  align-items: center !important;
  justify-content: center !important;
}

.responsive__content-{{ ai_gen_id }} {
  margin: 0 auto;
}
.responsive__video-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
  .responsive__video-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
  }

  .responsive__wistia-container-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .responsive__wistia-container-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: 100vw;
    height: 100vh;
    transform: translate(-50%, -50%);
    border: none;
  }

  .responsive__fallback-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .responsive__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .responsive__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .responsive__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), rgba(0, 0, 0, {{ block.settings.overlay_opacity | times: 0.5 }}));
    z-index: 2;
  }

  .responsive__container-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.content_vertical_alignment_desktop }};
    padding: {{ block.settings.section_padding_desktop }}px 40px;
  }

  .responsive__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
    text-align: {{ block.settings.text_alignment_desktop }};
  }

  .responsive__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: 700;
    line-height: 1.1;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
  }

  .responsive__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size_desktop }}px;
    line-height: 1.5;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 16px;
  }

  .responsive__rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    {% if block.settings.text_alignment_desktop == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment_desktop == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .responsive__stars-{{ ai_gen_id }} {
    display: inline-flex;
    gap: 2px;
    font-size: {{ block.settings.rating_size_desktop }}px;
    line-height: 1;
  }

  .responsive__star-{{ ai_gen_id }} {
    position: relative;
    display: inline-block;
    color: {{ block.settings.star_empty_color }};
  }

  .responsive__star-fill-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    color: {{ block.settings.star_color }};
  }

  .responsive__rating-text-{{ ai_gen_id }} {
    color: {{ block.settings.rating_text_color }};
    font-size: {{ block.settings.rating_size_desktop }}px;
    line-height: 1;
  }

  .responsive__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 50px;
    font-size: {{ block.settings.button_size_desktop }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    cursor: pointer;
  }

  .responsive__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .responsive__video-mobile-{{ ai_gen_id }},
  .responsive__wistia-mobile-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .responsive-{{ ai_gen_id }} {
      height: {{ block.settings.section_height_mobile }}px;
    }

    .responsive__container-{{ ai_gen_id }} {
      align-items: {{ block.settings.content_vertical_alignment_mobile }};
      padding: {{ block.settings.section_padding_mobile }}px 20px;
    }

    .responsive__content-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_alignment_mobile }};
    }

    .responsive__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .responsive__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .responsive__stars-{{ ai_gen_id }},
    .responsive__rating-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.rating_size_mobile }}px;
    }

    .responsive__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size_mobile }}px;
      padding: 14px 32px;
      border-width: {{ block.settings.button_border_width_mobile }}px;
    }

    .responsive__rating-{{ ai_gen_id }} {
      {% if block.settings.text_alignment_mobile == 'center' %}
        justify-content: center;
      {% elsif block.settings.text_alignment_mobile == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .responsive__video-{{ ai_gen_id }},
    .responsive__wistia-container-{{ ai_gen_id }} {
      display: none;
    }

    .responsive__video-mobile-{{ ai_gen_id }},
    .responsive__wistia-mobile-{{ ai_gen_id }} {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    .responsive__video-mobile-{{ ai_gen_id }} {
      min-width: 100%;
      min-height: 100%;
      object-fit: cover;
    }

    .responsive__wistia-mobile-{{ ai_gen_id }} iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      min-width: 100%;
      min-height: 100%;
      border: none;
    }
  }

  {{ block.settings.custom_css }}
{% endstyle %}

<video-hero-{{ ai_gen_id }} class="responsive-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="responsive__background-{{ ai_gen_id }}">
    {% if block.settings.wistia_video_id != blank %}
      <div class="responsive__wistia-container-{{ ai_gen_id }}">
        <div class="wistia_embed wistia_async_{{ block.settings.wistia_video_id }} videoFoam=true autoPlay=true muted=true endVideoBehavior=loop" style="position:absolute;top:0;left:0;width:100%;height:100%;"></div>
      </div>
    {% elsif block.settings.video_url != blank %}
      <video
        class="responsive__video-{{ ai_gen_id }}"
        autoplay
        muted
        loop
        playsinline
        {% if block.settings.fallback_image %}
          poster="{{ block.settings.fallback_image | image_url: width: 2000 }}"
        {% endif %}
      >
        <source src="{{ block.settings.video_url }}" type="video/mp4">
      </video>
    {% endif %}

    {% if block.settings.wistia_video_id_mobile != blank %}
      <div class="responsive__wistia-mobile-{{ ai_gen_id }}">
        <div class="wistia_embed wistia_async_{{ block.settings.wistia_video_id_mobile }} videoFoam=true autoPlay=true muted=true endVideoBehavior=loop" style="position:absolute;top:0;left:0;width:100%;height:100%;"></div>
      </div>
    {% elsif block.settings.video_url_mobile != blank %}
      <video
        class="responsive__video-mobile-{{ ai_gen_id }}"
        autoplay
        muted
        loop
        playsinline
        {% if block.settings.fallback_image %}
          poster="{{ block.settings.fallback_image | image_url: width: 2000 }}"
        {% endif %}
      >
        <source src="{{ block.settings.video_url_mobile }}" type="video/mp4">
      </video>
    {% elsif block.settings.fallback_image %}
      <img
        src="{{ block.settings.fallback_image | image_url: width: 2000 }}"
        alt="{{ block.settings.fallback_image_alt | escape }}"
        class="responsive__fallback-image-{{ ai_gen_id }}"
        loading="eager"
        width="{{ block.settings.fallback_image.width }}"
        height="{{ block.settings.fallback_image.height }}"
      >
    {% endif %}

    {% if block.settings.wistia_video_id == blank and block.settings.video_url == blank and block.settings.wistia_video_id_mobile == blank and block.settings.video_url_mobile == blank and block.settings.fallback_image == blank %}
      <div class="responsive__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="responsive__overlay-{{ ai_gen_id }}"></div>

  <div class="responsive__container-{{ ai_gen_id }}">
    <div class="responsive__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="responsive__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="responsive__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}

      {% if block.settings.show_rating %}
        <div class="responsive__rating-{{ ai_gen_id }}">
          <div class="responsive__stars-{{ ai_gen_id }}">
            {% assign rating_percentage = block.settings.rating_percentage %}
            {% assign full_stars = rating_percentage | divided_by: 20 %}
            {% assign remainder = rating_percentage | modulo: 20 %}
            {% assign next_star = full_stars | plus: 1 %}
            
            {% for i in (1..5) %}
              <span class="responsive__star-{{ ai_gen_id }}">
                ★
                {% if i <= full_stars %}
                  <span class="responsive__star-fill-{{ ai_gen_id }}" style="width: 100%;">★</span>
                {% elsif i == next_star and remainder > 0 %}
                  {% assign partial_width = remainder | times: 5 %}
                  <span class="responsive__star-fill-{{ ai_gen_id }}" style="width: {{ partial_width }}%;">★</span>
                {% endif %}
              </span>
            {% endfor %}
          </div>
          {% if block.settings.rating_text != blank %}
            <span class="responsive__rating-text-{{ ai_gen_id }}">{{ block.settings.rating_text }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="responsive__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</video-hero-{{ ai_gen_id }}>

{% if block.settings.wistia_video_id != blank or block.settings.wistia_video_id_mobile != blank %}
  <script src="https://fast.wistia.com/assets/external/E-v1.js" async></script>
{% endif %}

<script>
  (function() {
    class VideoHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const videos = this.querySelectorAll('.responsive__video-{{ ai_gen_id }}, .responsive__video-mobile-{{ ai_gen_id }}');
        videos.forEach(function(video) {
          video.play().catch(function(error) {
            console.log('Video autoplay failed:', error);
          });
        });
      }
    }

    customElements.define('video-hero-{{ ai_gen_id }}', VideoHero{{ ai_gen_id }});
  })();
</script>

