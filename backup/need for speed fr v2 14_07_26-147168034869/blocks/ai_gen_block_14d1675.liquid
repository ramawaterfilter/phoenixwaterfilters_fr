{% doc %}
  @prompt
    Create a fully customizable hero section for a Shopify theme.
    
    Requirements:
    1. Allow uploading **two separate images**:
       - One image for **desktop view**.
       - One image for **mobile view**.
       When the screen width is below 768px, automatically switch to the mobile image.
    
    2. Add fields in the section settings for:
       - Desktop image (Shopify image picker)
       - Mobile image (Shopify image picker)
       - Heading text
       - Subheading text
       - Optional button (text + link)
       - Custom section width and height (adjustable in pixels or percentages)
       - A “Custom CSS” text area for users to manually enter custom CSS that applies only to this section.
    
    3. Layout:
       - Center-align the text content over the hero image.
       - Ensure text remains legible with an optional overlay (adjustable opacity via settings).
       - Maintain full width for the hero image but respect the user-defined height.
       - Make the layout responsive and mobile-friendly.
    
    4. Styling:
       - Use modern, minimal Shopify theme style.
       - White or transparent text overlay with optional color picker.
       - Rounded corners optional (toggle setting).
       - Soft shadow optional (toggle setting).
    
    5. Functionality:
       - When the user adds custom CSS in the editor, it should inject into a `<style>` block scoped to this section only.
       - The section should automatically use the correct image (desktop or mobile) based on viewport width.
       - Ensure Liquid variables are used properly — no raw Liquid text should appear in the frontend.
    
    6. Example behavior:
       - On desktop: show wide image (e.g. 1600x600) with heading and button centered.
       - On mobile: show tall image (e.g. 400x500) with text adjusted for readability.
    
    Goal:
    Create a clean, editable hero section where store owners can:
    - Upload desktop and mobile images manually,
    - Adjust width and height easily,
    - Add heading/subheading/button,
    - Add their own custom CSS from the theme editor for full control.
    
    Ensure all CSS and Liquid code render correctly and, i need adjetable mbolie heght and width and desctoip height and width , in height and width all adject in the pixels 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-section-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.section_width_desktop }}px;
    height: {{ block.settings.section_height_desktop }}px;
    margin: 0 auto;
    overflow: hidden;
    {% if block.settings.enable_rounded_corners %}
      border-radius: {{ block.settings.corner_radius }}px;
    {% endif %}
    {% if block.settings.enable_shadow %}
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    {% endif %}
  }

  .ai-hero-section__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-hero-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero-section__image-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-section__image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-section__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-hero-section__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    width: 90%;
    max-width: 800px;
  }

  .ai-hero-section__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-hero-section__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .ai-hero-section__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-hero-section__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .ai-hero-section-{{ ai_gen_id }} {
      width: {{ block.settings.section_width_mobile }}px;
      height: {{ block.settings.section_height_mobile }}px;
    }

    .ai-hero-section__image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-section__image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-section__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-hero-section__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-hero-section__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.85 }}px {{ block.settings.button_padding_horizontal | times: 0.85 }}px;
    }
  }

  {% if block.settings.custom_css != blank %}
    {{ block.settings.custom_css }}
  {% endif %}
{% endstyle %}

<div class="ai-hero-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-section__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.desktop_image %}
      <img
        src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
        alt="{{ block.settings.desktop_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.desktop_image.width }}"
        height="{{ block.settings.desktop_image.height }}"
        class="ai-hero-section__image-{{ ai_gen_id }} ai-hero-section__image-desktop-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-section__image-{{ ai_gen_id }} ai-hero-section__image-desktop-{{ ai_gen_id }}" style="background-color: #f4f4f4; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.mobile_image %}
      <img
        src="{{ block.settings.mobile_image | image_url: width: 800 }}"
        alt="{{ block.settings.mobile_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.mobile_image.width }}"
        height="{{ block.settings.mobile_image.height }}"
        class="ai-hero-section__image-{{ ai_gen_id }} ai-hero-section__image-mobile-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-section__image-{{ ai_gen_id }} ai-hero-section__image-mobile-{{ ai_gen_id }}" style="background-color: #f4f4f4; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.enable_overlay %}
    <div class="ai-hero-section__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-hero-section__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-hero-section__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-hero-section__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-hero-section__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero section",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
