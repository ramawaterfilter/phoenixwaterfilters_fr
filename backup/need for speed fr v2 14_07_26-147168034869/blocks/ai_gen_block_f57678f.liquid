
{% assign gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .hero-section-{{ gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.section_height_desktop }}vh;
    overflow: hidden;
    display: block;
  }
/* ===== FORCE HERO OVERLAY FIX ===== */

.hero-section-{{ section.id }} {
  position: relative !important;
  width: 100% !important;
  height: {{ section.settings.height_desktop }} !important;
  overflow: hidden !important;
}

/* VIDEO BACKGROUND */
.hero-media-{{ section.id }} {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 1 !important;
}

/* VIDEO + IFRAME */
.hero-media-{{ section.id }} video,
.hero-media-{{ section.id }} iframe,
.hero-media-{{ section.id }} img {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
}

/* OVERLAY */
.hero-overlay-{{ section.id }} {
  position: absolute !important;+
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 2 !important;
}

/* 🚨 THIS IS THE MAIN FIX */
.hero-content-wrapper-{{ section.id }} {
  position: absolute !important;  /* 🔥 forces overlay */
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 3 !important;

  display: flex !important;
  align-items: {{ section.settings.vertical_align }} !important;
}

/* CONTENT BOX */
.hero-content-{{ section.id }} {
  position: relative !important;
  z-index: 4 !important;
  max-width: {{ section.settings.content_width }}px;
  margin-left: 0;
  margin-right: auto;
  padding: {{ section.settings.padding_desktop }}px 40px;
  color: #fff;
}

/* MOBILE FIX */
@media (max-width: 768px) {

  .hero-section-{{ section.id }} {
    height: {{ section.settings.height_mobile }} !important;
  }

  .hero-content-wrapper-{{ section.id }} {
    justify-content: center !important;
    text-align: center !important;
  }

  .hero-content-{{ section.id }} {
    margin: 0 auto !important;
    padding: {{ section.settings.padding_mobile }}px 20px;
  }
}
  @media screen and (max-width: 749px) {
    .hero-section-{{ gen_id }} {
      height: {{ block.settings.section_height_mobile }}vh;
    }
  }

  .hero-video-container-{{ gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-video-{{ gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video-desktop-{{ gen_id }} {
    display: block;
  }

  .hero-video-mobile-{{ gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .hero-video-desktop-{{ gen_id }} {
      display: {% if block.settings.mobile_use_fallback %}none{% else %}none{% endif %};
    }

    .hero-video-mobile-{{ gen_id }} {
      display: {% if block.settings.mobile_use_fallback %}none{% else %}block{% endif %};
    }
  }

  .hero-fallback-image-{{ gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .hero-overlay-{{ gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, {{ block.settings.overlay_color }}00, {{ block.settings.overlay_color }});
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

.hero-content-wrapper-{{ gen_id }} {
  position: absolute;
  inset: 0;
  z-index: 3;

  display: flex;
  align-items: {{ block.settings.content_vertical_alignment_desktop }};
}
.hero-section-{{ gen_id }} {
  display: grid;
}

.hero-section-{{ gen_id }} > * {
  grid-area: 1 / 1;
}
.hero-section-{{ gen_id }} {
  position: relative;
  display: block;   /* 🔥 important */
}
  @media screen and (max-width: 749px) {
    .hero-content-wrapper-{{ gen_id }} {
      align-items: {{ block.settings.content_vertical_alignment_mobile }};
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }
  }

  .hero-content-{{ gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
    text-align: {{ block.settings.text_alignment_desktop }};
  }

  @media screen and (max-width: 749px) {
    .hero-content-{{ gen_id }} {
      text-align: {{ block.settings.text_alignment_mobile }};
      margin: 0 auto;
    }
  }

  .hero-heading-{{ gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_heading_subheading }}px;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .hero-heading-{{ gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }
  }

  .hero-subheading-{{ gen_id }} {
    font-size: {{ block.settings.subheading_size_desktop }}px;
    line-height: 1.5;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.spacing_subheading_rating }}px;
  }

  .hero-subheading-{{ gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .hero-subheading-{{ gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }
  }

  .hero-rating-{{ gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: {{ block.settings.spacing_rating_button }}px;
    justify-content: {{ block.settings.text_alignment_desktop }};
  }

  @media screen and (max-width: 749px) {
    .hero-rating-{{ gen_id }} {
      justify-content: {{ block.settings.text_alignment_mobile }};
    }
  }

  .hero-stars-{{ gen_id }} {
    display: flex;
    gap: 2px;
  }

  .hero-star-{{ gen_id }} {
    width: 20px;
    height: 20px;
    position: relative;
  }

  .hero-star-full-{{ gen_id }} {
    color: {{ block.settings.star_color }};
  }

  .hero-star-empty-{{ gen_id }} {
    color: #d1d5db;
  }

  .hero-star-partial-{{ gen_id }} {
    position: relative;
    color: #d1d5db;
  }

  .hero-star-partial-fill-{{ gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    color: {{ block.settings.star_color }};
  }

  .hero-rating-text-{{ gen_id }} {
    font-size: 14px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
  }

  .hero-button-{{ gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .hero-button-{{ gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  {% if block.settings.enable_fade_animation %}
    @keyframes hero-fade-in-{{ gen_id }} {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-content-{{ gen_id }} {
      animation: hero-fade-in-{{ gen_id }} 1s ease-out;
    }
  {% endif %}

  {% if block.settings.custom_css != blank %}
    {{ block.settings.custom_css }}
  {% endif %}
{% endstyle %}

{% comment %} <hero-section-{{ gen_id }} class="hero-section-{{ gen_id }}" {{ block.shopify_attributes }}> {% endcomment %}
  <div class="hero-video-container-{{ gen_id }}">
    {% if block.settings.desktop_video_url != blank or block.settings.desktop_wistia_id != blank %}
      {% if block.settings.desktop_wistia_id != blank %}
        <iframe
          src="https://fast.wistia.net/embed/iframe/{{ block.settings.desktop_wistia_id }}?autoplay=1&muted=1&loop=1&controls=0&playbar=0"
          class="hero-video-{{ gen_id }} hero-video-desktop-{{ gen_id }}"
          allow="autoplay; fullscreen"
          allowfullscreen
          frameborder="0"
        ></iframe>
      {% elsif block.settings.desktop_video_url != blank %}
        <video
          class="hero-video-{{ gen_id }} hero-video-desktop-{{ gen_id }}"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="{{ block.settings.desktop_video_url }}" type="video/mp4">
        </video>
      {% endif %}
    {% endif %}

    {% if block.settings.mobile_video_url != blank or block.settings.mobile_wistia_id != blank %}
      {% if block.settings.mobile_wistia_id != blank %}
        <iframe
          src="https://fast.wistia.net/embed/iframe/{{ block.settings.mobile_wistia_id }}?autoplay=1&muted=1&loop=1&controls=0&playbar=0"
          class="hero-video-{{ gen_id }} hero-video-mobile-{{ gen_id }}"
          allow="autoplay; fullscreen"
          allowfullscreen
          frameborder="0"
        ></iframe>
      {% elsif block.settings.mobile_video_url != blank %}
        <video
          class="hero-video-{{ gen_id }} hero-video-mobile-{{ gen_id }}"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="{{ block.settings.mobile_video_url }}" type="video/mp4">
        </video>
      {% endif %}
    {% endif %}

    {% if block.settings.fallback_image != blank %}
      <img
        src="{{ block.settings.fallback_image | image_url: width: 2000 }}"
        alt="{{ block.settings.fallback_image_alt | escape }}"
        class="hero-fallback-image-{{ gen_id }}"
        loading="eager"
        width="{{ block.settings.fallback_image.width }}"
        height="{{ block.settings.fallback_image.height }}"
      >
    {% endif %}
  </div>

  <div class="hero-overlay-{{ gen_id }}"></div>

  <div class="hero-content-wrapper-{{ gen_id }}">
    <div class="hero-content-{{ gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="hero-heading-{{ gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="hero-subheading-{{ gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.show_rating %}
        <div class="hero-rating-{{ gen_id }}">
          <div class="hero-stars-{{ gen_id }}">
            {% assign rating_value = block.settings.rating_value %}
            {% assign full_stars = rating_value | floor %}
            {% assign decimal_part = rating_value | modulo: 1 %}
            {% assign has_partial = false %}
            {% if decimal_part > 0 %}
              {% assign has_partial = true %}
            {% endif %}
            {% assign partial_star_index = full_stars | plus: 1 %}

            {% for i in (1..5) %}
              {% if i <= full_stars %}
                <span class="hero-star-{{ gen_id }} hero-star-full-{{ gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                </span>
              {% elsif i == partial_star_index and has_partial %}
                <span class="hero-star-{{ gen_id }} hero-star-partial-{{ gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  <span class="hero-star-partial-fill-{{ gen_id }}" style="width: {{ decimal_part | times: 100 }}%;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  </span>
                </span>
              {% else %}
                <span class="hero-star-{{ gen_id }} hero-star-empty-{{ gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                </span>
              {% endif %}
            {% endfor %}
          </div>
          <span class="hero-rating-text-{{ gen_id }}">{{ block.settings.rating_value }} / 5</span>
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="hero-button-{{ gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>


<script>
  (function() {
    class HeroSection{{ gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initVideos();
      }

      initVideos() {
        const videos = this.querySelectorAll('video');
        videos.forEach(video => {
          video.play().catch(error => {
            console.log('Video autoplay prevented:', error);
          });
        });
      }
    }

    customElements.define('hero-section-{{ gen_id }}', HeroSection{{ gen_id }});
  })();
</script>

