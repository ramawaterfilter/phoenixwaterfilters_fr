{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-embed-section-{{ ai_gen_id }} {
    width: 100%;
    margin-top: {{ block.settings.section_margin_top }}px;
    margin-bottom: {{ block.settings.section_margin_bottom }}px;
  }

  .ai-embed-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin-top: {{ block.settings.heading_margin_top }}px;
    margin-bottom: {{ block.settings.heading_margin_bottom }}px;
    padding-top: {{ block.settings.heading_padding_top }}px;
    padding-bottom: {{ block.settings.heading_padding_bottom }}px;
    padding-left: {{ block.settings.heading_padding_left }}px;
    padding-right: {{ block.settings.heading_padding_right }}px;
    margin-left: 0;
    margin-right: 0;
  }

  .ai-embed-video-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0;
    margin: 0;
  }

  .ai-embed-video-container-{{ ai_gen_id }} {
    width: {{ block.settings.video_width }}px;
    height: {{ block.settings.video_height }}px;
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  .ai-embed-video-container-{{ ai_gen_id }} iframe,
  .ai-embed-video-container-{{ ai_gen_id }} video,
  .ai-embed-video-container-{{ ai_gen_id }} embed,
  .ai-embed-video-container-{{ ai_gen_id }} object {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media screen and (max-width: 749px) {
    .ai-embed-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.8 }}px;
    }

    .ai-embed-video-container-{{ ai_gen_id }} {
      height: auto;
      aspect-ratio: {{ block.settings.video_width }} / {{ block.settings.video_height }};
    }
  }
{% endstyle %}

<div class="ai-embed-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-embed-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.embed_code != blank %}
    <div class="ai-embed-video-wrapper-{{ ai_gen_id }}">
      <div class="ai-embed-video-container-{{ ai_gen_id }}">
        {{ block.settings.embed_code }}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Embed with heading",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Watch our video"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding right",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 20
    },
    {
      "type": "header",
      "content": "Video embed"
    },
    {
      "type": "html",
      "id": "embed_code",
      "label": "Embed code"
    },
    {
      "type": "range",
      "id": "video_width",
      "min": 300,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "label": "Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "video_height",
      "min": 200,
      "max": 1080,
      "step": 10,
      "unit": "px",
      "label": "Height",
      "default": 450
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section margin bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Embed with heading"
    }
  ]
}
{% endschema %}
