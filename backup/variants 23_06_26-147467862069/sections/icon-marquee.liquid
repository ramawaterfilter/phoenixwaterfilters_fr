<section class="icon-marquee-section">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="swiper-container icon-marquee-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide d-flex justify-content-center align-items-center marquee-item" {{ block.shopify_attributes }}>
            <div class="image">
              {% if block.settings.icon %}
                {{ block.settings.icon | image_url: width: 160 | image_tag: alt: block.settings.label, class: 'marquee-icon', width: 80, height: 80 }}
              {% else %}
                <img src="{{ 'icon-marquee-1.png' | asset_url }}" alt="" width="80" height="80">
              {% endif %}
            </div>

            <p class="marquee-label">
              {% if block.settings.label != blank %}
                {{ block.settings.label }}
              {% else %}
                label
              {% endif %}
            </p>

            {% if block.settings.sub_label != blank %}
              <p class="marquee-sub-label">{{ block.settings.sub_label }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "icon-marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Icons"
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Icon Label"
        },
        {
          "type": "text",
          "id": "sub_label",
          "label": "Sub-label",
          "info": "Leave blank if no sub-label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Default",
      "category": "Sections"
    }
  ]
}
{% endschema %}

