{% doc %}
Loads Judge.me assets when a review widget approaches the viewport or the browser is idle.

@example
{% render 'judgeme_lazy_core' %}
{% enddoc %}

{% # theme-check-disable RemoteAsset %}
<link rel="dns-prefetch" href="https://cdn.judge.me/">
{{ shop.metafields.judgeme.settings }}
{% for count in (0..5) %}
  {% assign metafield_key = 'html_miracle_' | append: count %}
  {% assign current_metafield = shop.metafields.judgeme[metafield_key] %}
  {% unless current_metafield %}
    {% break %}
  {% endunless %}
  {{ current_metafield }}
{% endfor %}

<script data-cfasync="false" class="jdgm-script">
  (() => {
    const widgetSelector = '.jdgm-widget, .jdgm-all-reviews-page';
    let requested = false;

    const loadJudgeMe = () => {
      if (requested) return;
      requested = true;

      window.jdgm = window.jdgm || {};
      window.jdgm.CDN_HOST = 'https://cdn.judge.me/';

      const stylesheet = document.createElement('link');
      stylesheet.rel = 'stylesheet';
      stylesheet.className = 'jdgm-stylesheet';
      stylesheet.href =
        window.jdgmSettings?.widget_load_with_code_splitting
          ? parseFloat(window.jdgmSettings.widget_version) >= 3
            ? `${window.jdgm.CDN_HOST}widget_v3/base.css`
            : `${window.jdgm.CDN_HOST}widget/base.css`
          : `${window.jdgm.CDN_HOST}shopify_v2.css`;
      document.head.appendChild(stylesheet);

      const script = document.createElement('script');
      script.src = `${window.jdgm.CDN_HOST}loader.js`;
      script.async = true;
      script.dataset.cfasync = 'false';
      document.head.appendChild(script);
    };

    const observeWidgets = () => {
      const widgets = document.querySelectorAll(widgetSelector);

      if (!widgets.length || !('IntersectionObserver' in window)) return false;

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            loadJudgeMe();
          }
        },
        { rootMargin: '600px 0px' }
      );

      widgets.forEach((widget) => observer.observe(widget));
      return true;
    };

    const start = () => {
      observeWidgets();

      ['pointerdown', 'keydown', 'touchstart'].forEach((eventName) => {
        window.addEventListener(eventName, loadJudgeMe, { once: true, passive: true });
      });

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadJudgeMe, { timeout: 5000 });
      } else {
        window.setTimeout(loadJudgeMe, 5000);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>

<noscript>
  <link rel="stylesheet" href="https://cdn.judge.me/shopify_v2.css">
</noscript>
{% # theme-check-enable RemoteAsset %}
