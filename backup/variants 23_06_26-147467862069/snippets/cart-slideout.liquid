<aside class="cart-slideout">
  <div class="cart-slideout__close" data-cartslide>
    <img src="{{ 'icon-close-large.svg' | asset_url }}" alt="Close" width="24" height="24" />
  </div>

  {% if cart.item_count == 0 %}
    <div class="empty-cart">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="33"
        height="33"
        viewBox="0 0 33 33"
        fill="none">
        <path d="M27.6328 8.96875H22.6328C22.6328 7.37745 22.0007 5.85133 20.8755 4.72611C19.7502 3.60089 18.2241 2.96875 16.6328 2.96875C15.0415 2.96875 13.5154 3.60089 12.3902 4.72611C11.265 5.85133 10.6328 7.37745 10.6328 8.96875H5.63281C5.10238 8.96875 4.59367 9.17946 4.2186 9.55454C3.84353 9.92961 3.63281 10.4383 3.63281 10.9688V25.9688C3.63281 26.4992 3.84353 27.0079 4.2186 27.383C4.59367 27.758 5.10238 27.9688 5.63281 27.9688H27.6328C28.1632 27.9688 28.672 27.758 29.047 27.383C29.4221 27.0079 29.6328 26.4992 29.6328 25.9688V10.9688C29.6328 10.4383 29.4221 9.92961 29.047 9.55454C28.672 9.17946 28.1632 8.96875 27.6328 8.96875ZM16.6328 4.96875C17.6937 4.96875 18.7111 5.39018 19.4612 6.14032C20.2114 6.89047 20.6328 7.90788 20.6328 8.96875H12.6328C12.6328 7.90788 13.0542 6.89047 13.8044 6.14032C14.5545 5.39018 15.5719 4.96875 16.6328 4.96875ZM27.6328 25.9688H5.63281V10.9688H10.6328V12.9688C10.6328 13.234 10.7382 13.4883 10.9257 13.6759C11.1132 13.8634 11.3676 13.9688 11.6328 13.9688C11.898 13.9688 12.1524 13.8634 12.3399 13.6759C12.5275 13.4883 12.6328 13.234 12.6328 12.9688V10.9688H20.6328V12.9688C20.6328 13.234 20.7382 13.4883 20.9257 13.6759C21.1132 13.8634 21.3676 13.9688 21.6328 13.9688C21.898 13.9688 22.1524 13.8634 22.3399 13.6759C22.5275 13.4883 22.6328 13.234 22.6328 12.9688V10.9688H27.6328V25.9688Z" fill="#0EB6FF" />
      </svg>

      <p>Votre panier est actuellement vide.</p>

      <a href="{{ routes.all_products_collection_url }}" class="btn btn btn-secondary">continuer à faire du shopping
</a>
    </div>
  {% endif %}


  <div class="cart-slideout__inner">
    <p class="h3 cart-icon">{{ 'templates.cart.cart' | t }} (
      <span>{{ cart.item_count }}</span>
      )</p>
    {% render 'free-shipping' %}

    <div class="cart-slideout__items">
      <form
        action="{{ routes.cart_url }}"
        method="post"
        id="cartform">
        <div id="cart-slideout-contents">
          <script>
             var customCart = {{ cart | json }};
          </script>

          {% if cart.items == empty %}
            <p class="text-center">{{ 'sections.cart.empty' | t }}</p>
          {% endif %}
        </div>
        <div class="wrapper pt-3">
          {% render 'upsell-element'
            , ajax: true %}
        </div>
        <div class="icon-row">
          {% render 'cart-usps' %}
        </div>

        <div class="sub-total">
          <div class="sub-total__text mb-4">
            <table>
              {% if cart.total_discount > 0 %}
                <tr>
                  <th>
                    {{ 'sections.cart.discount' | t }}:
                  </th>
                  <td class="discount" id="cart-slideout-discount">
                    - {{ cart.total_discount | money }}
                  </td>
                </tr>
              {% endif %}

              <tr>
                <th>{{ 'sections.cart.subtotal' | t }}:</th>
                <td>
                  <strong id="cart-slideout-subtotal">{{ cart.total_price | money }}</strong>

                  <s data-original id="cart-slideout-original">
                    {% if cart.total_price < cart.original_total_price %}
                      {{ cart.original_total_price | money }}
                    {% endif %}
                  </s>
                </td>
              </tr>
            </table>
          </div>


          <div class="sub-total__btns mb-5">

            <button
              class="btn btn-secondary checkout"
              type="submit"
              name="checkout">
              {{ 'sections.cart.checkout' | t }}
            </button>
          </div>

          <div class="payment-details">
            <span class="payment-details__content">
              Comprend la livraison rapide et GRATUITE dans le monde entier !</span>

            <ul class="payment-methods">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </form>
    </div>
  </div>


  <template id="cart-template">
    <div
      class="cart-item"
      data-id="#ID#"
      data-handle="#HANDLE#">

      <div class="cart-product">
        <a href="{{ product.url }}" class="cart-slideout__image">
          <img src="#IMG#" alt="#TITLE#" width="96" height="96">
        </a>
        <div class="cart-product-details">
          <a href="#" class="js-qty-update ajax-cart remove-item">
            <img src="{{ 'icon-close-small.svg' | asset_url }}" alt="Remove" width="14" height="14" />
          </a>
          <a href="{{ item.url }}" class="cart-slideout__title">
            <h5>{{ product.title }}</h5>

            #OPTIONS#                                                                                      

				#SUBSCRIPTION#


          </a>
<!-- Start of Judge.me code --> 
  <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'> 
 {{ product.metafields.judgeme.badge }} 
 </div> 
<!-- End of Judge.me code -->
          <div class="cart-slideout__qty">
            <div class="d-flex qty-container justify-content-start">
              <span class="qty-btn decrease js-qty-update ajax-cart">-</span>
              {% assign min_buy = settings.min_buy_qty %}
              {% assign max_buy = settings.max_buy_qty %}
              <input
                type="number"
                placeholder="Quantity"
                name="updates[#ID#]"
                id="updates_#INDEX#"
                value="#QTY#"
                min="{{ min_buy }}"
                max="{{ max_buy }}">

              <span class="qty-btn increase js-qty-update ajax-cart">+</span>
            </div>
            <div class="cart-slideout__subtotal">
              <span class="sub-total">

                <strong data-subtotal>#FINALPRICE#</strong>
                #ORIGINAL#
              </span>
            </div>
          </div>
          <p class="js-availability-notice cart-availability #DISABLED# #INVALID#">There are only
            <strong class="js-availablilty">#STOCK#</strong>
            of these available in stock.
          </p>
        </div>
      </div>
    </div>
  </template>
<script>
(function() {
  'use strict';

  if (window.__phoenixCartRemoveNoReopen) return;
  window.__phoenixCartRemoveNoReopen = true;

  function cartRoute(path) {
    var root = window.Shopify && Shopify.routes && Shopify.routes.root ? Shopify.routes.root : '/';
    return root.replace(/\/$/, '/') + path.replace(/^\//, '');
  }

  function formatMoney(cents) {
    if (window.Shopify && typeof Shopify.formatMoney === 'function') return Shopify.formatMoney(cents);
    return '� ' + (Number(cents || 0) / 100).toFixed(2);
  }

  function updateCartCount(cart) {
    document.querySelectorAll('.cart-icon span, [data-cartcount]').forEach(function(el) {
      el.textContent = cart && typeof cart.item_count !== 'undefined' ? cart.item_count : 0;
    });
  }

  function updateDrawerAfterRemove(cart) {
    updateCartCount(cart);

    var contents = document.getElementById('cart-slideout-contents');
    var subtotal = document.getElementById('cart-slideout-subtotal');
    var original = document.getElementById('cart-slideout-original');
    var discount = document.getElementById('cart-slideout-discount');
    var emptyCart = document.querySelector('.cart-slideout .empty-cart');

    if (subtotal) subtotal.textContent = formatMoney(cart.total_price || 0);
    if (original) original.textContent = cart.total_price < cart.original_total_price ? formatMoney(cart.original_total_price) : '';
    if (discount) discount.textContent = cart.total_discount > 0 ? '-' + formatMoney(cart.total_discount) : '';

    if (!cart.item_count) {
      if (contents) contents.innerHTML = '<p class="text-center">' + {{ 'sections.cart.empty' | t | json }} + '</p>';
      if (emptyCart) emptyCart.style.display = '';
    } else if (emptyCart) {
      emptyCart.style.display = 'none';
    }
  }

  document.addEventListener('click', function(event) {
    var removeButton = event.target && event.target.closest ? event.target.closest('.cart-slideout .remove-item') : null;
    if (!removeButton) return;

    var item = removeButton.closest('.cart-item');
    var id = item && item.getAttribute('data-id');
    if (!id) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    if (item) item.remove();

    fetch(cartRoute('cart/change.js'), {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ id: id, quantity: 0 })
    })
      .then(function(response) {
        if (!response.ok) throw new Error('Unable to remove cart item');
        return response.json();
      })
      .then(updateDrawerAfterRemove)
      .catch(function(error) {
        console.error('Cart remove failed:', error);
        if (typeof window._getCart === 'function') {
          window._getCart().then(updateDrawerAfterRemove).catch(function() {});
        }
      });
  }, true);
})();
</script>
</aside>

<style>
  /* Hide original dollar sign and show euro */
  .cart-slideout .money::first-letter {
    visibility: hidden;
    position: relative;
  }
  .cart-slideout .money::before {
    content: '€';
    visibility: visible;
    position: absolute;
    left: 0;
  }
</style>

<script>
(function() {
  'use strict';
  
  // Main function to replace $ with €
  function convertToEuro() {
    var cart = document.querySelector('.cart-slideout');
    if (!cart) return;
    
    // Replace in all text content
    var walker = document.createTreeWalker(
      cart,
      NodeFilter.SHOW_TEXT,
      null,
      false
    );
    
    var node;
    while (node = walker.nextNode()) {
      if (node.nodeValue && node.nodeValue.includes('$')) {
        node.nodeValue = node.nodeValue.replace(/\$/g, '€');
      }
    }
  }
  
  // Run multiple times to catch dynamic content
  function runConverter() {
    convertToEuro();
    setTimeout(convertToEuro, 50);
    setTimeout(convertToEuro, 150);
    setTimeout(convertToEuro, 300);
    setTimeout(convertToEuro, 600);
    setTimeout(convertToEuro, 1000);
  }
  
  // Initial run
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runConverter);
  } else {
    runConverter();
  }
  
  // Watch for cart changes with MutationObserver
  var observerConfig = {
    childList: true,
    subtree: true,
    characterData: true,
    characterDataOldValue: false
  };
  
  var observer = new MutationObserver(function(mutations) {
    convertToEuro();
  });
  
  // Start observing
  setTimeout(function() {
    var cartElement = document.querySelector('.cart-slideout');
    if (cartElement) {
      observer.observe(cartElement, observerConfig);
    }
  }, 100);
  
  // Listen for cart-related events
  var events = ['cart:updated', 'cart:refresh', 'shopify:section:load', 'cart.requestComplete'];
  events.forEach(function(eventName) {
    document.addEventListener(eventName, runConverter);
  });
  
  // For jQuery-based themes
  if (typeof jQuery !== 'undefined') {
    jQuery(document).on('cart.requestComplete', runConverter);
    jQuery(document).ajaxComplete(function(event, xhr, settings) {
      if (settings.url && settings.url.includes('/cart')) {
        runConverter();
      }
    });
  }
  
  // Fallback: Check every second for the first 10 seconds
  var counter = 0;
  var interval = setInterval(function() {
    convertToEuro();
    counter++;
    if (counter >= 10) {
      clearInterval(interval);
    }
  }, 1000);
  
})();
</script>