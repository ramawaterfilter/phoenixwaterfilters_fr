<script>
document.addEventListener('DOMContentLoaded', function() {
	
	// Mobile menu toggle
	let hamburger = document.querySelector('.hamburger');
	let overlay = document.querySelector('.mega-menu-overlay');

	if(hamburger){
		hamburger.addEventListener('click', function(){
			document.documentElement.classList.toggle('menu-open');
		});

		// Close menu when clicking overlay
		if(overlay) {
			overlay.addEventListener('click', function(){
				document.documentElement.classList.remove('menu-open');
				// Also close any open mega menus
				document.querySelectorAll('.mega-active').forEach(el => {
					el.classList.remove('mega-active');
				});
			});
		}

		// Close menu when clicking the close button (×)
		let navMenu = document.querySelector('.site-header__nav');
		if(navMenu) {
			navMenu.addEventListener('click', function(e){
				let rect = this.getBoundingClientRect();
				if(e.clientX > rect.right - 50 && e.clientY < rect.top + 50) {
					document.documentElement.classList.remove('menu-open');
				}
			});
		}

		// Prevent body scroll when menu is open
		const observer = new MutationObserver(function(mutations) {
			mutations.forEach(function(mutation) {
				if (mutation.attributeName === 'class') {
					if(document.documentElement.classList.contains('menu-open')) {
						document.body.style.overflow = 'hidden';
					} else {
						document.body.style.overflow = '';
					}
				}
			});
		});

		observer.observe(document.documentElement, {
			attributes: true
		});
	}

	// Mega Menu functionality - Desktop
	let megaMenuTriggers = document.querySelectorAll('.mega-menu-trigger');
	
	megaMenuTriggers.forEach(function(trigger) {
		trigger.addEventListener('click', function(e) {
			e.preventDefault();
			e.stopPropagation();
			
			let parentLi = this.closest('li[data-mega-menu]');
			let isActive = parentLi.classList.contains('mega-active');
			
			// Close all other mega menus
			document.querySelectorAll('li[data-mega-menu]').forEach(function(li) {
				li.classList.remove('mega-active');
			});
			
			// Toggle current mega menu
			if(!isActive) {
				parentLi.classList.add('mega-active');
				overlay.classList.add('active');
			} else {
				overlay.classList.remove('active');
			}
		});
	});

	// Close mega menu buttons
	let closeMegaButtons = document.querySelectorAll('.megamenu_close');
	
	closeMegaButtons.forEach(function(closeBtn) {
		closeBtn.addEventListener('click', function(e) {
			e.preventDefault();
			e.stopPropagation();
			
			document.querySelectorAll('.mega-active').forEach(function(el) {
				el.classList.remove('mega-active');
			});
			overlay.classList.remove('active');
		});
	});

	// Mobile sub-menu triggers
	let subNavTriggers = document.querySelectorAll('.sub-menu-trigger');
	subNavTriggers.forEach(function(trigger) {
		trigger.addEventListener('click', function(e){
			e.preventDefault();
			e.stopPropagation();
			trigger.closest('li').classList.toggle('active');
		});
	});

	// Mega menu hover effects (for desktop link highlighting)
	let mmLinks = document.querySelectorAll('.megamenu__links li a');
	mmLinks.forEach(function(link){
		link.addEventListener('mouseover', function(){
			let thisIndex = link.dataset.index;
			if(!thisIndex) return;
			
			let megamenu = link.closest('.megamenu');
			let relatedLists = megamenu.querySelectorAll('li[data-index="'+thisIndex+'"]');
			let activeLists = megamenu.querySelectorAll('li.active');

			activeLists.forEach(function(el) {
				el.classList.remove('active');
			});

			relatedLists.forEach(function(el) {
				el.classList.add('active');
			});
		});
	});

	// Close mega menu when clicking outside
	document.addEventListener('click', function(e) {
		if(!e.target.closest('.site-header__nav') && 
		   !e.target.closest('.mega-menu-trigger') &&
		   !e.target.closest('.megamenu')) {
			document.querySelectorAll('.mega-active').forEach(function(el) {
				el.classList.remove('mega-active');
			});
			overlay.classList.remove('active');
		}
	});

	// Prevent clicks inside megamenu from closing it
	document.querySelectorAll('.megamenu').forEach(function(megamenu) {
		megamenu.addEventListener('click', function(e) {
			e.stopPropagation();
		});
	});
});
</script>

