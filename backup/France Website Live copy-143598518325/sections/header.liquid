<style>
/* Mobile Hamburger Styles */
.hamburger {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	width: 30px;
	height: 24px;
	cursor: pointer;
	z-index: 1000;
	padding: 5px;
}

.hamburger span {
	display: block;
	width: 100%;
	height: 3px;
	background-color: #333;
	transition: all 0.3s ease;
	border-radius: 2px;
}

/* Hamburger animation when menu is open */
.menu-open .hamburger span:nth-child(1) {
	transform: rotate(45deg) translate(8px, 8px);
}

.menu-open .hamburger span:nth-child(2) {
	opacity: 0;
}

.menu-open .hamburger span:nth-child(3) {
	transform: rotate(-45deg) translate(7px, -7px);
}

/* Mega Menu Overlay */
.mega-menu-overlay {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: rgba(0, 0, 0, 0.5);
	z-index: 998;
	opacity: 0;
	visibility: hidden;
	transition: opacity 0.3s ease, visibility 0.3s ease;
}

.mega-menu-overlay.active {
	opacity: 1;
	visibility: visible;
}

/* Mega Menu Styles - Desktop */
@media (min-width: 992px) {
	.site-header__nav li[data-mega-menu] {
		position: relative;
	}

	.site-header__nav li[data-mega-menu] .megamenu {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100vh;
		background: #fff;
		z-index: 999;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.3s ease, visibility 0.3s ease;
		overflow-y: auto;
		padding: 80px 40px 40px;
	}

	.site-header__nav li[data-mega-menu].mega-active .megamenu {
		opacity: 1;
		visibility: visible;
	}

	.megamenu .megamenu_close {
		position: absolute;
		top: 20px;
		right: 30px;
		width: 40px;
		height: 40px;
		cursor: pointer;
		z-index: 1000;
	}

	.megamenu .megamenu_close::before,
	.megamenu .megamenu_close::after {
		content: '';
		position: absolute;
		width: 30px;
		height: 3px;
		background: #333;
		top: 50%;
		left: 50%;
		transform-origin: center;
	}

	.megamenu .megamenu_close::before {
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.megamenu .megamenu_close::after {
		transform: translate(-50%, -50%) rotate(-45deg);
	}
}

/* Mobile Navigation Styles */
@media (max-width: 991px) {
	.site-header__nav {
		position: fixed;
		top: 0;
		left: -100%;
		width: 80%;
		max-width: 320px;
		height: 100vh;
		background: #fff;
		z-index: 999;
		overflow-y: auto;
		transition: left 0.3s ease;
		padding: 60px 20px 20px 20px;
		box-shadow: 2px 0 10px rgba(0,0,0,0.1);
		display: block !important;
	}

	.menu-open .site-header__nav {
		left: 0;
	}

	/* Close button for mobile menu */
	.site-header__nav::before {
		display:none;
		content: '×';
		position: absolute;
		top: 10px;
		right: 15px;
		font-size: 40px;
		line-height: 1;
		cursor: pointer;
		color: #333;
		z-index: 1000;
	}

	.site-header__nav > ul {
		display: flex !important;
		flex-direction: column;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.site-header__nav > ul > li {
		border-bottom: 1px solid #eee;
		padding: 0;
		display: block !important;
	}

	.site-header__nav > ul > li > a {
		display: block !important;
		padding: 15px 10px;
		text-decoration: none;
		color: #333;
		font-size: 16px;
	}

	.site-header__nav .sub-menu {
		display: none;
		padding-left: 20px;
		list-style: none;
		background: #f9f9f9;
	}

	.site-header__nav .sub-menu li {
		display: block !important;
	}

	.site-header__nav .sub-menu li a {
		display: block !important;
		padding: 10px;
		color: #666;
		text-decoration: none;
	}

	.site-header__nav li.active > .sub-menu {
		display: block !important;
	}

	.sub-menu-trigger {
		float: right;
		width: 20px;
		height: 20px;
		position: relative;
		cursor: pointer;
		margin-top: 5px;
	}

	.sub-menu-trigger::before,
	.sub-menu-trigger::after {
		content: '';
		position: absolute;
		background: #333;
		transition: transform 0.3s ease;
	}

	.sub-menu-trigger::before {
		width: 12px;
		height: 2px;
		top: 9px;
		left: 4px;
	}

	.sub-menu-trigger::after {
		width: 2px;
		height: 12px;
		top: 4px;
		left: 9px;
	}

	li.active .sub-menu-trigger::after {
		transform: rotate(90deg);
		opacity: 0;
	}

	/* Hide mega menu on mobile */
	.site-header__nav .megamenu {
		display: none !important;
	}

	/* Menu overlay for mobile */
	.menu-open .mega-menu-overlay {
		opacity: 1;
		visibility: visible;
	}
}

/* Desktop - hide hamburger */
@media (min-width: 992px) {
	.hamburger {
		display: none;
	}
}


