					<ul>
					    {% for link in section.settings.sitemenu.links %}

					    	{% assign original_link = link.url | split: '#' %}
					    	{% assign mega_menu_name = original_link[1] %}
					    	{% assign original_link = original_link[0] %}

			        		{% if allmenus contains mega_menu_name %}
						        <li class="{% if original_link == request.path %}active{% endif %}" data-mega-menu="#{{ mega_menu_name }}">

					           	 	{% assign links = linklists[mega_menu_name].links %}

					           	 	<a href="javascript:void(0)" class="mega-menu-trigger" aria-label="Open mega menu">{{ link.title }}
							            {% if links.size > 0 %}
						           	 		<span class="sub-menu-trigger"></span>
						        		{% endif %}
					           	 	</a>

									{% render 'megamenu', megamenu: mega_menu_name, index: forloop.index %}

				        	{% else %}
						        <li class="{% if original_link == request.path %}active{% endif %}">
					           		<a href="{{ original_link }}" target="{{ link.target }}">
						           		{{ link.title }}

							            {% if link.links.size > 0 %}
						           	 		<span class="sub-menu-trigger"></span>
						        		{% endif %}
						           	</a>
					           	 	{% assign links = link.links %}
				        	{% endif %}

					            {% unless allmenus contains mega_menu_name %}
					            	{% if links.size > 0 %}
					                <ul class="sub-menu">
					                    {% for sublink in links %}
					                    <li class="{% if sublink.url == request.path %}active{% endif %}">
					                        <a href="{{ sublink.url }}" target="{{ sublink.target }}">
					                       		{{ sublink.title }}
					                   		</a>
					                    </li>
					                    {% endfor %}
					                </ul>
					                {% endif %}
					            {% endunless %}
					        </li>
					    {% endfor %}
				</ul>
			</div>



			
			

	            <div class="site-header__aux">
 {% comment %} <div id="lang-switcher" class="lang-switcher">
  <button class="lang-btn">
    <img id="active-flag" class="flag" src="{{ 'flag-fr.png' | asset_url }}" alt="">
    <span id="active-lang">FRA</span>
    <span class="arrow"></span>
  </button>

  <div class="lang-menu">
    <a data-code="fr" data-path="/" class="lang-option">
      <img src="{{ 'flag-fr.png' | asset_url }}" class="flag"> FRA
    </a>
    <a data-code="es" data-path="/es/" class="lang-option">
      <img src="{{ 'flag-es.png' | asset_url }}" class="flag"> ESP
    </a>
    <a data-code="it" data-path="/it/" class="lang-option">
      <img src="{{ 'flag-it.png' | asset_url }}" class="flag"> ITA
    </a>
  </div>
</div>  {% endcomment %}



<script>
document.addEventListener("DOMContentLoaded", () => {

  const menu = document.querySelector(".lang-menu");
  const btn  = document.querySelector(".lang-btn");
  const activeFlag = document.getElementById("active-flag");
  const activeLang = document.getElementById("active-lang");

  // Detect saved language
  let savedCode  = localStorage.getItem("lang-code");
  let savedPath  = localStorage.getItem("lang-path");

  // Detect current page path
  let path = window.location.pathname;

  // Apply saved language on every page load
  if (savedCode && savedPath !== null) {

    // Update UI
    updateUI(savedCode);

    let currentPrefix = path.split("/")[1];

    // Redirect if prefix doesn't match chosen language
    if (savedCode === "fr" && (currentPrefix === "es" || currentPrefix === "it")) {
      window.location.href = path.replace(/^\/(es|it)\//, "/");
    }

    if ((savedCode === "es" || savedCode === "it") && currentPrefix !== savedCode) {
      let clean = path.replace(/^\/(es|it)\//, "/");
      window.location.href = savedPath + clean.substring(1);
    }
  }

  // Open dropdown
  btn.addEventListener("click", (e) => {
    e.stopPropagation();
    menu.classList.toggle("show");
  });

  // Close dropdown
  document.addEventListener("click", () => menu.classList.remove("show"));

  // Click language option
  document.querySelectorAll(".lang-option").forEach(option => {
    option.addEventListener("click", (e) => {
      e.preventDefault();

      let code = option.dataset.code;
      let pathPrefix = option.dataset.path;

      // Save choice
      localStorage.setItem("lang-code", code);
      localStorage.setItem("lang-path", pathPrefix);

      updateUI(code);

      // Clean path from old prefix
      let clean = window.location.pathname.replace(/^\/(es|it)\//, "/");

      // Redirect
      if (code === "fr") {
        window.location.href = clean;
      } else {
        window.location.href = pathPrefix + clean.substring(1);
      }
    });
  });

  // UI update function
  function updateUI(code) {
    if (code === "fr") {
      activeFlag.src = "https://cdn.shopify.com/s/files/1/0656/9898/8085/files/france.png?v=1765187755";
      activeLang.textContent = "FRA";
    }
    if (code === "es") {
  activeFlag.src = "https://cdn.shopify.com/s/files/1/0656/9898/8085/files/spain.png?v=1765188000";
      activeLang.textContent = "ESP";
    }
    if (code === "it") {
      activeFlag.src = "https://cdn.shopify.com/s/files/1/0656/9898/8085/files/italy.png?v=1765188000";
      activeLang.textContent = "ITA";
    }
  }

});
</script>
