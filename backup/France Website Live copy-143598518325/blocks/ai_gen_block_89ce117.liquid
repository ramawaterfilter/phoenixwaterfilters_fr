{% doc %}
  @prompt
    The section should display a centered heading text.
    
    Default heading text: "Enregistrement du produit"
    
    Default background color: #94bcd3
    
    Default text color: #ffffff
    
    Default font size: 22px on desktop and 18px on mobile.
    
    Default banner height: 105px.
    
    The heading should be perfectly centered both vertically and horizontally.
    
    The section must be 100% width of the page.
    
    Add settings in the theme editor so I can manually change:
    
    Heading text
    
    Background color
    
    Text color
    
    Font size
    
    Banner height
    
    The section should be responsive on all devices (desktop, tablet, mobile).
    
    Keep the design minimal and clean with no extra padding or borders.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-centered-banner-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    background-color: {{ block.settings.background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  .ai-centered-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    margin: 0;
    padding: 0;
    text-align: center;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-centered-banner__heading-{{ ai_gen_id }} {
      font-size: 18px;
    }
  }
{% endstyle %}

<div class="ai-centered-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h1 class="ai-centered-banner__heading-{{ ai_gen_id }}">
    {{ block.settings.heading_text }}
  </h1>
</div>

{% schema %}
{
  "name": "Centered banner",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Enregistrement du produit"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#94bcd3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 22
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Banner height",
      "default": 105
    }
  ],
  "presets": [
    {
      "name": "Centered banner"
    }
  ]
}
{% endschema %}
