{% doc %}
  @prompt
    Design requirements:
    - Full width, height around 45px on desktop, 50px on mobile.
    - Background color customizable via color picker (default: #d43d2f).
    - Text color customizable via color picker (default: #ffffff).
    - Add padding (6px top and bottom) and ensure text is vertically centered.
    - Use a clean sans-serif font.
    - Messages slide automatically every few seconds and can also be changed manually using left/right arrows.
    - Arrows appear on both sides of the text, centered vertically, and move with the slide.
    - Arrows should be customizable in color and have a hover opacity effect.
    - The entire message text can include a clickable link (e.g., clicking opens a product or policy page).
    - Fully responsive on all devices: 
      - On mobile, the text stays perfectly centered.
      - Arrows adjust position and size responsively.
    
    Customizer settings:
    - Background color picker.
    - Text color picker.
    - Arrow color picker.
    - Autoplay toggle.
    - Autoplay speed (milliseconds).
    - Number of slides (dynamic blocks).
    - Each block should have:
      - “Ad text” (rich text or HTML field supporting <strong> and links),
      - “Link URL” (optional).
    
    Example default content:
    **Free UK Delivery** on Orders over £25 → link to “/shipping-policy”.
    
    Animations:
    - Smooth fade or slide transition (choose one visually clean option).
    - Transition duration ~0.4s., - Allow merchants to control font size and padding via theme settings., i need the custom css bar i need and the button will not in correct place align in center, i need to give more that 5 content in it the slide button not in center , if i give the link in that content i need the underline for the text and the give me the custom css bar, i need the underline if the text given by likn in not not in hover, i need the height will be adjestable also i need the i give the link in the text but the underline style not appean only appear in hover
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
    overflow: hidden;
    min-height: {{ block.settings.bar_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-bar__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .ai-announcement-bar__slider-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 60px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__slider-{{ ai_gen_id }} {
      margin: 0 50px;
    }
  }

  .ai-announcement-bar__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    padding: 0 20px;
  }

  .ai-announcement-bar__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-announcement-bar__slide-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .ai-announcement-bar__slide-link-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-announcement-bar__text-{{ ai_gen_id }} {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  .ai-announcement-bar__text-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-announcement-bar__text-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }

  .ai-announcement-bar__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ block.settings.arrow_color }};
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: opacity 0.3s ease;
    opacity: 0.8;
    flex-shrink: 0;
  }

  .ai-announcement-bar__arrow-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-bar__arrow--left-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-announcement-bar__arrow--right-{{ ai_gen_id }} {
    right: 10px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__arrow-{{ ai_gen_id }} {
      padding: 6px;
    }

    .ai-announcement-bar__arrow--left-{{ ai_gen_id }} {
      left: 5px;
    }

    .ai-announcement-bar__arrow--right-{{ ai_gen_id }} {
      right: 5px;
    }
  }

  .ai-announcement-bar__arrow-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__arrow-icon-{{ ai_gen_id }} {
      width: 16px;
      height: 16px;
    }
  }

  {{ block.settings.custom_css }}
{% endstyle %}

