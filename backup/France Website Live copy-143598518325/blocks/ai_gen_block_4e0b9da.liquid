<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-announcement-bar__slide-{{ ai_gen_id }}');
        this.arrows = this.querySelectorAll('.ai-announcement-bar__arrow-{{ ai_gen_id }}');
        
        if (this.slides.length <= 1) return;

        this.setupEventListeners();
        
        {% if block.settings.enable_autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        this.arrows.forEach(arrow => {
          arrow.addEventListener('click', (e) => {
            const direction = e.currentTarget.dataset.direction;
            if (direction === 'next') {
              this.nextSlide();
            } else {
              this.prevSlide();
            }
            this.resetAutoplay();
          });
        });
      }

      showSlide(index) {
        this.slides.forEach((slide, i) => {
          if (i === index) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });
        this.currentSlide = index;
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.showSlide(nextIndex);
      }

      prevSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.showSlide(prevIndex);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, {{ block.settings.autoplay_speed }});
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        {% if block.settings.enable_autoplay %}
          this.stopAutoplay();
          this.startAutoplay();
        {% endif %}
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

