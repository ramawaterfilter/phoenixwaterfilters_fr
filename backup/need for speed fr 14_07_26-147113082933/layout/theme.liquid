    h1,h2,h3,h4,h5,h6,p,a,button,input,textarea,label,span{font-family:"Value Sans",system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif !important}
    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  </style>
  <link rel="preload" href="{{ 'main.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="{{ 'main.css' | asset_url }}"></noscript>

  <script>

    window.enable_slide_cart = {{ settings.enable_slide_cart }};
    window.enable_ajax_cart = {{ settings.enable_ajax_cart }};
    window.show_exit_intent = {{ settings.show_exit_popup }};
    window.show_entry_popup = {{ settings.show_entry_popup }};
    window.enable_minmax_buys = {{ settings.enable_minmax_buys }};
    window.min_buy_qty = {{ settings.min_buy_qty }};
    window.max_buy_qty = {{ settings.max_buy_qty }};
    window.money_format = "{{ shop.money_format }}";
    window.variant_colours = "{{ settings.variant_colours }}".split(',');
    window.inventory_text = {
      add_to_cart: '{{ 'products.product.add_to_cart' | t }}',
      sold_out: '{{ 'products.product.sold_out' | t }}',
      pre_order: '{{ 'products.product.pre_order' | t }}',
      in_stock_long: '{{ 'products.product.inventory_in_stock' | t }}',
      low_stock_long: '{{ 'products.product.inventory_low_stock' | t }}',
      sold_out_long: '{{ 'products.product.inventory_out_of_stock' | t }}'
      };
    window.variantStock = [];
  </script>
  <style>
    @media (min-width: 1025px) {
      #zoom-controls {
        display: flex !important;
      }
    }

    @media (max-width: 1024px) {
      #zoom-controls {
        display: none !important;
      }
    }
  </style>

  <link rel="preload" as="font" type="font/woff2" href="{{ 'ValueSansPro-Regular.woff2' | asset_url }}" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="{{ 'ValueSansPro-Medium.woff2' | asset_url }}" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="{{ 'ValueSansPro-Bold.woff2' | asset_url }}" crossorigin>
  <link rel="preload" href="{{ 'custom-fonts.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="{{ 'custom-fonts.css' | asset_url }}"></noscript>

{% comment %} /////////////////////////////////////////////////////////////////////////href-lang start/////////////////////////////////////////////////////////////////// {% endcomment %}

{% if template == 'index' %}
 <link rel="alternate" hreflang="en-us" href="https://phoenixwaterfilters.com/" />
<link rel="alternate" hreflang="en-gb" href="https://phoenixwaterfilters.co.uk/" />
<link rel="alternate" hreflang="fr-fr" href="https://phoenixwaterfilters.fr/" />
<link rel="alternate" hreflang="x-default" href="https://phoenixwaterfilters.com/" />
{% endif %}

{% if product.metafields.custom.href_lang != blank %}
  {{ product.metafields.custom.href_lang }}
{% endif %}

{% if page.metafields.custom.href_lang != blank %}
  {{ page.metafields.custom.href_lang }}
{% endif %}

{% if collection.metafields.custom.href_lang != blank %}
  {{ collection.metafields.custom.href_lang }}
{% endif %}

{% if blog.metafields.custom.href_lang != blank %}
  {{ blog.metafields.custom.href_lang }}
{% endif %}

{% comment %} /////////////////////////////////////////////////////////////////////////href-lang end/////////////////////////////////////////////////////////////////// {% endcomment %}

  {% if template.name == 'product' %}
    {%- comment -%}
      LCP preload MUST match the first slide the gallery actually paints
      (sections/custom-nice-product.liquid). That gallery shows the selected
      variant's custom.variant_images metafield when present, otherwise the
      product media / featured image. Preloading featured_media while the
      gallery paints a variant_images file downloads the wrong image and
      pushes LCP out several seconds. Keep this logic in sync with the section.
    {%- endcomment -%}
    {%- assign lcp_variant = product.selected_or_first_available_variant -%}
    {%- assign lcp_variant_files = lcp_variant.metafields.custom.variant_images.value -%}
    {%- if lcp_variant_files != blank -%}
      {%- assign lcp_image = lcp_variant_files.first -%}
    {%- else -%}
      {%- assign lcp_image = lcp_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.featured_image -%}
    {%- endif -%}
    {% if lcp_image %}
      <link rel="preload" as="image"
            href="{{ lcp_image | image_url: width: 764 }}"
            imagesrcset="{{ lcp_image | image_url: width: 382 }} 382w, {{ lcp_image | image_url: width: 600 }} 600w, {{ lcp_image | image_url: width: 764 }} 764w, {{ lcp_image | image_url: width: 832 }} 832w, {{ lcp_image | image_url: width: 1200 }} 1200w"
            imagesizes="(max-width: 749px) calc(100vw - 30px), 600px"
            fetchpriority="high">
    {% endif %}
  {% endif %}

</head>

<body class="template-{{ template.name }}-{{ template.suffix }}">


  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PWMJT6PK" height="0" width="0"
      style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  {% unless template.suffix == 'article' %}
  <header class="site-header">
    {% sections 'header-group' %}
  </header>
  {% endunless %}

  <main role="main">
    {{ content_for_layout }}
  </main>

  {% unless template.suffix == 'article' %}
  {% sections 'footer-group' %}
  {% if template == 'index' and settings.show_entry_popup %}
  {% render 'entry-popup' %}
  {% endif %}
  {% else %}
  {% sections 'article-footer-group' %}
  {% endunless %}

  {% unless template.suffix == 'article' %}
  {% if settings.show_exit_popup %}
  {% render 'exit-popup' %}
  {% endif %}

  {% if settings.enable_slide_cart %}
  {% render 'cart-slideout' %}
  {% endif %}

  {% render 'toast' %}

  {% endunless %}


  <script defer src="{{ 'main.js' | asset_url }}"></script>

  {% render 'wistia_lazy_core' %}

  {% if template.name == 'product' %}
    {% render 'klaviyo-back-in-stock' %}
  {% endif %}

  <script defer src="{{ 'custom-customer-referral.js' | asset_url }}"></script>
  <script defer src="{{ 'render.js' | asset_url }}"></script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      function toggleSticky() {
        const sticky = document.querySelector(".sticky-add-to-cart");
        if (!sticky) return;

        if (document.body.classList.contains("cart-open")) {
          sticky.style.display = "none";
        } else {
          sticky.style.display = "block";
        }
      }

      // Run once
      toggleSticky();

      // Detect class change efficiently
      const observer = new MutationObserver(toggleSticky);
      observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });
    });
  </script>

  {% render 'judgeme_lazy_core' %}
</body>

</html>
