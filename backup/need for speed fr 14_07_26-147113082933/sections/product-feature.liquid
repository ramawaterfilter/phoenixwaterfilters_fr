{% assign product_feature_title = product.metafields.custom.product_feature_title %}
{% assign product_feature_contents = product.metafields.custom.featured_contents | metafield_tag %}

<variant-visibility-scope current-variant-id="{{ product.selected_or_first_available_variant.id }}">
  <div
    class="{{ section.settings.custom_class }} layout-copy-image"
    id="{{ section.settings.custom_id }}"
    data-variant-visibility-item
    {% if section.settings.variant_ids != blank %}
      data-variant-visibility-ids="{{ section.settings.variant_ids | escape }}"
      hidden
    {% endif %}
  >

  {% assign col_one_class = 'col-11 col-lg-4 order-1 order-lg-2  mo-pad' %}
  {% assign col_two_class = 'col-11 col-lg-8 order-2 order-lg-1 copy-col mo-pad' %}
  {% assign row_settings = 'row align-items-center justify-content-center justify-content-md-start' %}
  {% assign li_width = 'd-flex align-items-start py-2 me-lg-3 max-li-width' %}
  {% assign img_classes = 'img-fluid d-block mx-auto mb-5 mb-lg-0 rounded view-animation fade-up img-lrg ' %}


  <div class="background-image-container {{ section.settings.style }}"></div>


  <div class="container">
    <div class="row {{ section.settings.vertical_align }} {{ row_settings }}">

      <div class="{{ col_one_class }}">


        {% if section.settings.column_img != blank %}
          <img
            src="{{ section.settings.column_img | image_url: width: 1920 }}"
            class="{{ img_classes }}" alt="Phoenix Gravity Water Filter"
            width="{{ section.settings.column_img.width }}"
            height="{{ section.settings.column_img.height }}"
            loading="lazy" />

        {% endif %}


      </div>

      <div class="{{ col_two_class }}">

        {% if product_feature_title != blank %}

          <h2 class="{{ h2_setting }}">
            {{ product_feature_title }}</h2>

        {% elsif section.settings.heading != blank %}

          <h2 class="{{ h2_setting }}">
            {{ section.settings.heading }}</h2>
        {% endif %}

        {% if product_feature_contents != blank %}
          <div class="feat-content">
            {{ product_feature_contents }}
          </div>

        {% elsif section.settings.content != blank %}

          {{ section.settings.content | replace: '[month]', '<span class="dyn-month"></span>' }}
        {% endif %}


        {% if product_feature_contents != blank %}
        {% elsif section.blocks != blank %}

          <ul class="features d-flex flex-wrap px-0 pt-5">
            {% for block in section.blocks %}
              <li class="{{ li_width  }}">
                {% if block.settings.feature_icon != blank %}
                  {{ block.settings.feature_icon | image_url: width: 200 | image_tag: class: "img-fluid feature-icon  me-3", loading: "lazy" }}
                {% else %}

                  <img
                    src="{{ 'icon-features-tick.svg' | asset_url }}"
                    class="img-fluid feature-icon  me-3" alt="Phoenix Gravity Water Filter"
                    width="64" height="64"
                    loading="lazy" />

                {% endif %}

                <p>{{ block.settings.feature_text }}</p>
              </li>
            {% endfor %}
          </ul>
        {% endif %}


        {% if section.settings.buttonlink != blank %}
          <div class="row">
            <div class="col-12">
              {% render 'button' %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
  </div>
  </variant-visibility-scope>
  <script src="{{ 'variant-visibility.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "Product Feature",
    "tag": "section",
    "class": "section-copy-image product-feature",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Background",
        "default": "bg-white",
        "options": [
          {
            "label": "White",
            "value": "bg-white"
          }, {
            "label": "Light",
            "value": "bg-light"
          }
        ]
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      }, {
        "type": "image_picker",
        "id": "column_img",
        "label": "Image"
      }, {

        "type": "number",
        "id": "img_width",
        "label": "Image Width (px)"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "header",
        "content": "Variant Visibility",
        "info": "Show this section only for the selected variant IDs"
      }, {
        "type": "textarea",
        "id": "variant_ids",
        "label": "Show only for these variant IDs",
        "info": "Comma-separated, e.g. 123456,789012. Leave empty to always show"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes/ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Features",
        "settings": [
          {
            "type": "image_picker",
            "id": "feature_icon",
            "label": "Icon"
          }, {
            "type": "text",
            "id": "feature_text",
            "label": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Feature"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}