{% schema %}
{
  "name": "Custom Embed Video",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "info": "Paste your full Wistia/YouTube/Vimeo embed code here"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 30,
      "max": 56,
      "step": 1,
      "unit": "%",
      "label": "Section height",
      "default": 43
    },
    {
      "type": "checkbox",
      "id": "product_pages_only",
      "label": "Only show on product pages",
      "default": true,
      "info": "Uncheck to allow this section on any page type"
    },
    {
      "type": "textarea",
      "id": "variant_ids",
      "label": "Show only for these variant IDs",
      "info": "Comma-separated, e.g. 123456,789012. Leave empty to always show on product pages"
    }
  ],
  "presets": [
    {
      "name": "Custom Embed Video"
    }
  ]
}
{% endschema %}

{% if template.name == 'product' or section.settings.product_pages_only == false %}
  <variant-visibility-scope current-variant-id="{{ product.selected_or_first_available_variant.id }}">
    <div
      class="custom-embed-video-container"
      data-variant-visibility-item
      {% if section.settings.variant_ids != blank %}
        data-variant-visibility-ids="{{ section.settings.variant_ids | escape }}"
        hidden
      {% endif %}
    >
      <div class="responsive-embed-wrapper">
        {{ section.settings.embed_code }}
      </div>
    </div>
  </variant-visibility-scope>
  <script src="{{ 'variant-visibility.js' | asset_url }}" defer></script>
{% endif %}

<style>
#shopify-section-{{ section.id }} .custom-embed-video-container {
  width: 100%;
  margin: 0 auto;
  padding: 0;
}
#shopify-section-{{ section.id }} .responsive-embed-wrapper {
  position: relative;
  padding-bottom: {{ section.settings.section_height }}%;
  height: 0;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .responsive-embed-wrapper iframe,
#shopify-section-{{ section.id }} .responsive-embed-wrapper wistia-player,
#shopify-section-{{ section.id }} .responsive-embed-wrapper .wistia_responsive_wrapper {
  position: absolute !important;
  top: 50%;
  left: 0;
  width: 100% !important;
  height: auto !important;
  aspect-ratio: 16 / 9;
  transform: translateY(-50%);
}
</style>
