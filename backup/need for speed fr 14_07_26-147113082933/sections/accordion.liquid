            <script>
              document.addEventListener('DOMContentLoaded', function () {
                const variantSelect = document.querySelector('select[name="id"]');
                const spec1 = document.getElementById('tech-spec-1');
                const spec2 = document.getElementById('tech-spec-2');

                if (!variantSelect || !spec1 || !spec2) return;

                function updateSpecs() {
                  const selectedVariant = variantSelect.value;
                  if (selectedVariant === '44711953170485') {
                    spec1.style.display = 'none';
                    spec2.style.display = 'block';
                  } else {
                    spec1.style.display = 'block';
                    spec2.style.display = 'none';
                  }
                }

                // Initialize on load
                updateSpecs();

                // Update when variant changes
                variantSelect.addEventListener('change', updateSpecs);
                document.addEventListener('product:variant-change', updateSpecs);
              });
            </script>
