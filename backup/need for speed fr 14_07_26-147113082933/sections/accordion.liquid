                  {% endif %}
                </div>
              </dd>
            </div>

            {% if has_variant_specifications %}
              <script>
                (() => {
                  const section = document.currentScript.closest('.shopify-section');
                  const accordion = section && section.querySelector('[data-variant-specifications]');
                  if (!accordion) return;

                  const panels = accordion.querySelectorAll('[data-variant-specifications-panel]');
                  const showVariantSpecifications = (variantId) => {
                    if (!variantId) return;
                    panels.forEach((panel) => {
                      panel.hidden = panel.dataset.variantId !== String(variantId);
                    });
                  };

                  const getSelectedVariantId = () => {
                    const selectedVariant = document.querySelector('select[name="id"], input[name="id"]');
                    return selectedVariant && selectedVariant.value;
                  };

                  document.addEventListener('variant:change', (event) => {
                    showVariantSpecifications(event.detail && event.detail.variant && event.detail.variant.id);
                  });
                  document.addEventListener('product:variant-change', (event) => {
                    showVariantSpecifications(event.detail && event.detail.variant && event.detail.variant.id);
                  });
                  document.addEventListener('change', (event) => {
                    if (event.target.matches('select[name="id"], input[name="id"]')) {
                      showVariantSpecifications(event.target.value);
                    }
                  });

                  showVariantSpecifications(getSelectedVariantId());
                })();
              </script>
            {% endif %}
          {% endif %}

          {% for block in section.blocks %}
            {% if block.settings.question and block.settings.answer %}
              <div class="mb-4 accordion-item">
                <dt>{{ block.settings.question }}</dt>
                <dd>
                  <div class="accordion-item__inner">
                    {% if block.settings.question == 'Technical Specifications' %}
                      <div id="variant-specs-block"></div>
                    {% else %}
                      {{ block.settings.answer }}
                    {% endif %}
                  </div>
                </dd>
              </div>
            {% endif %}
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>
</div>

{% if product.handle != 'gravity-water-filter' %}
  <style>
    .variant-description {
      max-height: 10px !important;
    }
  </style>
{% endif %}

