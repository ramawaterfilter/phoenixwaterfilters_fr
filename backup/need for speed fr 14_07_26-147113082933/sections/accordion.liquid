<script>
  document.addEventListener('DOMContentLoaded', function () {
    let currentId = null;

    function updateAccordionContent() {
      const select = document.querySelector('form[action*="/cart/add"] select[name="id"]');
      const newId = select ? select.value : null;

      if (newId !== currentId) {
        currentId = newId;

        // Update stainless steel accordions
        document.querySelectorAll('.accordion-stand').forEach((el) => {
          const id = el.getAttribute('data-variant-id');
          el.style.display = id === currentId ? 'block' : 'none';
        });

        // Update wooden stand accordions
        document.querySelectorAll('.accordion-stands').forEach((el) => {
          const id = el.getAttribute('data-variant-id');
          el.style.display = id === currentId ? 'block' : 'none';
        });
      }
    }

    setInterval(updateAccordionContent, 300); // Poll every 300ms
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const variantRadios = document.querySelectorAll('input[type="radio"][data-variant-id]');
    const filterRadios = document.querySelectorAll('input[type="radio"][name="filter-type"]');
    const accordions = document.querySelectorAll('.tech-accordion');

    // Dimensions + Weight for each variant
    const dimensions = {
      41868949028907: { height: '48CM', diameter: '19CM', weightNormal: '8.65 Pounds', weightPostreat: '10.47 Pounds' },
      41868949159979: { height: '49CM', diameter: '22CM', weightNormal: '10.41 Pounds', weightPostreat: '11.9 Pounds' },
      41868949291051: { height: '59CM', diameter: '24CM', weightNormal: '12.46 Pounds', weightPostreat: '14.2 Pounds' },
    };

    function updateAccordion() {
      const selectedVariant = document.querySelector('input[type="radio"][data-variant-id]:checked');
      const selectedId = selectedVariant ? selectedVariant.getAttribute('data-variant-id') : null;

      const selectedFilter = document.querySelector('input[type="radio"][name="filter-type"]:checked');
      const isPostreat = selectedFilter && selectedFilter.getAttribute('data-variant-id') === '44185530990645';

      accordions.forEach((acc) => {
        acc.style.display = acc.dataset.variantId === selectedId ? 'flex' : 'none';
      });

      // Update Dimensions & Weight
      document.querySelectorAll('.tech-accordion').forEach((acc) => {
        if (acc.style.display !== 'none' && dimensions[selectedId]) {
          const dimCell = acc.querySelector('.tech-dimensions-row td:last-child');
          dimCell.innerHTML = `
          Height - ${dimensions[selectedId].height}<br>
          Diameter - ${dimensions[selectedId].diameter}<br>
          Weight - ${isPostreat ? dimensions[selectedId].weightPostreat : dimensions[selectedId].weightNormal}
        `;

          // Update Filter Lifespan
          const lifespanCell = acc.querySelector('.tech-filter-lifespan-row td:last-child');
          lifespanCell.innerHTML = fluorures
            ? `<ul style="margin:0; padding-left:20px;">
              <li>Up to 5,500 gallons per pair of Carbon Filter Elements</li>
              <li>Up to 1,060 gallons per pair of POSTreat Filter Elements</li>
            </ul>`
            : `<ul style="margin:0; padding-left:20px;">
              <li>Up to 5,500 gallons per pair of Carbon Filter Elements</li>
            </ul>`;
        }
      });
    }

    updateAccordion();
    variantRadios.forEach((r) => r.addEventListener('change', updateAccordion));
    filterRadios.forEach((r) => r.addEventListener('change', updateAccordion));
  });
</script>

<style>
  .tech-accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .tech-accordion {
    display: flex;
    align-items: stretch; /* ensures both sides (content & image) match in height */
    border-radius: 12px;
    overflow: hidden;
  }

  .tech-accordion-content {
    flex: 1;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-size: 16px; /* desktop default font size */
    line-height: 1.6;
  }

  .tech-accordion-table {
    width: 100%;
    border-collapse: collapse;
  }

  .tech-accordion-table tr {
    border-bottom: 1px solid #ddd;
  }

  /* Remove border for the last row */
  .tech-accordion-table tr:last-child {
    border-bottom: none;
  }

  .tech-accordion-table td {
    padding: 12px;
    color: #333;
    vertical-align: top;
    font-size: 15px; /* desktop font size */
  }

  .tech-accordion-table td:first-child {
    font-weight: 600;
    width: 40%;
    color: #111;
  }

  .tech-accordion-image {
    width: 35%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech-accordion-image img {
    width: 75%;
    height: 100%;
    object-fit: cover; /* makes image fill height equal to content */
    border-radius: 0;
  }

  /* Responsive layout */
  @media (max-width: 768px) {
    .tech-accordion {
      flex-direction: column;
    }

    .tech-accordion-content {
      font-size: 14px; /* smaller font for mobile */
    }

    .tech-accordion-table td {
      font-size: 13px; /* smaller table text for mobile */
    }

    .tech-accordion-image {
      width: 100%;
      height: auto;
      margin-top: 15px;
    }

    .tech-accordion-image img {
      height: auto;
      max-height: 320px;
      object-fit: contain;
    }
  }
</style>
