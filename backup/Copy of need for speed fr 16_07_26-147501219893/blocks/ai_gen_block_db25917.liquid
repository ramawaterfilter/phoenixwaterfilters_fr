{% doc %}
  @prompt
    create the section make that section page the create the block html css and js and liquid cod emake that block i will directy paste the code, i need to page the code directy so only create he custom code block for htm css and js and liquild
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-code-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-custom-code__container-{{ ai_gen_id }} {
    padding: {{ block.settings.container_padding }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-code-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-custom-code__container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<custom-code-block-{{ ai_gen_id }}
  class="ai-custom-code-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-custom-code__container-{{ ai_gen_id }}">
    {% if block.settings.custom_liquid != blank %}
      {{ block.settings.custom_liquid }}
    {% endif %}

    {% if block.settings.custom_html != blank %}
      {{ block.settings.custom_html }}
    {% endif %}
  </div>
</custom-code-block-{{ ai_gen_id }}>

{% if block.settings.custom_css != blank %}
  <style>
    {{ block.settings.custom_css }}
  </style>
{% endif %}

{% if block.settings.custom_js != blank %}
  <script>
    (function() {
      {{ block.settings.custom_js }}
    })();
  </script>
{% endif %}

<script>
  (function() {
    class CustomCodeBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeCustomCode();
      }

      initializeCustomCode() {
        const event = new CustomEvent('customCodeBlockLoaded', {
          detail: { blockId: '{{ ai_gen_id }}' }
        });
        this.dispatchEvent(event);
      }
    }

    customElements.define('custom-code-block-{{ ai_gen_id }}', CustomCodeBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Custom code block",
  "settings": [
    {
      "type": "header",
      "content": "Custom code"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid code"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML code"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "CSS code"
    },
    {
      "type": "textarea",
      "id": "custom_js",
      "label": "JavaScript code"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Container padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom code block"
    }
  ]
}
{% endschema %}
