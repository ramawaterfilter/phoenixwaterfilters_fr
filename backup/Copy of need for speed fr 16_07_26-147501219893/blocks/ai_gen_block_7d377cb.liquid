      "type": "range",
      "id": "media_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Media border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "html",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Add your custom CSS here. Use the class names above to target elements."
    }
  ],
  "presets": [
    {
      "name": "Content + Video"
    }
  ]
}
{% endschema %}
