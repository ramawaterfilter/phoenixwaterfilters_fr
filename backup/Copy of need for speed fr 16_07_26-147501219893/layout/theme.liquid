<body class="template-{{ template.name }}-{{ template.suffix }}">


  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PWMJT6PK" height="0" width="0"
      style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  {% unless template.suffix == 'article' %}
  <header class="site-header">
    {% sections 'header-group' %}
  </header>
  {% endunless %}

  <main role="main">
    {{ content_for_layout }}
  </main>

  {% unless template.suffix == 'article' %}
  {% sections 'footer-group' %}
  {% if template == 'index' and settings.show_entry_popup %}
  {% render 'entry-popup' %}
  {% endif %}
  {% else %}
  {% sections 'article-footer-group' %}
  {% endunless %}

  {% unless template.suffix == 'article' %}
  {% if settings.show_exit_popup %}
  {% render 'exit-popup' %}
  {% endif %}

  {% if settings.enable_slide_cart %}
  {% render 'cart-slideout' %}
  {% endif %}

  {% render 'toast' %}

  {% endunless %}


  <script defer src="{{ 'main.js' | asset_url }}"></script>

  {% render 'wistia_lazy_core' %}

  {% if template.name == 'product' %}
    {% render 'klaviyo-back-in-stock' %}
  {% endif %}

  <script defer src="{{ 'custom-customer-referral.js' | asset_url }}"></script>
  <script defer src="{{ 'render.js' | asset_url }}"></script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      function toggleSticky() {
        const sticky = document.querySelector(".sticky-add-to-cart");
        if (!sticky) return;

        if (document.body.classList.contains("cart-open")) {
          sticky.style.display = "none";
        } else {
          sticky.style.display = "block";
        }
      }

      // Run once
      toggleSticky();

      // Detect class change efficiently
      const observer = new MutationObserver(toggleSticky);
      observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });
    });
  </script>

  {% render 'judgeme_lazy_core' %}
</body>

</html>
