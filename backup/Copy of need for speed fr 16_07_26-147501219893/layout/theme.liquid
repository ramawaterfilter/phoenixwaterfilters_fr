  {% if template.name == 'product' %}
    {%- comment -%}
      LCP preload MUST match the first slide the gallery actually paints
      (sections/custom-nice-product.liquid). That gallery shows the selected
      variant's custom.variant_images metafield when present, otherwise the
      product media / featured image. Preloading featured_media while the
      gallery paints a variant_images file downloads the wrong image and
      pushes LCP out several seconds. Keep this logic in sync with the section.
    {%- endcomment -%}
    {%- assign lcp_variant = product.selected_or_first_available_variant -%}
    {%- assign lcp_variant_files = lcp_variant.metafields.custom.variant_images.value -%}
    {%- if lcp_variant_files != blank -%}
      {%- assign lcp_image = lcp_variant_files.first -%}
    {%- else -%}
      {%- assign lcp_image = lcp_variant.featured_media.preview_image | default: product.featured_media.preview_image | default: product.featured_image -%}
    {%- endif -%}
    {% if lcp_image %}
      <link rel="preload" as="image"
            href="{{ lcp_image | image_url: width: 764 }}"
            imagesrcset="{{ lcp_image | image_url: width: 382 }} 382w, {{ lcp_image | image_url: width: 600 }} 600w, {{ lcp_image | image_url: width: 764 }} 764w, {{ lcp_image | image_url: width: 832 }} 832w, {{ lcp_image | image_url: width: 1200 }} 1200w"
            imagesizes="(max-width: 749px) calc(100vw - 30px), 600px"
            fetchpriority="high">
    {% endif %}
  {% endif %}

