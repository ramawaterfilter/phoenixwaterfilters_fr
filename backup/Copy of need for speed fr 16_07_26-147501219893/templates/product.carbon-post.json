    "e7fc5ca3-7826-4ae3-8fda-deda4cc2fcf9": {
      "type": "copy-image",
      "blocks": {
        "text_Hh7Mbt": {
          "type": "text",
          "settings": {
            "feature_text": "Garantie de 10 ans sur le système de filtration"
          }
        },
        "text_gLW6xT": {
          "type": "text",
          "settings": {
            "feature_text": "Filtre jusqu'à 12 mois d'eau avant remplacement"
          }
        }
      },
      "block_order": [
        "text_Hh7Mbt",
        "text_gLW6xT"
      ],
      "settings": {
        "style": "bg-white",
        "layout": "copy",
        "vertical_align": "align-items-center",
        "heading": "Conçu pour durer en utilisant des matériaux de première qualité",
        "content": "<p>La plupart des filtres sont en plastique, ce qui peut libérer des produits chimiques nocifs dans votre eau potable. Nous utilisons plutôt un système de filtration au charbon naturel chauffé au four, provenant du sud de l'Espagne, ainsi que du charbon actif granulaire issu de coques de noix de coco naturelles, pour éliminer les impuretés et les métaux lourds comme le plomb et le zinc. Cette filtration naturelle avancée est protégée par de l'acier inoxydable AISI 304 de qualité alimentaire. Résultat : un système de filtration raffiné et durable qui garantit une eau potable pure et limpide pendant des années.</p>",
        "video_id": "",
        "large_image": "img-standard",
        "second_content": "",
        "buttonlink": "",
        "buttontext": "",
        "afterbutton": "",
