{% render 'sticky-add-to-cart' %}

{% unless product == empty %}
  {% comment %} Product Script {% endcomment %}
  <script>
    window.product = {{ product | json }} || {};
    {% if product.metafields.custom.product_badge_text.value != blank %}
      if(typeof product !== "undefined"){
        product['badge'] = "{{ product.metafields.custom.product_badge_text.value }}";
      }
    {% endif %}
    {% comment %} Build variantStock directly from Liquid to avoid fetch failures in preview mode {% endcomment %}
    window.product.variantStock = window.product.variantStock || {};
    {% for variant in product.variants %}
      window.product.variantStock["{{ variant.id }}"] = {
        "available": {{ variant.available }},
        "inventory_management": {{ variant.inventory_management | json }},
        "inventory_policy": {{ variant.inventory_policy | json }},
        "inventory": {{ variant.inventory_quantity | default: 0 }}
      };
    {% endfor %}
    var initCurrentProduct = function () {
      if (typeof initProductScript !== 'function') return;
      if( document.readyState !== 'loading' ) {
        initProductScript(window.product, 'product-selectors', document);
      } else {
        document.addEventListener('DOMContentLoaded', function () {
          initProductScript(window.product, 'product-selectors', document);
        });
      }
    };
    {% comment %} Also try fetching metafields for extra data (min/max buy etc) but don't depend on it {% endcomment %}
    var metaInfo = {{ product.url | append: '?view=metafields' | json }};
    fetch(metaInfo)
      .then(function(response) { return response.json(); })
      .then(function(pageMeta) {
        if (pageMeta.metafields) {
          window.product.metafields = pageMeta.metafields;
        }
        if (pageMeta.variantStock) {
          window.product.variantStock = Object.assign(window.product.variantStock || {}, pageMeta.variantStock);
        }
        initCurrentProduct();
      })
      .catch(function(error) {
        console.error('Error fetching page meta:', error);
        initCurrentProduct();
      });
  </script>
{% endunless %}





{% schema %}
  {
    "name": "Product Hero",
    "tag": "section",
    "class": "section-producthero",
    "settings": [
      {
        "type": "text",
        "id": "countdown_text",
        "label": "Countdown Text",
        "info": "Use the [month] shortcode to output the current month, and the [time] shortcode to output the countdown timer."
      },
      {
        "type": "text",
        "id": "countdown_time",
        "label": "Countdown Time",
        "info": "Date, time and timezone in the format: YYYY-MM-DDTHH:mm:ss+10:00. OR for an evergreen timer, enter the number of minutes followed by the word 'minutes'. e.g. 15 minutes"
      },
      {
        "type": "product_list",
        "id": "countdown_products",
        "label": "Show Countdown On Products",
        "info": "Only show the countdown on these products. Leave blank to show on all."
      },
      {
        "type": "product_list",
        "id": "product_boost",
        "label": "Show Subscription",
        "info": "Promote a subscription product option",
        "limit": 1
      }
    ],
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "upsell",
        "name": "upsell",
        "settings": [
          {
            "type": "product",
            "id": "product_upsell",
            "label": "Upsell Product"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product Hero"
      }
    ],
    "enabled_on": {
      "templates": ["product"]
    }
  }
{% endschema %}


