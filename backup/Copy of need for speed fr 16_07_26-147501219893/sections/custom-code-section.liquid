<div class="custom-code-section">
  {{ section.settings.custom_html }}
</div>

<style>
  {{ section.settings.custom_css }}
</style>

<script>
  {{ section.settings.custom_js }}
</script>

{% schema %}
{
  "name": "Custom Code Section",
  "settings": [
    {
      "type": "textarea",
      "id": "custom_html",
      "label": "Custom HTML",
      "default": "<div style='text-align:center; padding:20px;'>\n  <h2>My Custom Section</h2>\n  <p>Write your HTML here...</p>\n</div>"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "default": "h2 { color: #1f1d36; }"
    },
    {
      "type": "textarea",
      "id": "custom_js",
      "label": "Custom JavaScript",
      "default": "console.log('Custom section loaded');"
    }
  ],
  "presets": [
    {
      "name": "Custom Code Section"
    }
  ]
}
{% endschema %}