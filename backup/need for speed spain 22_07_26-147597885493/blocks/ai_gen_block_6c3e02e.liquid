{% doc %}
  @prompt
    Create a custom Marquee Carousel section.
    Features needed:
    
    Full-width horizontal marquee bar
    
    Smooth infinite scrolling (continuous, no stopping)
    
    Background color: I will change manually
    
    Inside the marquee, allow multiple items
    
    Each item will contain:
    
    1 icon/image (I will upload manually)
    
    1 line of text (editable from theme editor)
    
    Items should repeat smoothly to create the infinite effect
    
    Padding top & bottom small
    
    Desktop and mobile responsive
    
    Option to control scrolling speed
    
    Option to add/remove items
    
    Option to change background color and text color
    
    No gap/space on left & right edges
    
    Goal: I want the section to look exactly like a top info bar with icons and messages scrolling continuously, similar to my screenshot.
    Use clean HTML, CSS, and minimal JavaScript for the marquee effect., i will add the icon but the is now space there between the privose content and icon, the icon will be add ith other content i need to give some game i need more gab between the itams  and less gab between the icon and content in same itams, the gap between the icon to showts , give some gab between the iteams , give the gap better the indial item s that will give it manully, add the css section to if i want to i can customize 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    margin: 0;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    flex-shrink: 0;
    white-space: nowrap;
    padding: 0 {{ block.settings.item_spacing }}px;
  }

  .ai-marquee-item-{{ ai_gen_id }}:not(:last-child) {
    border-right: {{ block.settings.separator_width }}px {{ block.settings.separator_style }} {{ block.settings.separator_color }};
  }

  .ai-marquee-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-marquee-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-marquee-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    line-height: 1.2;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-marquee-wrapper-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover }};
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-marquee-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-marquee-item-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_text_gap_mobile }}px;
      padding: 0 {{ block.settings.item_spacing_mobile }}px;
    }
  }

  {% if block.settings.custom_css != blank %}
    {{ block.settings.custom_css }}
  {% endif %}
{% endstyle %}

<div class="ai-marquee-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <div class="ai-marquee-track-{{ ai_gen_id }}">
