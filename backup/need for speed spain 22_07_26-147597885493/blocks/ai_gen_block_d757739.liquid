{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-video-gallery__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-video-gallery__tray-{{ ai_gen_id }} {
    background-color: {{ block.settings.container_background_color }};
    padding: 8px;
    border-radius: {{ block.settings.container_border_radius }}px;
  }

  .ai-video-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: 8px;
    align-items: center;
  }

  .ai-video-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.4s ease;
    background-color: {{ block.settings.card_background_color }};
    display: flex;
    flex-direction: column;
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-video-card-{{ ai_gen_id }}.is-active {
    transform: scale(1.10);
    z-index: 10;
  }

  .ai-video-card__header-{{ ai_gen_id }} {
    padding: 16px 20px;
    background-color: {{ block.settings.header_background_color }};
    margin: -{{ block.settings.card_padding }}px -{{ block.settings.card_padding }}px {{ block.settings.card_padding }}px;
  }

  .ai-video-card__title-{{ ai_gen_id }} {
    margin: 0;
    font-size:10px;
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_font_weight }};
    line-height: 1.3;
    text-align: {{ block.settings.title_alignment }};
    text-transform: {{ block.settings.title_text_transform }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-video-card__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    transition: aspect-ratio 0.4s ease;
  }

  .ai-video-card-{{ ai_gen_id }}.is-active .ai-video-card__wrapper-{{ ai_gen_id }} {
    aspect-ratio: 1080 / 1350;
  }

  .ai-video-card__embed-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-card__embed-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-card__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    text-align: center;
    padding: 20px;
    font-size: 10px;
    border-radius: {{ block.settings.video_border_radius }}px;
  }
@media (max-width: 768px) {
  .ai-video-card__placeholder-{{ ai_gen_id }} {
    padding: 12px;
    font-size: 10px !important;
  
  }
}
