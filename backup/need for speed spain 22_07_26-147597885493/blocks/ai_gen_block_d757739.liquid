              <button class="ai-video-card__mute-btn-{{ ai_gen_id }}" aria-label="Mute video" data-mute-btn>
                {% if block.settings.unmuted_icon %}
                  <img src="{{ block.settings.unmuted_icon | image_url: width: 80 }}" alt="Unmuted" class="unmuted-icon">
                {% endif %}
                {% if block.settings.muted_icon %}
                  <img src="{{ block.settings.muted_icon | image_url: width: 80 }}" alt="Muted" class="muted-icon" style="display: none;">
                {% endif %}
              </button>
            {% else %}
              <div class="ai-video-card__placeholder-{{ ai_gen_id }}">
                Add Wistia embed code for video 4
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="ai-video-gallery__dots-{{ ai_gen_id }}">
      <button class="ai-video-gallery__dot-{{ ai_gen_id }} is-active" data-dot-index="0" aria-label="Go to video 1"></button>
      <button class="ai-video-gallery__dot-{{ ai_gen_id }}" data-dot-index="1" aria-label="Go to video 2"></button>
      <button class="ai-video-gallery__dot-{{ ai_gen_id }}" data-dot-index="2" aria-label="Go to video 3"></button>
      <button class="ai-video-gallery__dot-{{ ai_gen_id }}" data-dot-index="3" aria-label="Go to video 4"></button>
    </div>
  </div>
</ai-video-gallery-{{ ai_gen_id }}>

<script>
(function() {
  class AiVideoGallery{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.cards = [];
      this.dots = [];
      this.activeIndex = 0;
      this.wistiaVideos = [];
      this.grid = null;
      this.isMobile = false;
      this.touchStartX = 0;
      this.touchEndX = 0;
      this.isScrolling = false;
    }

    connectedCallback() {
      this.cards = Array.from(this.querySelectorAll('.ai-video-card-{{ ai_gen_id }}'));
      this.dots = Array.from(this.querySelectorAll('.ai-video-gallery__dot-{{ ai_gen_id }}'));
      this.grid = this.querySelector('.ai-video-gallery__grid-{{ ai_gen_id }}');
      
      this.checkMobile();
      this.setupEventListeners();
      this.initializeWistiaVideos();
      
      window.addEventListener('resize', () => this.checkMobile());
    }

    checkMobile() {
      this.isMobile = window.innerWidth <= 768;
      
      if (this.isMobile && this.grid) {
        this.setupScrollListener();
        this.setupTouchListeners();
      }
    }

    setupScrollListener() {
      if (!this.grid) return;
      
      let scrollTimeout;
      this.grid.addEventListener('scroll', () => {
        this.isScrolling = true;
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          this.updateActiveCardOnScroll();
          this.isScrolling = false;
        }, 150);
      });
    }

    setupTouchListeners() {
      if (!this.grid) return;

      this.grid.addEventListener('touchstart', (e) => {
        this.touchStartX = e.touches[0].clientX;
      }, { passive: true });

      this.grid.addEventListener('touchmove', (e) => {
        this.touchEndX = e.touches[0].clientX;
      }, { passive: true });

      this.grid.addEventListener('touchend', () => {
        this.handleSwipe();
      }, { passive: true });
    }

    handleSwipe() {
      if (!this.isMobile) return;

      const swipeThreshold = 50;
      const diff = this.touchStartX - this.touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0 && this.activeIndex < this.cards.length - 1) {
          this.setActiveCard(this.activeIndex + 1, true);
        } else if (diff < 0 && this.activeIndex > 0) {
          this.setActiveCard(this.activeIndex - 1, true);
        }
      }

      this.touchStartX = 0;
      this.touchEndX = 0;
    }

    updateActiveCardOnScroll() {
      if (!this.isMobile || !this.grid) return;
      
      const scrollLeft = this.grid.scrollLeft;
      const cardWidth = this.cards[0].offsetWidth;
      const gap = 10;
      const newIndex = Math.round(scrollLeft / (cardWidth + gap));
      
      if (newIndex !== this.activeIndex && newIndex >= 0 && newIndex < this.cards.length) {
        this.setActiveCard(newIndex, false);
      }
    }

    setupEventListeners() {
      this.cards.forEach((card, index) => {
        card.addEventListener('click', (e) => {
          if (!e.target.closest('[data-play-btn]') && !e.target.closest('[data-mute-btn]')) {
            this.setActiveCard(index, true);
          }
        });

        const playBtn = card.querySelector('[data-play-btn]');
        const muteBtn = card.querySelector('[data-mute-btn]');

        if (playBtn) {
          playBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            this.togglePlayPause(index);
          });
        }

        if (muteBtn) {
          muteBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            this.toggleMute(index);
          });
        }
      });

      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          this.setActiveCard(index, true);
        });
      });
    }

    initializeWistiaVideos() {
      this.cards.forEach((card, index) => {
        const iframe = card.querySelector('iframe');
        if (iframe && iframe.src && iframe.src.includes('wistia')) {
          const videoId = this.extractWistiaId(iframe.src);
          if (videoId) {
            this.wistiaVideos[index] = { iframe, videoId, isPlaying: false, isMuted: true };
            
            if (index === 0) {
              this.autoplayVideo(index);
            }
          }
        }
      });
    }

    extractWistiaId(src) {
      const match = src.match(/wistia\.com\/embed\/iframe\/([a-zA-Z0-9]+)/);
      return match ? match[1] : null;
    }

    setActiveCard(index, shouldScroll) {
      if (this.activeIndex === index) return;

      this.cards.forEach((card, i) => {
        if (i === index) {
          card.classList.add('is-active');
        } else {
          card.classList.remove('is-active');
          this.pauseVideo(i);
        }
      });

      this.dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });

      this.activeIndex = index;
      
      if (shouldScroll && this.isMobile && this.grid && !this.isScrolling) {
        const card = this.cards[index];
        const cardWidth = card.offsetWidth;
        const gap = 10;
        const scrollPosition = index * (cardWidth + gap);
        this.grid.scrollTo({
          left: scrollPosition,
          behavior: 'smooth'
        });
      }
      
      this.autoplayVideo(index);
    }

    autoplayVideo(index) {
      const video = this.wistiaVideos[index];
      if (video && video.iframe) {
        video.iframe.contentWindow.postMessage(JSON.stringify({
          method: 'play',
          value: ''
        }), '*');
        video.isPlaying = true;
        this.updatePlayButton(index, true);
      }
    }

    togglePlayPause(index) {
      const video = this.wistiaVideos[index];
      if (!video || !video.iframe) return;

      if (video.isPlaying) {
        video.iframe.contentWindow.postMessage(JSON.stringify({
          method: 'pause',
          value: ''
        }), '*');
        video.isPlaying = false;
      } else {
        video.iframe.contentWindow.postMessage(JSON.stringify({
          method: 'play',
          value: ''
        }), '*');
        video.isPlaying = true;
      }

      this.updatePlayButton(index, video.isPlaying);
    }

    pauseVideo(index) {
      const video = this.wistiaVideos[index];
      if (video && video.iframe && video.isPlaying) {
        video.iframe.contentWindow.postMessage(JSON.stringify({
          method: 'pause',
          value: ''
        }), '*');
        video.isPlaying = false;
        this.updatePlayButton(index, false);
      }
    }

    toggleMute(index) {
      const video = this.wistiaVideos[index];
      if (!video || !video.iframe) return;

      if (video.isMuted) {
        video.iframe.contentWindow.postMessage(JSON.stringify({
          method: 'unmute',
          value: ''
        }), '*');
        video.isMuted = false;
      } else {
        video.iframe.contentWindow.postMessage(JSON.stringify({
          method: 'mute',
          value: ''
        }), '*');
        video.isMuted = true;
      }

      this.updateMuteButton(index, video.isMuted);
    }

    updatePlayButton(index, isPlaying) {
      const card = this.cards[index];
      const playBtn = card.querySelector('[data-play-btn]');
      if (!playBtn) return;
      
      const playIcon = playBtn.querySelector('.play-icon');
      const pauseIcon = playBtn.querySelector('.pause-icon');

      if (isPlaying) {
        if (playIcon) playIcon.style.display = 'none';
        if (pauseIcon) pauseIcon.style.display = 'block';
      } else {
        if (playIcon) playIcon.style.display = 'block';
        if (pauseIcon) pauseIcon.style.display = 'none';
      }
    }

    updateMuteButton(index, isMuted) {
      const card = this.cards[index];
      const muteBtn = card.querySelector('[data-mute-btn]');
      if (!muteBtn) return;
      
      const unmutedIcon = muteBtn.querySelector('.unmuted-icon');
      const mutedIcon = muteBtn.querySelector('.muted-icon');

      if (isMuted) {
        if (unmutedIcon) unmutedIcon.style.display = 'none';
        if (mutedIcon) mutedIcon.style.display = 'block';
      } else {
        if (unmutedIcon) unmutedIcon.style.display = 'block';
        if (mutedIcon) mutedIcon.style.display = 'none';
      }
    }
  }

  customElements.define('ai-video-gallery-{{ ai_gen_id }}', AiVideoGallery{{ ai_gen_id }});
})();
</script>

