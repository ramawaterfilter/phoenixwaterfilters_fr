{% doc %}
  @prompt
    Create a custom Shopify section called "Expandable Video Carousel".
    
    Requirements:
    
    • Desktop layout:
      - Display multiple video cards in one horizontal row
      - Only one video can be active at a time
      - Active video expands in height smoothly
      - Inactive videos remain shorter
      - Clicking another video collapses the current one and expands the clicked one
      - Smooth CSS transitions for height change
    
    • Mobile layout:
      - One video per row
      - Videos stacked vertically
      - Only one video visible at a time
      - Swipe or dot navigation below videos
      - Active video expands in height
      - Match mobile behavior like a vertical video slider
    
    • Section settings:
      - Heading text
      - Optional subheading
      - Background color
      - Padding controls
      - Max width
    
    • Block settings (repeatable blocks):
      - Thumbnail image
      - Optional title
      - Optional description
      - Textarea field for Wistia embed code
      - Autoplay toggle
      - Mute by default toggle
    
    • Video behavior:
      - Autoplay active video
      - Pause all inactive videos
      - Default muted autoplay
      - Custom play/pause button overlay
      - Custom mute/unmute button
      - Show controls only on active video
    
    • Navigation:
      - Dot navigation below videos
      - Active dot updates on video change
      - Clicking dots switches active video
    
    • Technical requirements:
      - Use pure Liquid, CSS, and vanilla JavaScript
      - No external libraries
      - Fully responsive
      - Accessible buttons (aria-labels)
      - Render Wistia embed using raw Liquid output
    
    • Styling:
      - Rounded corners
      - Clean modern ecommerce style
      - Smooth animations
      - Match premium product landing page quality
    
    The section must be fully editable from the Shopify Theme Editor and allow manual Wistia embed updates without code changes.
    
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-video-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-video-carousel__heading-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 12px;
    color: #000000;
  }

  .ai-video-carousel__subheading-{{ ai_gen_id }} {
    font-size: 16px;
    color: #666666;
    margin: 0;
  }

  .ai-video-carousel__videos-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
  }

  .ai-video-carousel__card-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    height: 300px;
    position: relative;
  }

  .ai-video-carousel__card-{{ ai_gen_id }}.active {
    height: 500px;
  }

  .ai-video-carousel__thumbnail-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__card-{{ ai_gen_id }}.active .ai-video-carousel__thumbnail-{{ ai_gen_id }} {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__card-{{ ai_gen_id }}.active .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-carousel__info-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    color: #ffffff;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__card-{{ ai_gen_id }}.active .ai-video-carousel__info-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-video-carousel__title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .ai-video-carousel__description-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0;
    opacity: 0.9;
  }

  .ai-video-carousel__controls-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    gap: 12px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 10;
  }

  .ai-video-carousel__card-{{ ai_gen_id }}.active .ai-video-carousel__controls-{{ ai_gen_id }} {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-video-carousel__control-btn-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.9);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .ai-video-carousel__control-btn-{{ ai_gen_id }}:hover {
    background-color: #ffffff;
    transform: scale(1.1);
  }

  .ai-video-carousel__control-btn-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-video-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #d0d0d0;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    background-color: #000000;
    width: 32px;
    border-radius: 6px;
  }

  .ai-video-carousel__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999999;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__videos-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 0;
      position: relative;
      overflow: hidden;
    }

    .ai-video-carousel__card-{{ ai_gen_id }} {
      display: none;
      height: 400px;
      width: 100%;
    }

    .ai-video-carousel__card-{{ ai_gen_id }}.active {
      display: block;
      height: 500px;
    }

    .ai-video-carousel__heading-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-video-carousel__subheading-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<expandable-video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-video-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-video-carousel__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign has_videos = false %}
    {% if block.settings.video_1_embed != blank or block.settings.video_2_embed != blank or block.settings.video_3_embed != blank %}
      {% assign has_videos = true %}
    {% endif %}

    {% if has_videos %}
      <div class="ai-video-carousel__videos-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% assign embed_key = 'video_' | append: i | append: '_embed' %}
          {% assign thumbnail_key = 'video_' | append: i | append: '_thumbnail' %}
          {% assign title_key = 'video_' | append: i | append: '_title' %}
          {% assign description_key = 'video_' | append: i | append: '_description' %}
          {% assign autoplay_key = 'video_' | append: i | append: '_autoplay' %}
          {% assign muted_key = 'video_' | append: i | append: '_muted' %}

          {% assign embed = block.settings[embed_key] %}
          {% assign thumbnail = block.settings[thumbnail_key] %}
          {% assign title = block.settings[title_key] %}
          {% assign description = block.settings[description_key] %}
          {% assign autoplay = block.settings[autoplay_key] %}
          {% assign muted = block.settings[muted_key] %}

          {% if embed != blank %}
            {% assign card_index = forloop.index0 %}
            {% assign is_first = forloop.first %}
            
            <div 
              class="ai-video-carousel__card-{{ ai_gen_id }} {% if is_first %}active{% endif %}"
              data-video-index="{{ card_index }}"
              data-autoplay="{{ autoplay }}"
              data-muted="{{ muted }}"
            >
              {% if thumbnail %}
                <img
                  src="{{ thumbnail | image_url: width: 800 }}"
                  alt="{{ title | escape }}"
                  class="ai-video-carousel__thumbnail-{{ ai_gen_id }}"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-video-carousel__thumbnail-{{ ai_gen_id }}" style="background-color: #e0e0e0;"></div>
              {% endif %}

              <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
                {{ embed }}
              </div>

              {% if title != blank or description != blank %}
                <div class="ai-video-carousel__info-{{ ai_gen_id }}">
                  {% if title != blank %}
                    <h3 class="ai-video-carousel__title-{{ ai_gen_id }}">{{ title }}</h3>
                  {% endif %}
                  {% if description != blank %}
                    <p class="ai-video-carousel__description-{{ ai_gen_id }}">{{ description }}</p>
                  {% endif %}
                </div>
              {% endif %}

              <div class="ai-video-carousel__controls-{{ ai_gen_id }}">
                <button 
                  class="ai-video-carousel__control-btn-{{ ai_gen_id }} ai-video-carousel__play-btn-{{ ai_gen_id }}"
                  aria-label="Play video"
                  data-action="play"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
                <button 
                  class="ai-video-carousel__control-btn-{{ ai_gen_id }} ai-video-carousel__pause-btn-{{ ai_gen_id }}"
                  aria-label="Pause video"
                  data-action="pause"
                  style="display: none;"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                  </svg>
                </button>
                <button 
                  class="ai-video-carousel__control-btn-{{ ai_gen_id }} ai-video-carousel__mute-btn-{{ ai_gen_id }}"
                  aria-label="Unmute video"
                  data-action="unmute"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                  </svg>
                </button>
                <button 
                  class="ai-video-carousel__control-btn-{{ ai_gen_id }} ai-video-carousel__unmute-btn-{{ ai_gen_id }}"
                  aria-label="Mute video"
                  data-action="mute"
                  style="display: none;"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                  </svg>
                </button>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% assign video_count = 0 %}
      {% for i in (1..3) %}
        {% assign embed_key = 'video_' | append: i | append: '_embed' %}
        {% if block.settings[embed_key] != blank %}
          {% assign video_count = video_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if video_count > 1 %}
        <ul class="ai-video-carousel__dots-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% assign embed_key = 'video_' | append: i | append: '_embed' %}
            {% if block.settings[embed_key] != blank %}
              {% assign dot_index = forloop.index0 %}
              <li>
                <button
                  class="ai-video-carousel__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                  data-dot-index="{{ dot_index }}"
                  aria-label="Go to video {{ forloop.index }}"
                ></button>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    {% else %}
      <div class="ai-video-carousel__empty-{{ ai_gen_id }}">
        Add Wistia embed codes to display videos
      </div>
    {% endif %}
  </div>
</expandable-video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ExpandableVideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cards = [];
        this.dots = [];
        this.wistiaPlayers = {};
      }

      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('.ai-video-carousel__card-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-video-carousel__dot-{{ ai_gen_id }}'));
        
        if (this.cards.length === 0) return;
        
        this.setupEventListeners();
        this.initializeWistia();
      }

      setupEventListeners() {
        this.cards.forEach((card, index) => {
          card.addEventListener('click', (e) => {
            if (!e.target.closest('.ai-video-carousel__controls-{{ ai_gen_id }}')) {
              this.switchToVideo(index);
            }
          });

          const controls = card.querySelectorAll('.ai-video-carousel__control-btn-{{ ai_gen_id }}');
          controls.forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const action = btn.dataset.action;
              this.handleControlAction(index, action);
            });
          });
        });

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.switchToVideo(index);
          });
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        this.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe(touchStartX, touchEndX);
        });
      }

      handleSwipe(startX, endX) {
        const threshold = 50;
        const diff = startX - endX;

        if (Math.abs(diff) > threshold) {
          if (diff > 0 && this.currentIndex < this.cards.length - 1) {
            this.switchToVideo(this.currentIndex + 1);
          } else if (diff < 0 && this.currentIndex > 0) {
            this.switchToVideo(this.currentIndex - 1);
          }
        }
      }

      initializeWistia() {
        if (typeof window._wq === 'undefined') {
          window._wq = window._wq || [];
        }

        this.cards.forEach((card, index) => {
          const iframe = card.querySelector('iframe[src*="wistia"]');
          if (iframe && iframe.src) {
            const videoId = this.extractWistiaId(iframe.src);
            if (videoId) {
              window._wq.push({
                id: videoId,
                onReady: (video) => {
                  this.wistiaPlayers[index] = video;
                  
                  const autoplay = card.dataset.autoplay === 'true';
                  const muted = card.dataset.muted === 'true';
                  
                  if (muted) {
                    video.mute();
                  }
                  
                  if (index === 0 && autoplay) {
                    video.play();
                    this.updatePlayPauseButtons(index, true);
                  }

                  video.bind('play', () => {
                    this.updatePlayPauseButtons(index, true);
                  });

                  video.bind('pause', () => {
                    this.updatePlayPauseButtons(index, false);
                  });

                  video.bind('volumechange', () => {
                    this.updateMuteButtons(index, video.isMuted());
                  });
                }
              });
            }
          }
        });
      }

      extractWistiaId(url) {
        const match = url.match(/wistia\.com\/embed\/iframe\/([a-zA-Z0-9]+)/);
        return match ? match[1] : null;
      }

      switchToVideo(index) {
        if (index === this.currentIndex) return;

        this.cards.forEach((card, i) => {
          card.classList.toggle('active', i === index);
          
          if (this.wistiaPlayers[i]) {
            if (i !== index) {
              this.wistiaPlayers[i].pause();
            } else {
              const autoplay = card.dataset.autoplay === 'true';
              if (autoplay) {
                this.wistiaPlayers[i].play();
              }
            }
          }
        });

        this.dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === index);
        });

        this.currentIndex = index;
      }

      handleControlAction(index, action) {
        const player = this.wistiaPlayers[index];
        if (!player) return;

        switch(action) {
          case 'play':
            player.play();
            break;
          case 'pause':
            player.pause();
            break;
          case 'mute':
            player.mute();
            break;
          case 'unmute':
            player.unmute();
            break;
        }
      }

      updatePlayPauseButtons(index, isPlaying) {
        const card = this.cards[index];
        const playBtn = card.querySelector('.ai-video-carousel__play-btn-{{ ai_gen_id }}');
        const pauseBtn = card.querySelector('.ai-video-carousel__pause-btn-{{ ai_gen_id }}');

        if (playBtn && pauseBtn) {
          playBtn.style.display = isPlaying ? 'none' : 'flex';
          pauseBtn.style.display = isPlaying ? 'flex' : 'none';
        }
      }

      updateMuteButtons(index, isMuted) {
        const card = this.cards[index];
        const muteBtn = card.querySelector('.ai-video-carousel__mute-btn-{{ ai_gen_id }}');
        const unmuteBtn = card.querySelector('.ai-video-carousel__unmute-btn-{{ ai_gen_id }}');

        if (muteBtn && unmuteBtn) {
          muteBtn.style.display = isMuted ? 'flex' : 'none';
          unmuteBtn.style.display = isMuted ? 'none' : 'flex';
        }
      }
    }

    customElements.define('expandable-video-carousel-{{ ai_gen_id }}', ExpandableVideoCarousel{{ ai_gen_id }});
  })();
</script>

