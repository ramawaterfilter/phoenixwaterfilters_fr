<!-- JavaScript -->
<script>
window.product = {{ product | json }} || {};

window.formatMoney = function(cents) {
  if (!cents) return '\u20AC 0,00';
  if (typeof cents === 'string' && cents.includes('\u20AC')) return cents;

  const value = typeof cents === 'string'
    ? parseFloat(cents.replace(/[^0-9.-]/g, ''))
    : cents;

  return '\u20AC ' + (value / 100).toFixed(2).replace('.', ',');
};

(function() {
  'use strict';

  const root = document.getElementById('shopify-section-{{ section.id }}') || document;
  const productSelect = root.querySelector('#product-select');
  const radios = root.querySelectorAll('.variant-radio');

  if (!productSelect || !radios.length) return;

  const optionGroups = root.querySelectorAll('.variant-option-group');
  const priceElement = root.querySelector('#product-price');
  const compareElement = root.querySelector('#product-compare-price');
  const saleBadge = root.querySelector('#sale-badge');
  const addToCartButton = root.querySelector('#product-add-to-cart');
  const productSlider = root.querySelector('#product-slider');
  const thumbnailSlider = root.querySelector('#product-slider-nav');
  const slides = productSlider?.querySelectorAll('.swiper-slide') || [];

  radios.forEach(radio => {
    radio.addEventListener('change', function() {
      if (!this.checked) return;

      const selectedValue = root.querySelector(
        `.selected-variant-value[data-option-index="${this.dataset.optionIndex}"]`
      );
      if (selectedValue) selectedValue.textContent = this.value;

      updateVariant();
    });
  });

  function updateVariant() {
    const selectedOptions = Array.from(optionGroups, group =>
      group.querySelector('.variant-radio:checked')?.value
    );
    const variant = window.product.variants.find(item =>
      selectedOptions.every((value, index) => item.options[index] === value)
    );

    if (!variant) return;

    productSelect.value = variant.id;
    productSelect.dispatchEvent(new Event('change', { bubbles: true }));
    updatePrice(variant);
    updateAvailability(variant);
    updateImage(variant);
  }

  function updatePrice(variant) {
    if (priceElement) {
      priceElement.textContent = window.formatMoney(variant.price);
    }

    const discounted = variant.compare_at_price && variant.compare_at_price > variant.price;

    if (compareElement) {
      compareElement.innerHTML = discounted
        ? `<s>${window.formatMoney(variant.compare_at_price)}</s>`
        : '';
    }

    if (saleBadge) {
      saleBadge.style.display = discounted ? 'inline-block' : 'none';
    }
  }

  function updateAvailability(variant) {
    if (!addToCartButton) return;

    addToCartButton.disabled = !variant.available;
    addToCartButton.textContent = variant.available
      ? addToCartButton.dataset.addText || 'Add to Cart'
      : 'Sold Out';
  }

  function updateImage(variant) {
    const imageUrl = variant.featured_image?.src;
    if (!imageUrl) return;

    if (!productSlider) {
      const mainImage = root.querySelector('.product-image img');
      if (mainImage) mainImage.src = imageUrl;
      return;
    }

    const mainSwiper = window.productSwiper || productSlider.swiper;
    if (!mainSwiper) return;

    const imageKey = extractImageKey(imageUrl);
    const targetIndex = Array.from(slides).findIndex(slide => {
      const image = slide.querySelector('img');
      return image && extractImageKey(image.src) === imageKey;
    });

    if (targetIndex < 0) return;

    mainSwiper.slideTo(targetIndex, 300);
    const thumbnailSwiper = window.productSwiperNav || thumbnailSlider?.swiper;
    if (thumbnailSwiper) thumbnailSwiper.slideTo(targetIndex, 300);
  }

  function extractImageKey(url) {
    return url
      .split('?')[0]
      .split('/')
      .pop()
      .replace(/_\d+x\d*\.(jpg|jpeg|png|webp|gif)/i, '.$1')
      .replace(/_(large|medium|small|compact|grande|original)\.(jpg|jpeg|png|webp|gif)/i, '.$2')
      .toLowerCase();
  }
})();
</script>
