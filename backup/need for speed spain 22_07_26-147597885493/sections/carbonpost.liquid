{% assign current_variant = product.selected_or_first_available_variant %}

<div class="container">
  <div class="row justify-content-center">
    
    <!-- Product Images -->
    <div class="col-11 col-lg-6">
      <div class="position-relative {% if product.images.size <= 0 %}h-100{% endif %}">
        
        {% if product.images.size > 1 %}
          <!-- Main Image Slider -->
          <div class="swiper-container swiper" data-slidestoshow="1" id="product-slider">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                {% assign this_variant_id = "" %}
                {% for variant in product.variants %}
                  {% if variant.featured_image.src == media.src %}
                    {% assign this_variant_id = variant.id %}
                  {% endif %}
                {% endfor %}

                {% if media.media_type == "image" %}
                  <div class="swiper-slide" data-variant-id="{{ this_variant_id }}" data-slide-index="{{ forloop.index }}">
                    <a data-fancybox="gallery" href="{{ media | image_url: width: 2560 }}" class="product-image d-block">
                      {{ media | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% elsif media.media_type == "external_video" %}
                  <div class="swiper-slide" data-variant-id="{{ this_variant_id }}" data-slide-index="{{ forloop.index }}">
                    <a data-fancybox="gallery" href="{{ media | external_video_url: autoplay: 'true' }}" class="product-image product-image--video d-block">
                      {{ media.preview_image | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% elsif media.media_type == "video" %}
                  <div class="swiper-slide" data-variant-id="{{ this_variant_id }}" data-slide-index="{{ forloop.index }}">
                    <a data-fancybox="gallery" aria-label="Play product video" href="{{ media.sources[1].url }}" class="product-image--video">
                      {{ media.preview_image | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% endif %}                  
              {% endfor %}                
            </div>
          </div>

          <!-- Thumbnail Slider -->
          <div class="swiper-container swiper control product-thumbnails" id="product-slider-nav">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                <div class="swiper-slide">
                  {% if media.media_type == "external_video" %}
                    {{ media.preview_image | image_url: width: 800 | image_tag }}
                  {% elsif media.media_type == "image" %}
                    {{ media | image_url: width: 800 | image_tag }}
                  {% elsif media.media_type == "video" %}
                    {{ media.preview_image | image_url: width: 800 | image_tag }}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>

          <div class="swiper-nav">
            <div class="swiper-button-prev swiper-prev"></div>
            <div class="swiper-button-next swiper-next"></div>
          </div>

        {% elsif product.featured_image %}
          <a data-fancybox="gallery" href="{{ product.featured_image | image_url: width: 2560 }}" class="product-image d-block">
            {{ product.featured_image | image_url: width: 1200 | image_tag }}
          </a>
        {% else %}
          <div class="placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

      </div>
    </div>

    <!-- Product Details -->
    <div class="col-11 col-lg-6 mt-3 mt-lg-0">
      
      {% render 'product-hero-countdown', section: section %}
      
      <h1 class="product__title">{{ product.title }}</h1>
      
      <div class="product-rating">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
          {% endcase %}
        {% endfor %}
      </div>

<div class="product-description">
  <div id="variant-main-description">
    {{ product.selected_or_first_available_variant.metafields.custom.short_description | metafield_tag }}
  </div>
</div>

<script>
  window.variantDescriptions = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {{ variant.metafields.custom.short_description | metafield_tag | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  function updateVariantDescription() {
    const form = document.getElementById("add-to-cart");
    const variantInput = form?.querySelector("[name='id']");
    const container = document.getElementById("variant-main-description");

    if (!variantInput || !container) return;

    const variantId = variantInput.value;
    const description = window.variantDescriptions[variantId];

    container.innerHTML = description || "";
  }

  document.addEventListener("change", function(e) {
    if (!e.target.closest("#add-to-cart")) return;
    updateVariantDescription();
  });

  // ✅ Run on page load
  document.addEventListener("DOMContentLoaded", updateVariantDescription);
</script>
      <!-- SIMPLE VARIANT PICKER STARTS HERE -->
      {% if product.available and product.variants.size > 1 %}
        <div class="simple-variant-picker">
          
          {% for option in product.options_with_values %}
            <div class="variant-option-group">
              
              <!-- Option Label -->
              <label class="variant-label">
                {{ option.name }}: 
                <span class="selected-variant-value" data-option-index="{{ forloop.index0 }}">
                  {{ option.selected_value }}
                </span>
              </label>
              







              
              <!-- Option Values as Radio Buttons -->
            <div class="variant-values">
  {% for value in option.values %}
    {% assign option_index = forloop.parentloop.index0 %}
    {% assign matched_variant = nil %}
    {% for variant in product.variants %}
      {% if variant.options[option_index] == value %}
        {% assign matched_variant = variant %}
        {% break %}
      {% endif %}
    {% endfor %}

    <label class="variant-radio-wrapper">
      <input 
        type="radio" 
        name="option{{ option.position }}"
        value="{{ value | escape }}"
        data-option-index="{{ option_index }}"
        {% if option.selected_value == value %}checked{% endif %}
        class="variant-radio">
<div class="variant-image-option">
      <span class="variant-image">
        {% if matched_variant.featured_image %}
          <img 
            src="{{ matched_variant.featured_image | image_url: width: 100 }}" 
            alt="{{ value }}"
            loading="lazy"
            width="100"
            height="100">
        {% else %}
          {{ value }}
        {% endif %}
      </span>
</div>
    </label>
  {% endfor %}
</div>
              
            </div>
          {% endfor %}
          
        </div>
      {% endif %}
      <!-- SIMPLE VARIANT PICKER ENDS HERE -->

      <!-- Add to Cart Form -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="add-to-cart">

        <!-- Hidden Select (Required for Shopify) -->
        <div class="variant-select-wrapper" style="display: none;">
          <select name="id" id="product-select" class="product-select">
            {% for variant in product.variants %}
              <option 
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                data-price="{{ variant.price }}"
                data-compare="{{ variant.compare_at_price }}"
                data-available="{{ variant.available }}"
                data-image="{{ variant.featured_image.src | image_url: width: 1200 }}">
                {{ variant.title }}
              </option>
            {% endfor %}
          </select>
        </div>

        <!-- Price Display -->
        <div class="priceline my-5">

          
          <span id="product-price" data-price class="product-dyn-price m-0">
            {{ current_variant.price | money }}
          </span>
          <span id="product-compare-price" data-compare class="product-compare-price">
            {% if current_variant.compare_at_price > current_variant.price %}
              <s>{{ current_variant.compare_at_price | money }}</s>
            {% endif %}
          </span>
      
<div id="inventory-indicator" class="inventory-box">
  {% if current_variant.inventory_quantity > 0 %}
    <span class="inventory-status inventory-available">
      En stock
    </span>
  {% else %}
    <span class="inventory-status inventory-unavailable">
      Agotado
    </span>
  {% endif %}
</div>





{% if product.handle == 'smart-carboncartouches' %}
  <div class="sale-badge" id="sale-badge" style="display:none;">
 Vente 
  </div>
{% else %}
  <div class="sale-badge" id="sale-badge"
       {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
    Vente
  </div>
{% endif %}











        </div>

        {% if product.available %}
          <span class="appstle_stand_alone_selector" data-product-handle="{{ product.handle }}" data-product-data="" style="display:none;"></span>
          
          <!-- Add to Cart Button -->
          <button
            class="btn btn-large btn-secondary btn-product d-flex flex-row justify-content-center align-items-center"
            type="submit"
            name="add"
            id="product-add-to-cart"
            data-add-text="{{ 'products.product.add_to_cart' | t }}">
            {{ 'products.product.add_to_cart' | t }}
          </button>

          <!-- Payment Icons -->
          <div class="payment-icons d-flex justify-content-center align-items-center gap-3">
            <img src="{{ 'visa.png' | asset_url }}" alt="visa" height="20.42" width="45.15" />
            <img src="{{ 'mastercard.png' | asset_url }}" height="20.7" width="32.45" alt="mastercard" />
            <img src="{{ 'paypal.png' | asset_url }}" alt="paypal" height="25.41" width="20.99" />
            <img src="{{ 'amex.png' | asset_url }}" height="20.11" width="54.44" alt="amex" />
            <img src="https://cdn.shopify.com/s/files/1/2644/2852/files/Shop_Pay_logo.png?v=1761737843" alt="Shop Pay" height="23.11" width="74.44" />
          </div>

          <!-- Below ATC Icons -->
          <div class="below-atc-icons">
            <div>
              <img src="{{ 'icon-truck.png' | asset_url }}" alt="Truck Icon" width="24" height="24">
              <span>ENVÍO GRATIS EN TODA EUROPA</span>
            </div>
        
            <div>
              <img src="{{ 'icon-headset.png' | asset_url }}" alt="Headset Icon" width="24" height="24">
              <span>Atención al cliente</span>
            </div>
                <div>
      <img src="https://cdn.shopify.com/s/files/1/2644/2852/files/Universal_fit_v3-02.png?v=1761830204" alt="Warehouse" width="24" height="24">
       <span>Ajustement universel</span>
       </div> 
           
            <div>
              <img src="https://cdn.shopify.com/s/files/1/2644/2852/files/product_warehouse.png" alt="Warehouse" width="24" height="24">
              <span>Envío desde un almacén con sede en Francia</span>
            </div>
             <div>
              <img src="https://cdn.shopify.com/s/files/1/0656/9898/8085/files/nsf-01_3_1.png?v=1775568221" alt="NSF" width="24" height="24">
              <span>Certificado NSF 372, <br>ANSI 42</span>
            </div>
              <div>
      <img src="https://cdn.shopify.com/s/files/1/2644/2852/files/Vector_Smart_Object.png?v=1761828395" alt="eco" width="24" height="24">
       <span>Écologique </span>
       </div>
          </div>

        {% else %}
          <button class="btn btn-large btn-primary btn-product" name="add" disabled type="submit">
            {{ 'products.product.sold_out' | t }}
          </button>
        {% endif %}

      </form>

    </div>
  </div>
</div>

{% render 'sticky-add-to-cart' %}

