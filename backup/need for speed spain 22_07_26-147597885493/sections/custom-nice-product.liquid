<style>
  /* ===========================
   COMPARISON TABLE
   =========================== */
  .pdp-comparison {
    margin-top: 2rem;
    overflow-x: auto;
  }
  .pdp-comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    background: #fff;
  }
  .pdp-comparison-table th,
  .pdp-comparison-table td {
    padding: 10px 8px;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
  }
  .pdp-comp-feature-header {
    background: #f9fafb;
    font-weight: 600;
    color: #374151;
    text-align: left !important;
    white-space: nowrap;
  }
  .pdp-comp-col-header {
    font-weight: 700;
    color: #153a5b;
    vertical-align: bottom;
  }
  .pdp-comp-col-header img {
    display: block;
    margin: 0 auto 6px;
    max-height: 60px;
    width: auto;
    object-fit: contain;
  }
  .pdp-comp-col-header span {
    display: block;
    font-size: 12px;
    line-height: 1.3;
  }
  .pdp-comp-feature {
    font-weight: 600;
    color: #374151;
    text-align: left !important;
    white-space: nowrap;
  }
  .pdp-comp-cell {
    color: #4b5563;
    font-size: 12px;
    line-height: 1.4;
  }
  .pdp-comp-col--active {
    background: #f0f7ff;
  }

  /* ===========================
   BADGE
   =========================== */
  .pdp-badge {
    display: inline-block;
    background: #e40b0b;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 4px;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  /* ===========================
   RATING
   =========================== */
  .pdp-rating {
    margin-bottom: 1rem;
    line-height: 1;
  }
  .pdp-rating .jdgm-preview-badge,
  .pdp-rating .jdgm-prev-badge {
    display: flex !important;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
  }
  .pdp-rating .jdgm-prev-badge__stars {
    display: inline-flex !important;
    align-items: center;
    gap: 2px;
    line-height: 1;
    flex-shrink: 0;
  }
  .pdp-rating .jdgm-star {
    display: inline-block;
    width: 18px;
    height: 18px;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1;
    vertical-align: middle;
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain !important;
  }
  .pdp-rating .jdgm-star:last-of-type {
    padding-right: 0 !important;
  }
  .pdp-rating .jdgm-prev-badge__text {
