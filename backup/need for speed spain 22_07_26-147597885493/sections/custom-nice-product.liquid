{% comment %}
  Main Product Section - Optimized with Blocks
  Features: Variant gallery, variant description, metafield accordion,
  size guide, comparison table, flexible block layout.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign preselected_variant = section.settings.preselected_variant | strip

  if product.selected_variant == blank and preselected_variant != blank
    for variant in product.variants
      assign variant_id = variant.id | append: ''
      if variant_id == preselected_variant or variant.title == preselected_variant
        assign current_variant = variant
        break
      endif
    endfor
  endif
%}
{% assign current_variant_in_stock = current_variant.available %}
{% if current_variant.inventory_quantity > 0 or current_variant.inventory_policy == 'continue' %}
  {% assign current_variant_in_stock = true %}
{% endif %}
<style>
    /* Critical PDP CSS: keep above first product markup. */
    /* ===========================
     LAYOUT: 2-Column Desktop
     =========================== */
    .pdp-layout__inner {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .pdp-layout__left,
    .pdp-layout__right {
      width: 100%;
    }
    @media (min-width: 992px) {
      .pdp-layout__inner {
        flex-direction: row;
        align-items: flex-start;
        overflow-x: visible;
        overflow-y: visible;
      }
      .pdp-layout__left {
        flex: 0 0 50%;
        max-width: 50%;
        min-width: 0;
      }
      .pdp-layout__right {
        flex: 0 0 50%;
        max-width: 50%;
        min-width: 0;
        box-sizing: border-box;
        max-height: none;
        overflow-x: visible;
        overflow-y: visible;
        padding-left: 2rem;
        padding-right: 0.25rem;
      }
      .pdp-layout__right::-webkit-scrollbar {
        display: initial;
      }
    }
    @media (min-width: 769px) and (max-width: 1199px) {
      .pdp-layout__inner {
        gap: 1.25rem;
      }
      .pdp-layout__right {
        padding-left: 1rem;
        max-height: none;
        overflow-y: visible;
      }
    }
    @media (min-width: 992px) and (max-width: 1199px) {
      .pdp-layout__left {
        flex-basis: 52%;
        max-width: 52%;
      }
      .pdp-layout__right {
        flex-basis: 48%;
        max-width: 48%;
        box-sizing: border-box;
      }
    }

    /* ===========================
     TITLE
     =========================== */
    .pdp-title {
      font-size: 5.5rem;
      font-weight: 700;
      color: #153a5b;
      line-height: 1.2;
      margin: 0 0 0.75rem;
      {% comment %} min-height: 19.8rem; {% endcomment %}
    }

    /* ===========================
     PRICE
     =========================== */
    .pdp-price {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px 14px;
      margin: 1.5rem 0;
    }
    .pdp-price__values {
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
      min-width: 0;
    }
    .pdp-price__current {
      font-size: 1.75rem;
      font-weight: 700;
      color: #153a5b;
    }
    .pdp-price__compare {
      font-size: 2.8rem;
      color: #9ca3af;
    }
    .pdp-price__tax {
      font-size: 14px;
      color: #000;
    }
    .pdp-inventory {
      margin-top: 4px;
      padding: 4px 7px;
      display: inline-block;
      border-radius: 4px;
    }
    .pdp-inventory__status {
      font-size: 18px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .pdp-inventory__status::before {
      content: '';
      width: 12px;
      height: 12px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
      animation: pdp-blink 1.2s infinite ease-in-out;
    }
    .pdp-inventory--available {
      color: #15803d;
    }
    .pdp-inventory--available::before {
      background-color: #15803d;
    }
    .pdp-inventory--unavailable {
      color: #dc2626;
    }
    .pdp-inventory--unavailable::before {
      background-color: #dc2626;
    }
    @media (max-width: 768px) {
      .pdp-price {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: 12px;
        row-gap: 8px;
        width: 100%;
        margin: 1.2rem 0;
      }
      .pdp-price__values {
        gap: 4px 10px;
        min-width: 0;
      }
      .pdp-price__current {
        font-size: 27px;
        line-height: 1;
        font-weight: 700;
        color: #153a5b;
      }
      .pdp-price__compare {
        font-size: 27px;
        line-height: 1;
        color: #70757a;
      }
      .pdp-price__tax {
        font-size: 16px;
        line-height: 1;
        font-weight: 700;
        color: #242329;
      }
      .pdp-inventory {
        margin-top: 0;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-self: end;
        border-radius: 0;
      }
      .pdp-inventory__status {
        font-size: 16px;
        line-height: 1;
        font-weight: 700;
        gap: 9px;
      }
      .pdp-inventory__status::before {
        width: 11px;
        height: 11px;
      }
    }
    @keyframes pdp-blink {
      0% {
        opacity: 1;
      }
      50% {
        opacity: 0.3;
      }
      100% {
        opacity: 1;
      }
    }
    {% comment %} .pdp-sale-badge {
      display: inline-block;
      background: #e40b0b;
      color: #242329;
      font-size: 14px;
      font-weight: bold;
      padding: 8px 16px;
      margin-top: 8px;
    } {% endcomment %}

    /* ===========================
     GALLERY: MediaGallery-compatible layout
     =========================== */
    .pdp-gallery,
    .pdp-media-gallery {
      position: relative;
      width: 100%;
    }
    .pdp-media-gallery slider-component {
      display: block;
      position: relative;
    }
    .pdp-media-gallery .product__media-list {
      display: block;
      list-style: none;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: #f7f7f7;
      border-radius: 8px;
      aspect-ratio: 1 / 1;
    }
    .pdp-media-gallery .product__media-item {
      display: none;
      width: 100%;
      height: 100%;
    }
    .pdp-media-gallery .product__media-item.is-active {
      display: block;
    }
    .pdp-media-item {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      line-height: 0;
    }
    .pdp-media-item img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .product-gallery-arrows {
      display: contents;
    }
    .gallery-arrow {
      position: absolute;
      top: 25%;
      outline: none;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: rgba(245, 243, 241, 0.4);
      border: 0;
      border-radius: 0;
      width: 4.5rem;
      height: 4.5rem;
      transition: background 0.2s ease;
      cursor: pointer;
      color: #242329;
      font-size: 2rem;
      line-height: 1;
      transform: translateY(-50%);
      pointer-events: auto;
    }
    .gallery-arrow:hover {
      background-color: #f5f3f1;
    }
    .gallery-arrow--prev {
      left: 20px;
    }
    .gallery-arrow--next {
      right: 20px;
    }
   button.gallery-arrow.gallery-arrow--prev, button.gallery-arrow.gallery-arrow--next {
      padding: 2.2rem 2.2rem;
  }
    .thumbnail-grid-2x6 {
      display: none;
    }
    .product-media-mobile-dots {
      display: none;
    }
    .product-media-mobile-dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(47, 41, 83, 0.28);
      cursor: pointer;
      transition: background 160ms ease, transform 160ms ease;
    }
    .product-media-mobile-dot.is-active {
      background: #2f2953;
      transform: scale(1.25);
    }
    @media (min-width: 769px) {
      .thumbnail-grid-2x6 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        width: 100%;
        max-width: 100%;
        margin: 1.2rem auto 0;
        padding: 0;
        overflow: hidden;
      }
      .thumbnail-2x6-item {
        display: none;
        position: relative;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 0.8rem;
        border: 1px solid rgba(21, 58, 91, 0.16);
        box-sizing: border-box;
        cursor: pointer;
        margin: 0;
        padding: 0;
        background: #fff;
        line-height: 0;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .thumbnail-grid-2x6:not([data-thumbnail-page-ready='true']) .thumbnail-2x6-item:nth-child(-n + 4),
      .thumbnail-grid-2x6[data-thumbnail-page-ready='true'] .thumbnail-2x6-item.is-thumbnail-page-visible {
        display: block;
      }
      .thumbnail-2x6-item img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        pointer-events: none;
      }
      .thumbnail-2x6-item:hover,
      .thumbnail-2x6-item.is-active {
        border-color: #153a5b;
        box-shadow: 0 0 0 1px rgba(21, 58, 91, 0.18);
      }
    }
    @media (max-width: 768px) {
      .product-gallery-arrows {
        display: contents;
      }
      .gallery-arrow {
        width: 3.8rem;
        height: 3.8rem;
        border-radius: 0;
        background-color: rgba(245, 243, 241, 0.72);
        z-index: 3;
        top: 50%;
      }
      .gallery-arrow--prev {
        left: 10px;
      }
      .gallery-arrow--next {
        right: 10px;
      }
      .product-media-mobile-dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 24px;
        margin: 10px 0 0;
      }
      .pdp-title {
        font-size: 1.6rem;
        min-height: 5.76rem;
      }
    }
</style>

<script>
  (function () {
    if (window.location.hash) return;
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    function scrollProductPageTop() {
      window.scrollTo(0, 0);
    }

    window.addEventListener('pageshow', scrollProductPageTop);
    window.addEventListener('load', function () {
      requestAnimationFrame(scrollProductPageTop);
    });
  })();
</script>

{% comment %} === VARIANT GALLERY: Check for variant-specific images === {% endcomment %}
{% assign variant_file_images = current_variant.metafields.custom.variant_images.value %}
{% assign use_variant_file_images = false %}
{% if variant_file_images != blank %}
  {% assign use_variant_file_images = true %}
{% endif %}

{% comment %} === VARIANT DESCRIPTION: Check for variant-specific description === {% endcomment %}
{% assign variant_description = current_variant.metafields.custom.variant_level_description %}

{% comment %} === SIZE GUIDE: Determine if size guide should show === {% endcomment %}
{% assign show_size_guide = false %}
{% assign size_guide_handles = section.settings.size_guide_product_handles | strip | newline_to_br | split: '<br />' %}
{% if size_guide_handles.size > 0 and size_guide_handles[0] != blank %}
  {% for handle in size_guide_handles %}
    {% assign trimmed_handle = handle | strip %}
    {% if trimmed_handle == product.handle %}
      {% assign show_size_guide = true %}
    {% endif %}
  {% endfor %}
{% else %}
  {% comment %} Auto-detect: show for products with 'stand' or 'support' option {% endcomment %}
  {% for option in product.options_with_values %}
    {% assign opt_name_lower = option.name | downcase %}
    {% if opt_name_lower contains 'stand' or opt_name_lower contains 'support' %}
      {% assign show_size_guide = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if settings.enable_minmax_buys %}
  {% assign min_buy = settings.min_buy_qty %}
  {% assign max_buy = settings.max_buy_qty %}
{% endif %}
{% if min_buy == null %}
  {% assign min_buy = 1 %}
{% endif %}

{% comment %} === HIDE VARIANT MEDIA === {% endcomment %}
{% assign active_media_id = current_variant.featured_media.id | default: product.featured_media.id %}

<div
  class="pdp-layout"
  data-custom-nice-product-section
  data-section-id="{{ section.id }}"
  data-section-type="custom-nice-product"
>
  <div class="pdp-layout__inner container">
    {% comment %} === LEFT COLUMN: Images + Comparison === {% endcomment %}
    <div class="pdp-layout__left">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'image_gallery' %}
            <div class="pdp-gallery" {{ block.shopify_attributes }}>
              {% assign rendered_media_count = 0 %}
              {% assign active_media_in_gallery = false %}
              {% unless use_variant_file_images %}
                {% for media in product.media %}
                  {% assign skip_active_media = false %}
                  {% if block.settings.hide_variants %}
                    {% if media.attached_to_variant? %}
                      {% assign skip_active_media = true %}
                    {% endif %}
                  {% endif %}
                  {% unless skip_active_media %}
                    {% if active_media_id != blank and media.id == active_media_id %}
                      {% assign active_media_in_gallery = true %}
                    {% endif %}
                  {% endunless %}
                {% endfor %}
              {% endunless %}
              {% capture gallery_slides %}
                {% if use_variant_file_images %}
                  {% for image in variant_file_images %}
                    {% assign rendered_media_count = rendered_media_count | plus: 1 %}
                    {% assign media_id = section.id | append: '-variant-' | append: current_variant.id | append: '-file-' | append: forloop.index %}
                    {% assign image_loading = 'lazy' %}
                    {% assign image_fetchpriority = 'low' %}
                    {% if forloop.first %}
                      {% assign image_loading = 'eager' %}
                      {% assign image_fetchpriority = 'high' %}
                    {% endif %}
                    <li
                      id="Slide-{{ media_id }}"
                      class="product__media-item grid__item slider__slide{% if forloop.first %} is-active{% endif %}"
                      data-media-id="{{ media_id }}"
                    >
                      <a data-fancybox="gallery" href="{{ image | image_url: width: 2560 }}" class="pdp-media-item" aria-label="{{ image.alt | default: product.title | escape }}">
                            {{
                              image
                              | image_url: width: 764
                              | image_tag:
                                loading: image_loading,
                                fetchpriority: image_fetchpriority,
                                decoding: 'async',
                                width: 600,
                                height: 600,
                                sizes: '(max-width: 749px) calc(100vw - 30px), 600px',
                                widths: '382, 600, 764, 832, 1200, 1600, 1946',
                                alt: image.alt
                            }}
                      </a>
                    </li>
                  {% endfor %}
                {% else %}
                  {% for media in product.media %}
                    {% assign skip_media = false %}
                    {% if block.settings.hide_variants %}
                      {% if media.attached_to_variant? %}
                        {% assign skip_media = true %}
                      {% endif %}
                    {% endif %}
                    {% unless skip_media %}
                      {% assign rendered_media_count = rendered_media_count | plus: 1 %}
                      {% assign is_initial_active_media = false %}
                      {% if active_media_in_gallery and media.id == active_media_id %}
                        {% assign is_initial_active_media = true %}
                      {% elsif active_media_in_gallery == false and rendered_media_count == 1 %}
                        {% assign is_initial_active_media = true %}
                      {% endif %}
                      {% assign image_loading = 'lazy' %}
                      {% assign image_fetchpriority = 'low' %}
                      {% if is_initial_active_media %}
                        {% assign image_loading = 'eager' %}
                        {% assign image_fetchpriority = 'high' %}
                      {% endif %}
                      <li
                        id="Slide-{{ section.id }}-{{ media.id }}"
                        class="product__media-item grid__item slider__slide{% if is_initial_active_media %} is-active{% endif %}{% if media.media_type != 'image' %} product__media-item--full{% endif %}"
                        data-media-id="{{ section.id }}-{{ media.id }}"
                      >
                        {% if media.media_type == 'image' %}
                          <a data-fancybox="gallery" href="{{ media | image_url: width: 2560 }}" class="pdp-media-item" aria-label="{{ media.alt | default: product.title | escape }}">
                            {{
                              media
                              | image_url: width: 764
                              | image_tag:
                                loading: image_loading,
                                fetchpriority: image_fetchpriority,
                                decoding: 'async',
                                width: 600,
                                height: 600,
                                sizes: '(max-width: 749px) calc(100vw - 30px), 600px',
                                widths: '382, 600, 764, 832, 1200, 1600, 1946',
                                alt: media.alt
                            }}
                          </a>
                        {% elsif media.media_type == 'external_video' %}
                          <a
                            data-fancybox="gallery"
                            href="{{ media | external_video_url: autoplay: 'true' }}"
                            class="pdp-media-item pdp-media-item--video"
                            aria-label="{{ media.alt | default: product.title | escape }}"
                          >
                            {{ media.preview_image | image_url: width: 1946 | image_tag: loading: image_loading, fetchpriority: image_fetchpriority, width: 1946, height: 1946, alt: media.alt }}
                          </a>
                        {% elsif media.media_type == 'video' %}
                          <a
                            data-fancybox="gallery"
                            href="{{ media.sources[1].url }}"
                            class="pdp-media-item pdp-media-item--video"
                            aria-label="{{ media.alt | default: product.title | escape }}"
                          >
                            {{ media.preview_image | image_url: width: 1946 | image_tag: loading: image_loading, fetchpriority: image_fetchpriority, width: 1946, height: 1946, alt: media.alt }}
                          </a>
                        {% endif %}
                      </li>
                    {% endunless %}
                  {% endfor %}
                {% endif %}
              {% endcapture %}

              {% capture gallery_thumbnails %}
                {% if use_variant_file_images %}
                  {% for image in variant_file_images %}
                    {% assign media_id = section.id | append: '-variant-' | append: current_variant.id | append: '-file-' | append: forloop.index %}
                    <button
                      class="thumbnail-2x6-item{% if forloop.first %} is-active{% endif %}"
                      data-media-id="{{ media_id }}"
                      aria-label="Image {{ forloop.index }}"
                      type="button"
                      {% if forloop.first %}aria-current="true"{% endif %}
                    >
                      {{ image | image_url: width: 416 | image_tag: loading: 'lazy', decoding: 'async', width: 416, height: 416, widths: '60, 90, 120, 160, 240, 416', alt: image.alt }}
                    </button>
                  {% endfor %}
                {% else %}
                  {% assign thumb_index = 0 %}
                  {% for media in product.media %}
                    {% assign skip_thumb = false %}
                    {% if block.settings.hide_variants %}
                      {% if media.attached_to_variant? %}
                        {% assign skip_thumb = true %}
                      {% endif %}
                    {% endif %}
                    {% unless skip_thumb %}
                      {% assign thumb_index = thumb_index | plus: 1 %}
                      {% assign is_initial_active_thumb = false %}
                      {% if active_media_in_gallery and media.id == active_media_id %}
                        {% assign is_initial_active_thumb = true %}
                      {% elsif active_media_in_gallery == false and thumb_index == 1 %}
                        {% assign is_initial_active_thumb = true %}
                      {% endif %}
                      <button
                        class="thumbnail-2x6-item{% if is_initial_active_thumb %} is-active{% endif %}"
                        data-media-id="{{ section.id }}-{{ media.id }}"
                        aria-label="Image {{ thumb_index }}"
                        type="button"
                        {% if is_initial_active_thumb %}aria-current="true"{% endif %}
                      >
                        {{ media.preview_image | image_url: width: 416 | image_tag: loading: 'lazy', decoding: 'async', width: 416, height: 416, widths: '60, 90, 120, 160, 240, 416', alt: media.alt }}
                      </button>
                    {% endunless %}
                  {% endfor %}
                {% endif %}
              {% endcapture %}

              {% if rendered_media_count > 0 %}
                <media-gallery
                  id="MediaGallery-{{ section.id }}"
                  role="region"
                  class="pdp-media-gallery product__column-sticky"
                  aria-label="Gallery Viewer"
                  data-desktop-layout="thumbnail_slider"
                  {% if use_variant_file_images %}
                    data-variant-file-gallery
                  {% endif %}
                >
                  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
                  <slider-component id="GalleryViewer-{{ section.id }}" class="slider-mobile-gutter">
                    <ul
                      id="Slider-Gallery-{{ section.id }}"
                      class="product__media-list contains-media grid grid--peek list-unstyled slider slider--mobile"
                      role="list"
                    >
                      {{ gallery_slides }}
                    </ul>
                    {% if rendered_media_count > 1 %}
                      <div class="product-gallery-arrows">
                        <button type="button" class="gallery-arrow gallery-arrow--prev" aria-label="Previous image">
                          <span aria-hidden="true">&#8249;</span>
                        </button>
                        <button type="button" class="gallery-arrow gallery-arrow--next" aria-label="Next image">
                          <span aria-hidden="true">&#8250;</span>
                        </button>
                      </div>
                      <div class="product-media-mobile-dots" data-gallery-dots aria-label="Image pagination">
                        {% for dot_index in (1..rendered_media_count) %}
                          <button
                            type="button"
                            class="product-media-mobile-dot{% if forloop.first %} is-active{% endif %}"
                            data-gallery-dot="{{ forloop.index0 }}"
                            aria-label="Go to image {{ forloop.index }}"
                            {% if forloop.first %}
                              aria-current="true"
                            {% endif %}
                          ></button>
                        {% endfor %}
                      </div>
                      <div id="GalleryThumbnails2x6-{{ section.id }}" class="thumbnail-grid-2x6">
                        {{ gallery_thumbnails }}
                      </div>
                    {% endif %}
                  </slider-component>
                </media-gallery>
              {% elsif product.featured_image %}
                <a
                  data-fancybox="gallery"
                  href="{{ product.featured_image | image_url: width: 2560 }}"
                  class="pdp-media-item"
                  aria-label="{{ product.featured_image.alt | default: product.title | escape }}"
                >
                  {{
                    product.featured_image
                    | image_url: width: 1946
                    | image_tag:
                      loading: 'eager',
                      fetchpriority: 'high',
                      decoding: 'async',
                      width: 1946,
                      height: 1946,
                      widths: '382, 600, 764, 832, 1200, 1600, 1946',
                      alt: product.featured_image.alt
                  }}
                </a>
              {% else %}
                <div class="placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
          {% when 'comparison_table' %}
            <div class="pdp-comparison" {{ block.shopify_attributes }}>
              <table class="pdp-comparison-table">
                <thead>
                  <tr>
                    <th class="pdp-comp-feature-header">Fonctionnalit?</th>
                    <th class="pdp-comp-col-header pdp-comp-col--active">
                      {% if block.settings.col1_image -%}
                        <img
                          src="{{ block.settings.col1_image | image_url: width: 200 }}"
                          alt="{{ block.settings.col1_title }}"
                          width="80"
                          height="80"
                          loading="lazy"
                        >
                      {%- endif %}
                      <span>{{ block.settings.col1_title }}</span>
                    </th>
                    <th class="pdp-comp-col-header">
                      {% if block.settings.col2_image -%}
                        <img
                          src="{{ block.settings.col2_image | image_url: width: 200 }}"
                          alt="{{ block.settings.col2_title }}"
                          width="80"
                          height="80"
                          loading="lazy"
                        >
                      {%- endif %}
                      <span>{{ block.settings.col2_title }}</span>
                    </th>
                    <th class="pdp-comp-col-header">
                      {% if block.settings.col3_image -%}
                        <img
                          src="{{ block.settings.col3_image | image_url: width: 200 }}"
                          alt="{{ block.settings.col3_title }}"
                          width="80"
                          height="80"
                          loading="lazy"
                        >
                      {%- endif %}
                      <span>{{ block.settings.col3_title }}</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {% for i in (1..8) %}
                    {% assign feature_key = 'feature_' | append: i %}
                    {% assign c1_key = 'col1_row_' | append: i %}
                    {% assign c2_key = 'col2_row_' | append: i %}
                    {% assign c3_key = 'col3_row_' | append: i %}
                    {% assign feature_val = block.settings[feature_key] %}
                    {% if feature_val != blank %}
                      <tr>
                        <td class="pdp-comp-feature">{{ feature_val }}</td>
                        <td class="pdp-comp-cell {% if forloop.first %}pdp-comp-col--active{% endif %}">
                          {{ block.settings[c1_key] }}
                        </td>
                        <td class="pdp-comp-cell">{{ block.settings[c2_key] }}</td>
                        <td class="pdp-comp-cell">{{ block.settings[c3_key] }}</td>
                      </tr>
                    {% endif %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    {% comment %} === RIGHT COLUMN: Product Info === {% endcomment %}
    <div class="pdp-layout__right">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'countdown' %}
            <div {{ block.shopify_attributes }}>
              {% render 'product-hero-countdown', section: section %}
            </div>

          {% when 'badge' %}
            <div class="pdp-badge" {{ block.shopify_attributes }}>
              {{ block.settings.badge_text }}
            </div>

          {% when 'title' %}
            <h1 class="pdp-title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {% when 'rating' %}
            <div class="pdp-rating" {{ block.shopify_attributes }}>
              <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-install="false">
                {{ product.metafields.judgeme.badge }}
              </div>
            </div>

          {% when 'description' %}
            <div class="pdp-description" {{ block.shopify_attributes }}>
              {% if variant_description != blank %}
                {{ variant_description | metafield_tag }}
              {% elsif product.description != blank %}
                {{ product.description }}
              {% endif %}

              {% if product.metafields.custom.product_usps.value.size > 0 %}
                <ul class="pdp-usps">
                  {% for usp in product.metafields.custom.product_usps.value %}
                    <li>{{ usp }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>

          {% when 'variant_picker' %}
            {% if product.variants.size > 1 %}
              <div id="product-variants" class="pdp-variant-picker" {{ block.shopify_attributes }}>
                {% for option in product.options_with_values %}
                  {% liquid
                    assign option_index = option.position | minus: 1
                    assign selected_value = current_variant.options[option_index]
                    assign option_name = option.name | downcase
                    assign option_kind = 'generic'
                    if option_name contains 'size' or option_name contains 'taille'
                      assign option_kind = 'size'
                    elsif option_name contains 'filter' or option_name contains 'cartouches' or option_name contains 'cartucce' or option_name contains 'cartuchos'
                      assign option_kind = 'filter'
                    elsif option_name contains 'stand' or option_name contains 'support' or option_name contains 'supporto' or option_name contains 'soporte'
                      assign option_kind = 'stand'
                    endif
                  %}
                  <fieldset
                    class="variant-step"
                    data-kind="{{ option_kind }}"
                    data-option-index="{{ option_index }}"
                  >
                    <legend class="step-header">
                      <span class="step-number">{{ option.position }}</span>
                      <span class="step-title">
                        <b>{{ option.name | remove: ':' | escape }}</b>
                        <span class="selected-value">
                          - <span data-selected>{{ selected_value }}</span>
                        </span>
                      </span>
                      {% if option_kind == 'stand' and show_size_guide %}
                        <button type="button" class="size-guide-btn" onclick="openStandGuide()">
                          GUÍA DE TALLAS
                        </button>
                      {% endif %}
                    </legend>

                    <div class="variant-options-grid" data-option-position="{{ option_index }}">
                      {% for value in option.values %}
                        {% liquid
                          assign option_image = blank
                          assign fallback_image_url = blank
                          assign primary = value
                          assign secondary = blank

                          if option_kind == 'filter'
                            assign image_key = 'filter_image_' | append: forloop.index
                            assign option_image = settings[image_key]
                            if forloop.index == 1
                              assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0656/9898/8085/files/carbon-fr.png?v=1767765891&width=90'
                            elsif forloop.index == 2
                              assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0656/9898/8085/files/carbon_with_postreat-fr.png?v=1767765891&width=90'
                            endif
                          elsif option_kind == 'size'
                            assign image_key = 'size_icon_' | append: forloop.index
                            assign primary_key = 'size_for_' | append: forloop.index
                            assign secondary_key = 'size_content_' | append: forloop.index
                            assign option_image = settings[image_key]
                            assign primary = settings[primary_key] | default: value
                            assign secondary = settings[secondary_key]
                            case forloop.index
                              when 1
                                assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/family-1.svg?v=1760638763'
                              when 2
                                assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/family-3.svg?v=1760638762'
                              when 3
                                assign fallback_image_url = 'https://phoenixwaterfilters.com/cdn/shop/files/family-5.svg?v=1713147857'
                            endcase
                          elsif option_kind == 'stand'
                            assign image_key = 'stand_' | append: forloop.index
                            assign option_image = settings[image_key]
                            case forloop.index
                              when 1
                                assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0656/9898/8085/files/pas_de_support_3.png?v=1762956199&width=90'
                              when 2
                                assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/stand_ss.avif?v=1760639415&width=90'
                              when 3
                                assign fallback_image_url = 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/stand_wooden.avif?v=1760639282'
                            endcase
                          endif

                          assign input_id = 'NiceOption-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                        %}
                        <label class="variant-option-card" for="{{ input_id }}">
                          <input
                            id="{{ input_id }}"
                            type="radio"
                            class="variant-radio-input"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-position="{{ option_index }}"
                            {% if selected_value == value %}
                              checked
                            {% endif %}
                          >
                          <span class="variant-option-label">
                            {% if option_image != blank %}
                              <span class="option-image">
                                {{
                                  option_image
                                  | image_url: width: 180
                                  | image_tag:
                                    loading: 'lazy',
                                    width: 180,
                                    height: 180,
                                    widths: '80, 120, 180',
                                    alt: value
                                }}
                              </span>
                            {% elsif fallback_image_url != blank %}
                              <span class="option-image">
                                <img
                                  src="{{ fallback_image_url }}"
                                  alt="{{ value | escape }}"
                                  width="90"
                                  height="90"
                                  loading="lazy"
                                >
                              </span>
                            {% endif %}
                            <span class="option-copy">
                              <b>{{ primary }}</b>
                              {% if secondary != blank %}
                                <span>{{ secondary }}</span>
                              {% elsif primary != value %}
                                <span>{{ value }}</span>
                              {% endif %}
                            </span>
                          </span>
                        </label>
                      {% endfor %}
                    </div>
                  </fieldset>
                {% endfor %}
              </div>
            {% endif %}
          {% when 'price' %}
            <div class="pdp-price" {{ block.shopify_attributes }}>
              <span class="pdp-price__values">
                <span data-price class="pdp-price__current">
                  {{ current_variant.price | money }}
                </span>
                <span data-compare class="pdp-price__compare">
                  {% if current_variant.compare_at_price and current_variant.compare_at_price > current_variant.price %}
                    <s>{{ current_variant.compare_at_price | money }}</s>
                  {% endif %}
                </span>
                <span class="pdp-price__tax">(TTC)</span>
              </span>
              <div id="inventory-indicator" class="pdp-inventory">
                {% if current_variant_in_stock %}
                  <span class="pdp-inventory__status pdp-inventory--available">En stock</span>
                {% else %}
                  <span class="pdp-inventory__status pdp-inventory--unavailable">Agotado</span>
                {% endif %}
              </div>
              {% comment %} <div class="pdp-sale-badge">Vente</div> {% endcomment %}
            </div>

          {% when 'variant_metafield_tab' %}
            {% assign mf_namespace = block.settings.metafield_namespace | strip %}
            {% assign mf_key = block.settings.metafield_key | strip %}
            {% assign variant_mf = current_variant.metafields[mf_namespace][mf_key] %}
            {% unless block.settings.hide_if_empty and variant_mf == blank %}
              <div class="pdp-accordion" {{ block.shopify_attributes }}>
                <details class="pdp-accordion__item">
                  <summary class="pdp-accordion__trigger">
                    {% if block.settings.icon != blank %}
                      <span class="pdp-accordion__icon">{{ block.settings.icon }}</span>
                    {% endif %}
                    <span>{{ block.settings.heading }}</span>
                    <span class="pdp-accordion__chevron">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </summary>
                  <div class="pdp-accordion__content">
                    {% if variant_mf != blank %}
                      {{ variant_mf | metafield_tag }}
                    {% else %}
                      <p class="pdp-accordion__empty">No information available for this variant.</p>
                    {% endif %}
                  </div>
                </details>
              </div>
            {% endunless %}

          {% when 'add_to_cart' %}
            <form
              action="{{ routes.cart_add_url }}"
              method="post"
              enctype="multipart/form-data"
              id="add-to-cart"
              data-min="{{ min_buy }}"
              data-max="{{ max_buy }}"
              class="pdp-atc-form disable-ajax"
              {{ block.shopify_attributes }}
            >
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when '@app' %}
                    {% render block %}
                {% endcase %}
              {% endfor %}

              <input type="hidden" name="handle" value="{{ product.handle }}">

              <div id="variants" class="sr-only">
                <select
                  id="product-selectors"
                  name="id"
                  aria-label="Product variant"
                  data-productid="{{ product.id }}"
                  data-label="{% if product.options.size == 1 %}{{ product.options[0] }}{% endif %}"
                >
                  {% for variant in product.variants %}
                    {% if variant.available
                      or variant.inventory_quantity > 0
                      or variant.inventory_policy == 'continue'
                    %}
                      <option
                        {% if variant == current_variant %}
                          selected="selected"
                        {% endif %}
                        value="{{ variant.id }}"
                        data-price="{{ variant.price | money_with_currency }}"
                        name="id"
                        id="variant_{{ variant.id }}"
                      >
                        {{ variant.title }}
                      </option>
                    {% else %}
                      <option
                        {% if variant == current_variant %}
                          selected="selected"
                        {% endif %}
                        disabled="disabled"
                        value="{{ variant.id }}"
                        data-price="{{ variant.price | money_with_currency }}"
                        name="id"
                        id="variant_{{ variant.id }}"
                      >
                        {{ variant.title }} - {{ 'products.product.inventory_out_of_stock' | t }}
                      </option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>

              <button
                class="pdp-atc-btn {% if current_variant_in_stock %}pdp-atc-btn--primary{% else %}pdp-atc-btn--disabled{% endif %}"
                type="submit"
                name="add"
                id="product-add-to-cart"
                data-available-text="{{ 'products.product.add_to_cart' | t }}"
                data-preorder-text="{{ 'products.product.pre_order' | t }}"
                {% unless current_variant_in_stock %}
                  disabled
                {% endunless %}
              >
                {% if current_variant_in_stock %}
                  {{ 'products.product.add_to_cart' | t }}
                {% else %}
                  Agotado
                {% endif %}
              </button>

              <div id="standPopup" class="stand-popup">
                <div class="stand-popup-content">
                  <div class="stand-popup-header">
                    <h2 id="standPopupTitle">Stand Guide</h2>
                  </div>
                  <div class="stand-popup-body">
                    <img
                      src="https://cdn.shopify.com/s/files/1/0656/9898/8085/files/6-Sizes_Guide.jpg?v=1782120442&width=800"
                      srcset="
                        https://cdn.shopify.com/s/files/1/0656/9898/8085/files/6-Sizes_Guide.jpg?v=1782120442&width=400 400w,
                        https://cdn.shopify.com/s/files/1/0656/9898/8085/files/6-Sizes_Guide.jpg?v=1782120442&width=600 600w,
                        https://cdn.shopify.com/s/files/1/0656/9898/8085/files/6-Sizes_Guide.jpg?v=1782120442&width=800 800w,
                        https://cdn.shopify.com/s/files/1/0656/9898/8085/files/6-Sizes_Guide.jpg?v=1782120442&width=1000 1000w
                      "
                      sizes="(max-width: 540px) calc(100vw - 88px), 452px"
                      alt="Stand Guide"
                      class="stand-popup-image"
                      id="standPopupImage"
                      loading="lazy"
                      width="500"
                      height="500"
                    >
                  </div>
                </div>
              </div>
            </form>

            {% render 'sticky-add-to-cart' %}

          {% when 'payment_icons' %}
            <div class="pdp-payments" {{ block.shopify_attributes }}>
              <img
                src="https://cdn.shopify.com/s/files/1/0656/9898/8085/files/France_Payment_Below_CTA_copy.webp?v=1777899592"
                alt="payment"
                height="21"
                width="280"
                loading="lazy"
              >
            </div>

          {% when 'trust_badges' %}
            <div
              class="pdp-trust-badges"
              style="--pdp-trust-color: {{ block.settings.text_color }}; --pdp-trust-icon-size: {{ block.settings.icon_size }}px;"
              {{ block.shopify_attributes }}
            >
              {% for badge_index in (1..6) %}
                {% assign badge_text_key = 'badge_' | append: badge_index | append: '_text' %}
                {% assign badge_icon_key = 'badge_' | append: badge_index | append: '_icon' %}
                {% assign badge_text = block.settings[badge_text_key] %}
                {% assign badge_icon = block.settings[badge_icon_key] %}
                {% case badge_index %}
                  {% when 1 %}
                    {% assign fallback_icon = 'icon-truck.png' | asset_url %}
                  {% when 2 %}
                    {% assign fallback_icon = 'icon-tag.png' | asset_url %}
                  {% when 3 %}
                    {% assign fallback_icon = 'icon-award.png' | asset_url %}
                  {% when 4 %}
                    {% assign fallback_icon = 'icon-headset.png' | asset_url %}
                  {% when 5 %}
                    {% assign fallback_icon = 'https://cdn.shopify.com/s/files/1/2644/2852/files/product_warehouse.png' %}
                  {% when 6 %}
                    {% assign fallback_icon = 'https://cdn.shopify.com/s/files/1/2644/2852/files/nsf-01.png?v=1751276325&width=68' %}
                {% endcase %}
                {% if badge_text != blank %}
                  <div class="pdp-trust-item">
                    {% if badge_icon != blank %}
                      {{
                        badge_icon
                        | image_url: width: 80
                        | image_tag: alt: '', loading: 'lazy', width: 80, height: 80, widths: '34, 68, 80'
                      }}
                    {% elsif badge_index == 5 %}
                      <img
                        src="https://cdn.shopify.com/s/files/1/2644/2852/files/product_warehouse.png?width=48"
                        srcset="
                          https://cdn.shopify.com/s/files/1/2644/2852/files/product_warehouse.png?width=48 48w,
                          https://cdn.shopify.com/s/files/1/2644/2852/files/product_warehouse.png?width=96 96w
                        "
                        sizes="{{ block.settings.icon_size }}px"
                        alt=""
                        width="34"
                        height="34"
                        loading="lazy"
                      >
                    {% else %}
                      <img src="{{ fallback_icon }}" alt="" width="34" height="34" loading="lazy">
                    {% endif %}
                    <span>{{ badge_text }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% unless product == empty %}
  <script>
    window.product = {
      "id": {{ product.id }},
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "badge": {{ product.metafields.custom.product_badge_text.value | json }},
      "metafields": {
        "min_buy": {{ product.metafields.custom.min_buy_quantity.value | default: 1 }},
        "max_buy": {{ product.metafields.custom.max_buy_quantity.value | default: 999999 }}
      },
      "variants": [{% for variant in product.variants %}{
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "available": {{ variant.available }},
        "price": {{ variant.price }},
        "compare_at_price": {{ variant.compare_at_price | json }},
        "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
        "inventory_management": {{ variant.inventory_management | json }},
        "inventory_policy": {{ variant.inventory_policy | json }},
        "featured_media_id": {{ variant.featured_media.id | json }},
        "option1": {{ variant.option1 | json }},
        "option2": {{ variant.option2 | json }},
        "option3": {{ variant.option3 | json }}
      }{% unless forloop.last %},{% endunless %}{% endfor %}],
      "options": [{% for option in product.options %}{
        "name": {{ option.name | json }},
        "values": {{ option.values | json }}
      }{% unless forloop.last %},{% endunless %}{% endfor %}]
    };
    window.productVariants = window.product.variants;
    window.customNiceVariantGalleries = {
      {% for variant in product.variants %}
        {% assign variant_gallery_images = variant.metafields.custom.variant_images.value %}
        "{{ variant.id }}": [
          {% if variant_gallery_images != blank %}
            {% for image in variant_gallery_images %}
              {
                "full": {{ image | image_url: width: 2560 | json }},
                "large": {{ image | image_url: width: 1946 | json }},
                "thumb": {{ image | image_url: width: 416 | json }},
                "width": {{ image.width | json }},
                "height": {{ image.height | json }},
                "alt": {{ image.alt | default: product.title | json }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          {% endif %}
        ]{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };
    window.customNiceProductMedia = [
      {% for media in product.media %}
        {% if media.media_type == 'image' %}
          {
            "id": {{ media.id | json }},
            "full": {{ media | image_url: width: 2560 | json }},
            "large": {{ media | image_url: width: 1946 | json }},
            "thumb": {{ media.preview_image | image_url: width: 416 | json }},
            "width": {{ media.preview_image.width | json }},
            "height": {{ media.preview_image.height | json }},
            "alt": {{ media.alt | default: product.title | json }}
          }
        {% elsif media.preview_image %}
          {
            "id": {{ media.id | json }},
            "full": {{ media.preview_image | image_url: width: 2560 | json }},
            "large": {{ media.preview_image | image_url: width: 1946 | json }},
            "thumb": {{ media.preview_image | image_url: width: 416 | json }},
            "width": {{ media.preview_image.width | json }},
            "height": {{ media.preview_image.height | json }},
            "alt": {{ media.alt | default: product.title | json }}
          }
        {% endif %}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];
    window.formatMoney = function(cents) {
      var amount = (cents / 100).toFixed(2).replace('.', ',');
      return '\u20AC ' + amount;
    };

    function runMetafieldsInit() {
      if (document.readyState !== 'loading') {
        updateMinMaxBuys();
      } else {
        document.addEventListener('DOMContentLoaded', updateMinMaxBuys);
      }
    }

    function updateMinMaxBuys() {
      if (window.product && window.product.metafields && window.product.metafields.min_buy) {
        var form = document.getElementById('add-to-cart');
        if (form) {
          form.setAttribute('data-min', window.product.metafields.min_buy);
          form.setAttribute('data-max', window.product.metafields.max_buy || 999999);
        }
      }
    }

    runMetafieldsInit();
    refreshCurrentVariantUI();

    function isVariantInStock(variant) {
      var inventory = Number(variant && variant.inventory_quantity);
      return variant && (variant.available === true || variant.available === 'true' || inventory > 0 || variant.inventory_policy === 'continue');
    }

    function refreshCurrentVariantUI() {
      var select = document.getElementById('product-selectors');
      if (!select) return;
      var currentId = select.value;
      if (!currentId) return;
      var variants = window.productVariants || window.product.variants || [];
      var current = variants.find(function(v) { return String(v.id) === String(currentId); });
      if (!current) return;
      var isAvailable = isVariantInStock(current);
      var isPreorder = current.inventory_policy === 'continue' && !isAvailable;
      var stockEl = document.getElementById('inventory-indicator');
      if (stockEl) {
        stockEl.innerHTML = isAvailable
          ? '<span class="pdp-inventory__status pdp-inventory--available">En stock</span>'
          : '<span class="pdp-inventory__status pdp-inventory--unavailable">Rupture de stock</span>';
      }
      var btn = document.getElementById('product-add-to-cart');
      if (btn) {
        btn.disabled = !isAvailable && !isPreorder;
        btn.classList.toggle('pdp-atc-btn--disabled', !isAvailable && !isPreorder);
        btn.classList.toggle('pdp-atc-btn--primary', isAvailable || isPreorder);
        if (isPreorder) {
          btn.textContent = btn.dataset.preorderText || 'Pre-order';
        } else {
          btn.textContent = isAvailable ? (btn.dataset.availableText || 'AÑADIR A LA CESTA') : 'Rupture de stock';
        }
      }
      var stickyBtn = document.querySelector('.sticky-add-to-cart button[name="add"]');
      if (stickyBtn) {
        stickyBtn.disabled = !isAvailable && !isPreorder;
      }
    }
    function initFastProductAddToCart() {
      if (window.__customNiceFastAddToCart) return;
      window.__customNiceFastAddToCart = true;

      function getRoute(path) {
        var root = window.Shopify && Shopify.routes && Shopify.routes.root ? Shopify.routes.root : '/';
        return root.replace(/\/$/, '/') + path.replace(/^\//, '');
      }

      function getSelectedVariantId() {
        var select = document.getElementById('product-selectors');
        return select && select.value ? select.value : '';
      }

      function ensureHiddenInput(form, name, value) {
        if (!value) return;
        var input = form.querySelector('input[name="' + name + '"]');
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          form.appendChild(input);
        }
        input.value = value;
      }

      function syncFormVariant(form) {
        var variantId = getSelectedVariantId();
        if (!variantId) return;
        var select = form.querySelector('select[name="id"]');
        if (select) select.value = variantId;
        ensureHiddenInput(form, 'id', variantId);
      }

      function setButtonState(button, text, disabled) {
        if (!button) return;
        if (!button.dataset.fastAtcOriginalText) {
          button.dataset.fastAtcOriginalText = (button.textContent || '').trim();
        }
        button.textContent = text;
        button.disabled = disabled;
      }

      function restoreButton(button) {
        if (!button) return;
        button.textContent = button.dataset.fastAtcOriginalText || button.dataset.availableText || 'AÑADIR A LA CESTA';
        button.disabled = false;
      }

      function updateCartCount(cart) {
        if (!cart || typeof cart.item_count === 'undefined') return;
        document.querySelectorAll('.cart-icon span, [data-cartcount]').forEach(function (el) {
          el.textContent = cart.item_count;
        });
      }

      function fetchCart() {
        return fetch(getRoute('cart.js'), {
          method: 'GET',
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' }
        }).then(function (response) {
          if (!response.ok) throw new Error('Unable to fetch cart');
          return response.json();
        });
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function formatCartMoney(cents) {
        if (window.Shopify && typeof Shopify.formatMoney === 'function') {
          return Shopify.formatMoney(cents);
        }
        return window.formatMoney ? window.formatMoney(cents) : ('? ' + (Number(cents || 0) / 100).toFixed(2));
      }

      function updateFreeShipping(cart) {
        document.querySelectorAll('.free-shipping').forEach(function (el) {
          var threshold = Number(el.dataset.threshold || 0);
          var amountLeft = el.querySelector('[data-amount-left]');
          var progress = el.querySelector('.free-shipping__progress span');
          if (!threshold) return;
          if (progress) progress.style.width = Math.min(100, cart.total_price / threshold * 100) + '%';
          if (cart.total_price >= threshold) {
            el.classList.remove('remaining');
          } else {
            if (amountLeft) amountLeft.textContent = formatCartMoney(threshold - cart.total_price);
            el.classList.add('remaining');
          }
        });
      }

      function renderCartOptions(item) {
        if (item.product_has_only_default_variant || !Array.isArray(item.options_with_values)) return '';
        return item.options_with_values.map(function (option) {
          return '<span class="variant-title"><b>' + escapeHtml(option.name) + ':</b> ' + escapeHtml(option.value) + '</span>';
        }).join('');
      }

      function replaceToken(html, token, value) {
        return String(html).split(token).join(value == null ? '' : String(value));
      }

      function renderFastCartItem(template, item, index) {
        var html = template;
        var image = item.properties && item.properties._variant_image ? item.properties._variant_image : item.image;
        var original = item.final_line_price < item.original_line_price ? '<s>' + formatCartMoney(item.original_line_price) + '</s>' : '';
        var subscription = item.selling_plan_allocation ? '<p>' + escapeHtml(item.selling_plan_allocation.selling_plan.name) + '</p>' : '';

        html = html.replace(/href="[^"]*" class="cart-slideout__image"/, 'href="' + escapeHtml(item.url || '#') + '" class="cart-slideout__image"');
        html = html.replace(/href="[^"]*" class="cart-slideout__title"/, 'href="' + escapeHtml(item.url || '#') + '" class="cart-slideout__title"');
        html = html.replace(/<h5>[\s\S]*?<\/h5>/, '<h5>' + escapeHtml(item.product_title || item.title || '') + '</h5>');
        html = replaceToken(html, '#URL#', item.url || '#');
        html = replaceToken(html, '#HANDLE#', escapeHtml(item.handle || ''));
        html = replaceToken(html, '#TITLE#', escapeHtml(item.product_title || item.title || ''));
        html = replaceToken(html, '#FINALPRICE#', formatCartMoney(item.final_line_price));
        html = replaceToken(html, '#ID#', item.id);
        html = replaceToken(html, '#QTY#', item.quantity);
        html = replaceToken(html, '#INDEX#', index + 1);
        html = replaceToken(html, '#IMG#', image || '');
        html = replaceToken(html, '#OPTIONS#', renderCartOptions(item));
        html = replaceToken(html, '#SUBSCRIPTION#', subscription);
        html = replaceToken(html, '#ORIGINAL#', original);
        html = replaceToken(html, '#STOCK#', '');
        html = replaceToken(html, '#DISABLED#', 'disabled');
        html = replaceToken(html, '#INVALID#', 'invalid');
        return html;
      }

      function normalizeAddedItem(item) {
        var quantity = Number(item.quantity || 1);
        var unitPrice = Number(item.final_price || item.price || 0);
        var linePrice = Number(item.final_line_price || item.line_price || (unitPrice * quantity));
        return Object.assign({}, item, {
          quantity: quantity,
          final_line_price: linePrice,
          original_line_price: Number(item.original_line_price || item.line_price || linePrice),
          product_title: item.product_title || item.title || '',
          product_has_only_default_variant: item.product_has_only_default_variant || !item.variant_title || item.variant_title === 'Default Title',
          options_with_values: item.options_with_values || []
        });
      }

      function getDisplayedCartCount() {
        var countEl = document.querySelector('.cart-icon span, [data-cartcount]');
        var count = countEl ? parseInt(countEl.textContent, 10) : 0;
        return Number.isNaN(count) ? 0 : count;
      }

      function renderOptimisticAddedItem(addedItem) {
        if (!window.enable_slide_cart) return false;
        var templateEl = document.getElementById('cart-template');
        var contents = document.getElementById('cart-slideout-contents');
        if (!templateEl || !contents || !addedItem || !addedItem.id) return false;

        var item = normalizeAddedItem(addedItem);
        var emptyCart = document.querySelector('.cart-slideout .empty-cart');
        var existing = contents.querySelector('.cart-item[data-id="' + item.id + '"]');

        if (emptyCart) emptyCart.style.display = 'none';
        document.body.classList.add('cart-open');
        updateCartCount({ item_count: getDisplayedCartCount() + item.quantity });

        if (existing) {
          var qtyInput = existing.querySelector('input[name^="updates"]');
          var subtotal = existing.querySelector('[data-subtotal]');
          var currentQty = qtyInput ? parseInt(qtyInput.value, 10) : 0;
          var nextQty = (Number.isNaN(currentQty) ? 0 : currentQty) + item.quantity;
          if (qtyInput) qtyInput.value = nextQty;
          if (subtotal) subtotal.textContent = formatCartMoney(Number(item.final_price || item.price || 0) * nextQty);
        } else {
          contents.insertAdjacentHTML('afterbegin', renderFastCartItem(templateEl.innerHTML, item, 0));
        }

        var subtotalEl = document.getElementById('cart-slideout-subtotal');
        if (subtotalEl) {
          var currentSubtotalText = (subtotalEl.textContent || '').replace(/[^0-9,.-]/g, '').replace(',', '.');
          var currentSubtotal = Math.round((parseFloat(currentSubtotalText) || 0) * 100);
          subtotalEl.textContent = formatCartMoney(currentSubtotal + Number(item.final_line_price || item.line_price || 0));
        }
        return true;
      }
      function renderFastSlideCart(cart) {
        updateCartCount(cart);
        updateFreeShipping(cart);

        var templateEl = document.getElementById('cart-template');
        var contents = document.getElementById('cart-slideout-contents');
        var subtotal = document.getElementById('cart-slideout-subtotal');
        var original = document.getElementById('cart-slideout-original');
        var discount = document.getElementById('cart-slideout-discount');
        var emptyCart = document.querySelector('.cart-slideout .empty-cart');

        if (!templateEl || !contents) return false;

        if (!cart.items || !cart.items.length) {
          contents.innerHTML = '<p class="text-center">Tu cesta está vacía.</p>';
          if (emptyCart) emptyCart.style.display = '';
        } else {
          if (emptyCart) emptyCart.style.display = 'none';
          contents.innerHTML = cart.items.map(function (item, index) {
            return renderFastCartItem(templateEl.innerHTML, item, index);
          }).join('');
        }

        if (subtotal) subtotal.textContent = formatCartMoney(cart.total_price);
        if (original) original.textContent = cart.total_price < cart.original_total_price ? formatCartMoney(cart.original_total_price) : '';
        if (discount) discount.textContent = cart.total_discount > 0 ? '-' + formatCartMoney(cart.total_discount) : '';
        return true;
      }

      function refreshSlideCart(cart) {
        if (window.enable_slide_cart && renderFastSlideCart(cart)) {
          document.body.classList.add('cart-open');
          return Promise.resolve();
        }
        updateCartCount(cart);
        return Promise.resolve();
      }
      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!form || !form.matches || !form.matches('#add-to-cart, .sticky-add-to-cart form')) return;

        event.preventDefault();
        event.stopImmediatePropagation();

        var button = form.querySelector('[type="submit"], button[name="add"]');
        if (form.dataset.fastAtcAdding === 'true' || (button && button.disabled)) return;

        syncFormVariant(form);
        form.dataset.fastAtcAdding = 'true';
        setButtonState(button, 'Ajout...', true);

        fetch(getRoute('cart/add.js'), {
          method: 'POST',
          body: new FormData(form),
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' }
        })
          .then(function (response) {
            return response.json().then(function (json) {
              if (!response.ok) throw json;
              return json;
            });
          })
          .then(function (addedItem) {
            setButtonState(button, 'añadido a la cesta', true);
            renderOptimisticAddedItem(addedItem);
            return fetchCart().then(refreshSlideCart).catch(function (cartError) {
              console.error('Cart refresh failed:', cartError);
              if (typeof window._getCart === 'function' && typeof window._populateSlideOutCart === 'function') {
                return window._getCart().then(function (cart) {
                  updateCartCount(cart);
                  document.body.classList.add('cart-open');
                  return window._populateSlideOutCart(cart, true);
                });
              }
            });
          })
          .then(function () {
            if (typeof window._toastAlert === 'function' && !window.enable_slide_cart) {
              window._toastAlert('<p>añadido a la cesta</p>');
            }
          })
          .catch(function (error) {
            console.error('Fast add to cart failed:', error);
            setButtonState(button, 'Erreur', false);
          })
          .finally(function () {
            window.setTimeout(function () {
              form.dataset.fastAtcAdding = 'false';
              restoreButton(button);
              refreshCurrentVariantUI();
            }, 900);
          });
      }, true);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFastProductAddToCart);
    } else {
      initFastProductAddToCart();
    }
  </script>

