  <script>
    (function () {
      'use strict';

      function getSectionRoot(scope) {
        if (scope && scope.matches && scope.matches('[data-custom-nice-product-section]')) return scope;
        return (scope || document).querySelector('[data-custom-nice-product-section]');
      }

      function initPdpMediaGallery(gallery) {
        if (!gallery || gallery.dataset.pdpGalleryReady === 'true') return;
        gallery.dataset.pdpGalleryReady = 'true';
        var slides = Array.prototype.slice.call(gallery.querySelectorAll('.product__media-item'));
        var thumbnails = Array.prototype.slice.call(gallery.querySelectorAll('.thumbnail-2x6-item'));
        var thumbnailGrid = gallery.querySelector('.thumbnail-grid-2x6');
        var dots = Array.prototype.slice.call(gallery.querySelectorAll('.product-media-mobile-dot'));
        var prev = gallery.querySelector('.gallery-arrow--prev');
        var next = gallery.querySelector('.gallery-arrow--next');
        var activeIndex = Math.max(
          0,
          slides.findIndex(function (slide) {
            return slide.classList.contains('is-active');
          })
        );

        function getIndexByMediaId(mediaId) {
          return slides.findIndex(function (slide) {
            return slide.getAttribute('data-media-id') === mediaId;
          });
        }

        function syncThumbnailWindow() {
          if (!thumbnails.length) return;

          var pageSize = 4;
          var pageStart = Math.floor(activeIndex / pageSize) * pageSize;
          pageStart = Math.min(pageStart, Math.max(0, thumbnails.length - pageSize));

          thumbnails.forEach(function (thumb, thumbIndex) {
            var isVisible = thumbIndex >= pageStart && thumbIndex < pageStart + pageSize;
            thumb.classList.toggle('is-thumbnail-page-visible', isVisible);
          });

          if (thumbnailGrid) thumbnailGrid.setAttribute('data-thumbnail-page-ready', 'true');
        }

        function syncControls(activeSlide, scrollThumbnail) {
          if (!activeSlide) return;
          var activeMediaId = activeSlide.getAttribute('data-media-id');

          syncThumbnailWindow();

          thumbnails.forEach(function (thumb) {
            var isActive = thumb.getAttribute('data-media-id') === activeMediaId;
            thumb.classList.toggle('is-active', isActive);
            if (isActive) {
              thumb.setAttribute('aria-current', 'true');
            } else {
              thumb.removeAttribute('aria-current');
            }
          });

          dots.forEach(function (dot, dotIndex) {
            var isActive = dotIndex === activeIndex;
            dot.classList.toggle('is-active', isActive);
            if (isActive) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          });
        }

        function syncFromVisibleSlide(scrollThumbnail) {
          var visibleIndex = slides.findIndex(function (slide) {
            return slide.classList.contains('is-active');
          });
          if (visibleIndex < 0) visibleIndex = 0;
          activeIndex = visibleIndex;
          syncControls(slides[activeIndex], scrollThumbnail);
        }

        function setActive(index) {
          if (!slides.length) return;
          activeIndex = (index + slides.length) % slides.length;
          slides.forEach(function (slide, slideIndex) {
            slide.classList.toggle('is-active', slideIndex === activeIndex);
          });
          syncControls(slides[activeIndex], true);
        }

        thumbnails.forEach(function (thumb, index) {
          thumb.addEventListener('click', function () {
            var mediaIndex = getIndexByMediaId(thumb.getAttribute('data-media-id'));
            setActive(mediaIndex >= 0 ? mediaIndex : index);
          });
        });
        dots.forEach(function (dot, index) {
          dot.addEventListener('click', function () {
            setActive(index);
          });
        });
        if (prev)
          prev.addEventListener('click', function () {
            setActive(activeIndex - 1);
          });
        if (next)
          next.addEventListener('click', function () {
            setActive(activeIndex + 1);
          });
        syncFromVisibleSlide(false);

        if (window.MutationObserver) {
          var observer = new MutationObserver(function () {
            syncFromVisibleSlide(true);
          });
          slides.forEach(function (slide) {
            observer.observe(slide, { attributes: true, attributeFilter: ['class'] });
          });
        }
      }

      function initVariantPicker(scope) {
        var root = getSectionRoot(scope);
        if (!root || root.dataset.variantPickerReady === 'true') return;

        var variantPicker = root.querySelector('#product-variants');
        var selectElement = root.querySelector('#product-selectors');
        if (!variantPicker || !selectElement) return;

        root.dataset.variantPickerReady = 'true';
        var priceElement = root.querySelector('[data-price]');
        var compareElement = root.querySelector('[data-compare]');
        var stockContainer = root.querySelector('#inventory-indicator');
        var addButton = root.querySelector('#product-add-to-cart');
        var lastRequestedVariantId = null;

        if (addButton && !addButton.dataset.availableText) {
          addButton.dataset.availableText = addButton.textContent.trim();
        }

        variantPicker.addEventListener('change', function (event) {
          if (!event.target.classList.contains('variant-radio-input')) return;
          updateSelectedValue(event.target);
          updateVariantSelector();
        });

        function updateSelectedValue(input) {
          var stepElement = input.closest('.variant-step');
          if (!stepElement) return;
          var selectedValue = stepElement.querySelector('[data-selected]');
          if (selectedValue) selectedValue.textContent = input.value;
        }

        function getSelectedOptions() {
          var selectedOptions = [];
          root.querySelectorAll('.variant-options-grid[data-option-position]').forEach(function (container) {
            var position = Number(container.getAttribute('data-option-position'));
            var checked = container.querySelector('.variant-radio-input:checked');
            if (checked) selectedOptions[position] = checked.value;
          });
          return selectedOptions;
        }

        function getVariantOption(variant, index) {
          if (variant.options && variant.options[index] !== undefined) return variant.options[index];
          var key = 'option' + (index + 1);
          return variant[key];
        }

        function findMatchingVariant(selectedOptions) {
          var variants = window.productVariants || (window.product && window.product.variants) || [];
          return variants.find(function (variant) {
            return selectedOptions.every(function (value, index) {
              return value == null || getVariantOption(variant, index) === value;
            });
          });
        }

        function escapeHtml(value) {
          return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        function getImageBase(src) {
          if (!src) return '';
          var anchor = document.createElement('a');
          anchor.href = src;
          return anchor.pathname
            .split('/')
            .pop()
            .replace(/_(\d+x\d*|x\d+)\./, '.');
        }

        function resetGallery(gallery) {
          if (!gallery) return;
          delete gallery.dataset.pdpGalleryReady;
          initPdpMediaGallery(gallery);
        }

        function renderVariantFileGallery(variant, images) {
          var gallery = root.querySelector('.pdp-media-gallery');
          if (!gallery || !images || !images.length) return false;

          var sectionId = root.getAttribute('data-section-id') || 'custom-nice-product';
          var slidesHtml = images
            .map(function (image, index) {
              var mediaId = sectionId + '-variant-' + variant.id + '-file-' + (index + 1);
              return (
                '<li id="Slide-' +
                escapeHtml(mediaId) +
                '" class="product__media-item grid__item slider__slide' +
                (index === 0 ? ' is-active' : '') +
                '" data-media-id="' +
                escapeHtml(mediaId) +
                '">' +
                '<a data-fancybox="gallery" href="' +
                escapeHtml(image.full) +
                '" class="pdp-media-item" aria-label="' +
                escapeHtml(image.alt) +
                '">' +
                '<img src="' +
                escapeHtml(image.large) +
                '" alt="' +
                escapeHtml(image.alt) +
                '" loading="' +
                (index === 0 ? 'eager' : 'lazy') +
                '" width="' +
                escapeHtml(image.width || 1946) +
                '" height="' +
                escapeHtml(image.height || 1946) +
                '" decoding="async" sizes="(max-width: 749px) calc(100vw - 30px), 600px" fetchpriority="' +
                (index === 0 ? 'high' : 'low') +
                '">' +
                '</a>' +
                '</li>'
              );
            })
            .join('');

          var controlsHtml = '';
          if (images.length > 1) {
            controlsHtml =
              '<div class="product-gallery-arrows">' +
              '<button type="button" class="gallery-arrow gallery-arrow--prev" aria-label="Previous image"><span aria-hidden="true">&#8249;</span></button>' +
              '<button type="button" class="gallery-arrow gallery-arrow--next" aria-label="Next image"><span aria-hidden="true">&#8250;</span></button>' +
              '</div>' +
              '<div class="product-media-mobile-dots" data-gallery-dots aria-label="Image pagination">' +
              images
                .map(function (_image, index) {
                  return (
                    '<button type="button" class="product-media-mobile-dot' +
                    (index === 0 ? ' is-active' : '') +
                    '" data-gallery-dot="' +
                    index +
                    '" aria-label="Go to image ' +
                    (index + 1) +
                    '"' +
                    (index === 0 ? ' aria-current="true"' : '') +
                    '></button>'
                  );
                })
                .join('') +
              '</div>' +
              '<div id="GalleryThumbnails2x6-' +
              escapeHtml(sectionId) +
              '" class="thumbnail-grid-2x6">' +
              images
                .map(function (image, index) {
                  var mediaId = sectionId + '-variant-' + variant.id + '-file-' + (index + 1);
                  return (
                    '<button class="thumbnail-2x6-item' +
                    (index === 0 ? ' is-active' : '') +
                    '" data-media-id="' +
                    escapeHtml(mediaId) +
                    '" aria-label="Image ' +
                    (index + 1) +
                    '" type="button"' +
                    (index === 0 ? ' aria-current="true"' : '') +
                    '>' +
                    '<img src="' +
                    escapeHtml(image.thumb) +
                    '" alt="' +
                    escapeHtml(image.alt) +
                    '" loading="lazy" width="' +
                    escapeHtml(image.width || 416) +
                    '" height="' +
                    escapeHtml(image.height || 416) +
                    '" decoding="async">' +
                    '</button>'
                  );
                })
                .join('') +
              '</div>';
          }

          gallery.setAttribute('data-variant-file-gallery', '');
          gallery.innerHTML =
            '<div id="GalleryStatus-' +
            escapeHtml(sectionId) +
            '" class="visually-hidden" role="status"></div>' +
            '<slider-component id="GalleryViewer-' +
            escapeHtml(sectionId) +
            '" class="slider-mobile-gutter">' +
            '<ul id="Slider-Gallery-' +
            escapeHtml(sectionId) +
            '" class="product__media-list contains-media grid grid--peek list-unstyled slider slider--mobile" role="list">' +
            slidesHtml +
            '</ul>' +
            controlsHtml +
            '</slider-component>';
          resetGallery(gallery);
          return true;
        }

        function renderProductMediaGallery(variant) {
          var gallery = root.querySelector('.pdp-media-gallery');
          var mediaItems = window.customNiceProductMedia || [];
          if (!gallery || !mediaItems.length) return false;

          var sectionId = root.getAttribute('data-section-id') || 'custom-nice-product';
          var activeMediaId = variant.featured_media && variant.featured_media.id;
          if (!activeMediaId && variant.featured_image) activeMediaId = variant.featured_image.id;
          var activeIndex = mediaItems.findIndex(function (media) {
            return activeMediaId && String(media.id) === String(activeMediaId);
          });
          if (activeIndex < 0) activeIndex = 0;

          var slidesHtml = mediaItems
            .map(function (media, index) {
              var mediaId = sectionId + '-' + media.id;
              return (
                '<li id="Slide-' +
                escapeHtml(mediaId) +
                '" class="product__media-item grid__item slider__slide' +
                (index === activeIndex ? ' is-active' : '') +
                '" data-media-id="' +
                escapeHtml(mediaId) +
                '">' +
                '<a data-fancybox="gallery" href="' +
                escapeHtml(media.full) +
                '" class="pdp-media-item" aria-label="' +
                escapeHtml(media.alt) +
                '">' +
                '<img src="' +
                escapeHtml(media.large) +
                '" alt="' +
                escapeHtml(media.alt) +
                '" loading="' +
                (index === activeIndex ? 'eager' : 'lazy') +
                '" width="' +
                escapeHtml(media.width || 1946) +
                '" height="' +
                escapeHtml(media.height || 1946) +
                '" decoding="async" sizes="(max-width: 749px) calc(100vw - 30px), 600px" fetchpriority="' +
                (index === activeIndex ? 'high' : 'low') +
                '">' +
                '</a>' +
                '</li>'
              );
            })
            .join('');

          var controlsHtml = '';
          if (mediaItems.length > 1) {
            controlsHtml =
              '<div class="product-gallery-arrows">' +
              '<button type="button" class="gallery-arrow gallery-arrow--prev" aria-label="Previous image"><span aria-hidden="true">&#8249;</span></button>' +
              '<button type="button" class="gallery-arrow gallery-arrow--next" aria-label="Next image"><span aria-hidden="true">&#8250;</span></button>' +
              '</div>' +
              '<div class="product-media-mobile-dots" data-gallery-dots aria-label="Image pagination">' +
              mediaItems
                .map(function (_media, index) {
                  return (
                    '<button type="button" class="product-media-mobile-dot' +
                    (index === activeIndex ? ' is-active' : '') +
                    '" data-gallery-dot="' +
                    index +
                    '" aria-label="Go to image ' +
                    (index + 1) +
                    '"' +
                    (index === activeIndex ? ' aria-current="true"' : '') +
                    '></button>'
                  );
                })
                .join('') +
              '</div>' +
              '<div id="GalleryThumbnails2x6-' +
              escapeHtml(sectionId) +
              '" class="thumbnail-grid-2x6">' +
              mediaItems
                .map(function (media, index) {
                  var mediaId = sectionId + '-' + media.id;
                  return (
                    '<button class="thumbnail-2x6-item' +
                    (index === activeIndex ? ' is-active' : '') +
                    '" data-media-id="' +
                    escapeHtml(mediaId) +
                    '" aria-label="Image ' +
                    (index + 1) +
                    '" type="button"' +
                    (index === activeIndex ? ' aria-current="true"' : '') +
                    '>' +
                    '<img src="' +
                    escapeHtml(media.thumb) +
                    '" alt="' +
                    escapeHtml(media.alt) +
                    '" loading="lazy" width="' +
                    escapeHtml(media.width || 416) +
                    '" height="' +
                    escapeHtml(media.height || 416) +
                    '" decoding="async">' +
                    '</button>'
                  );
                })
                .join('') +
              '</div>';
          }

          gallery.removeAttribute('data-variant-file-gallery');
          gallery.innerHTML =
            '<div id="GalleryStatus-' +
            escapeHtml(sectionId) +
            '" class="visually-hidden" role="status"></div>' +
            '<slider-component id="GalleryViewer-' +
            escapeHtml(sectionId) +
            '" class="slider-mobile-gutter">' +
            '<ul id="Slider-Gallery-' +
            escapeHtml(sectionId) +
            '" class="product__media-list contains-media grid grid--peek list-unstyled slider slider--mobile" role="list">' +
            slidesHtml +
            '</ul>' +
            controlsHtml +
            '</slider-component>';
          resetGallery(gallery);
          return true;
        }

        function selectVariantMedia(variant) {
          var gallery = root.querySelector('.pdp-media-gallery');
          if (!gallery || gallery.hasAttribute('data-variant-file-gallery')) return false;

          var mediaId = variant.featured_media && variant.featured_media.id;
          if (!mediaId && variant.featured_image) mediaId = variant.featured_image.id;
          var variantImageBase = variant.featured_image && getImageBase(variant.featured_image.src);
          if (!mediaId && !variantImageBase) return false;

          var slides = Array.prototype.slice.call(gallery.querySelectorAll('.product__media-item'));
          var targetIndex = slides.findIndex(function (slide) {
            var slideMediaId = slide.getAttribute('data-media-id') || '';
            if (mediaId && slideMediaId.split('-').pop() === String(mediaId)) return true;
            var img = slide.querySelector('img');
            return variantImageBase && img && getImageBase(img.currentSrc || img.src) === variantImageBase;
          });

          if (targetIndex < 0) return false;

          slides.forEach(function (slide, index) {
            slide.classList.toggle('is-active', index === targetIndex);
          });

          var activeMediaId = slides[targetIndex].getAttribute('data-media-id');
          gallery.querySelectorAll('.thumbnail-2x6-item').forEach(function (thumb) {
            var active = thumb.getAttribute('data-media-id') === activeMediaId;
            thumb.classList.toggle('is-active', active);
            if (active) thumb.setAttribute('aria-current', 'true');
            else thumb.removeAttribute('aria-current');
          });
          gallery.querySelectorAll('.product-media-mobile-dot').forEach(function (dot, index) {
            var active = index === targetIndex;
            dot.classList.toggle('is-active', active);
            if (active) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          });
          return true;
        }

        function updateGalleryForVariant(variant) {
          var galleries = window.customNiceVariantGalleries || {};
          var fileImages = galleries[String(variant.id)];
          if (fileImages && fileImages.length) {
            return renderVariantFileGallery(variant, fileImages);
          }
          if (renderProductMediaGallery(variant)) return true;
          return selectVariantMedia(variant);
        }

        function updateVariantSelector() {
          var matching = findMatchingVariant(getSelectedOptions());
          if (!matching) return;

          selectElement.value = String(matching.id);
          selectElement.dispatchEvent(new Event('change', { bubbles: true }));
          updateLocalVariantState(matching);
          var galleryUpdated = updateGalleryForVariant(matching);

          var pageUrl = new URL(window.location.href);
          pageUrl.searchParams.set('variant', matching.id);
          window.history.replaceState({}, '', pageUrl);

          document.dispatchEvent(new CustomEvent('variant:change', { detail: { variant: matching } }));
          document.dispatchEvent(new CustomEvent('product:variant-change', { detail: { variant: matching } }));
          if (!galleryUpdated) selectVariantMedia(matching);
        }

        function priceToCents(price) {
          if (price == null || price === '') return 0;
          if (typeof price === 'number') return price > 999 ? Math.round(price) : Math.round(price * 100);
          var normalized = String(price)
            .replace(/[^0-9.,-]/g, '')
            .replace(',', '.');
          var n = parseFloat(normalized);
          return isNaN(n) ? 0 : Math.round(n * 100);
        }

        function updateLocalVariantState(variant) {
          var isAvailable = isVariantInStock(variant);
          var isPreorder = variant.inventory_policy === 'continue' && !isAvailable;

          var priceCents = priceToCents(variant.price);
          if (priceElement && window.formatMoney) priceElement.textContent = window.formatMoney(priceCents);
          if (compareElement && window.formatMoney) {
            var compareCents = priceToCents(variant.compare_at_price);
            compareElement.innerHTML =
              variant.compare_at_price && compareCents > priceCents
                ? '<s>' + window.formatMoney(compareCents) + '</s>'
                : '';
          }
          if (stockContainer) {
            stockContainer.innerHTML = isAvailable
              ? '<span class="pdp-inventory__status pdp-inventory--available">En stock</span>'
              : '<span class="pdp-inventory__status pdp-inventory--unavailable">Rupture de stock</span>';
          }
          if (addButton) {
            addButton.disabled = !isAvailable && !isPreorder;
            addButton.classList.toggle('pdp-atc-btn--disabled', !isAvailable && !isPreorder);
            addButton.classList.toggle('pdp-atc-btn--primary', isAvailable || isPreorder);
            if (isPreorder) {
              addButton.textContent = addButton.dataset.preorderText || 'Pre-order';
            } else {
              addButton.textContent = isAvailable
                ? addButton.dataset.availableText || 'AÑADIR A LA CESTA'
                : 'Rupture de stock';
            }
          }
        }
      }

      window.initCustomNiceProductSection = function (scope) {
        var root = getSectionRoot(scope);
        if (!root) return;
        root.querySelectorAll('.pdp-media-gallery').forEach(initPdpMediaGallery);
        initVariantPicker(root);
      };

      window.initCustomNiceProductSection(document);
    })();
  </script>
{% endunless %}

