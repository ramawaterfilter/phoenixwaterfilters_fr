}

/* Responsive */
@media (max-width: 768px) {
  .variant-text {
    padding: 0.625rem 1rem;
    font-size: 13px;
    min-width: 70px;
  }
  
  .variant-label {
    font-size: 15px;
  }

  .product-dyn-price {
    font-size: 28px;
  }

  .product-compare-price {
    font-size: 20px;
  }

  .below-atc-icons > div {
    font-size: 13px;
  }
}
</style>

<!-- JavaScript -->
<script>
window.product = {{ product | json }} || {};

console.log('🎯 Product Data Loaded:', window.product);

// CRITICAL: Format Money Function - Must handle both cents and already formatted strings
window.formatMoney = function(cents) {
  console.log('💰 formatMoney called with:', cents, 'Type:', typeof cents);
  
  if (!cents) {
    return '0,00 €';
  }
  
  // If it's already a formatted string with €, return it
  if (typeof cents === 'string' && cents.includes('€')) {
    console.log('Already formatted, returning:', cents);
    return cents;
  }
  
  // Convert to number if string
  if (typeof cents === 'string') {
    cents = parseFloat(cents.replace(/[^0-9.-]/g, ''));
  }
  
  // Shopify prices are in cents, so divide by 100
  const amount = (cents / 100).toFixed(2).replace('.', ',');
  const formatted = amount + ' €';
  console.log('✅ Formatted:', formatted);
  return formatted;
};

// Simple Variant Picker Script with Price & Image Updates
(function() {
  'use strict';
  
  console.log('🚀 Simple Variant Picker Initialized');
  
  let mainSwiperInstance = null;
  let thumbSwiperInstance = null;
  
  function waitForSwiper() {
    const productSlider = document.getElementById('product-slider');
    const thumbSlider = document.getElementById('product-slider-nav');
    
    if (productSlider && thumbSlider) {
      if (window.productSwiper) {
        mainSwiperInstance = window.productSwiper;
        thumbSwiperInstance = window.productSwiperNav;
        console.log('✅ Swiper instances found via window');
      } else if (productSlider.swiper) {
        mainSwiperInstance = productSlider.swiper;
        thumbSwiperInstance = thumbSlider.swiper;
        console.log('✅ Swiper instances found via element');
      } else {
        setTimeout(waitForSwiper, 300);
        return;
      }
    }
    
    initVariantPicker();
  }
  
  function initVariantPicker() {
    const productSelect = document.getElementById('product-select');
    const radios = document.querySelectorAll('.variant-radio');
    
    if (!productSelect || radios.length === 0) {
      console.error('❌ Required elements not found');
      return;
    }
    
    console.log('✅ Found', radios.length, 'variant options');
    console.log('✅ Product has', window.product.variants.length, 'variants');
    
    // Handle radio button changes
    radios.forEach(radio => {
      radio.addEventListener('change', function() {
        if (!this.checked) return;
        
        console.log('📻 Radio changed to:', this.value);
        
        // Update displayed selected value
        const optionIndex = this.getAttribute('data-option-index');
        const selectedValueSpan = document.querySelector(`.selected-variant-value[data-option-index="${optionIndex}"]`);
        if (selectedValueSpan) {
          selectedValueSpan.textContent = this.value;
        }
        
        // Small delay to ensure DOM is updated
        setTimeout(() => {
          updateVariant();
        }, 50);
      });
    });
    
    // Update variant based on selected options
    function updateVariant() {
      console.log('🔄 Starting variant update...');
      
      const selectedOptions = [];
      const optionGroups = document.querySelectorAll('.variant-option-group');
      
      optionGroups.forEach((group, index) => {
        const checkedRadio = group.querySelector('.variant-radio:checked');
        if (checkedRadio) {
          selectedOptions[index] = checkedRadio.value;
          console.log(`Option ${index + 1}:`, checkedRadio.value);
        }
      });
      
      console.log('📋 All selected options:', selectedOptions);
      
      // Find matching variant
      const matchingVariant = window.product.variants.find(variant => {
        const matches = selectedOptions.every((value, index) => {
          return variant.options[index] === value;
        });
        return matches;
      });
      
      if (matchingVariant) {
        console.log('✅ Found variant:', matchingVariant.title);
        console.log('💰 Variant price:', matchingVariant.price);
        console.log('💰 Variant compare_at_price:', matchingVariant.compare_at_price);
        console.log('📦 Variant available:', matchingVariant.available);
        
        // Update hidden select
        productSelect.value = matchingVariant.id;
        
        // Trigger change event
        const event = new Event('change', { bubbles: true });
        productSelect.dispatchEvent(event);
        
        // Update price - CRITICAL PART
        updatePrice(matchingVariant);
        
        // Update availability
        updateAvailability(matchingVariant);
        
        // Update image
        updateImage(matchingVariant);
      } else {
        console.error('❌ No matching variant found for options:', selectedOptions);
      }
    }
    
    // Update price display - ENHANCED VERSION
    function updatePrice(variant) {
      console.log('💰💰💰 UPDATING PRICE 💰💰💰');
      console.log('Variant:', variant);
      console.log('Price:', variant.price);
      console.log('Compare Price:', variant.compare_at_price);
      
      // Get price elements with multiple selectors
      const priceElement = document.getElementById('product-price') || 
                          document.querySelector('[data-price]') || 
                          document.querySelector('.product-dyn-price');
      
      const compareElement = document.getElementById('product-compare-price') || 
                            document.querySelector('[data-compare]') ||
                            document.querySelector('.product-compare-price');
      
      const saleBadge = document.getElementById('sale-badge') || 
                       document.querySelector('.sale-badge');
      
      console.log('Price element found:', !!priceElement);
      console.log('Compare element found:', !!compareElement);
      console.log('Sale badge found:', !!saleBadge);
      
      // Update main price
      if (priceElement) {
        const formattedPrice = formatMoney(variant.price);
        priceElement.textContent = formattedPrice;
        console.log('✅✅✅ PRICE UPDATED TO:', formattedPrice);
      } else {
        console.error('❌ Price element not found!');
      }
      
      // Update compare price
      if (compareElement) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          const formattedCompare = formatMoney(variant.compare_at_price);
          compareElement.innerHTML = '<s>' + formattedCompare + '</s>';
          console.log('✅✅✅ COMPARE PRICE UPDATED TO:', formattedCompare);
          
          // Show sale badge
          if (saleBadge) {
            saleBadge.style.display = 'inline-block';
            console.log('✅ Sale badge shown');
          }
        } else {
          compareElement.innerHTML = '';
          console.log('✅ Compare price cleared (no discount)');
          
          // Hide sale badge
          if (saleBadge) {
            saleBadge.style.display = 'none';
            console.log('✅ Sale badge hidden');
          }
        }
      } else {
        console.error('❌ Compare price element not found!');
      }
    }
    
    // Update add to cart button availability
    function updateAvailability(variant) {
      const addToCartBtn = document.getElementById('product-add-to-cart');
      
      if (addToCartBtn) {
        if (variant.available) {
          addToCartBtn.disabled = false;
          addToCartBtn.textContent = addToCartBtn.getAttribute('data-add-text') || 'Add to Cart';
          console.log('✅ Variant available');
        } else {
          addToCartBtn.disabled = true;
          addToCartBtn.textContent = 'Sold Out';
          console.log('⚠️ Variant sold out');
        }
      }
    }
    
    // Update main product image
    function updateImage(variant) {
      console.log('🖼️ Updating image...');
      
      if (!variant.featured_image || !variant.featured_image.src) {
        console.log('ℹ️ Variant has no specific image');
        return;
      }
      
      const variantImageSrc = variant.featured_image.src;
      console.log('🎯 Looking for image:', variantImageSrc);
      
      // If Swiper is available, use it
      if (mainSwiperInstance) {
        const slides = document.querySelectorAll('#product-slider .swiper-slide');
        let targetIndex = -1;
        
        slides.forEach((slide, index) => {
          const img = slide.querySelector('img');
          if (img && img.src) {
            const imgBase = extractImageBase(img.src);
            const variantBase = extractImageBase(variantImageSrc);
            
            if (imgBase === variantBase) {
              targetIndex = index;
              console.log('✅ Found matching slide at index:', index);
            }
          }
        });
        
        if (targetIndex !== -1) {
          mainSwiperInstance.slideTo(targetIndex, 300);
          if (thumbSwiperInstance) {
            thumbSwiperInstance.slideTo(targetIndex, 300);
          }
          console.log('✅ Image switched successfully!');
        } else {
          console.log('⚠️ No matching slide found');
        }
      } else {
        // For single image, just update the src
        const mainImage = document.querySelector('.product-image img');
        if (mainImage) {
          mainImage.src = variantImageSrc;
          console.log('✅ Single image updated');
        }
      }
    }
    
    // Extract base image filename for comparison
    function extractImageBase(url) {
      if (!url) return '';
      
      let path = url.split('?')[0];
      const parts = path.split('/');
      let filename = parts[parts.length - 1];
      
      // Remove Shopify size parameters
      filename = filename.replace(/_\d+x\d*\.(jpg|jpeg|png|webp|gif)/i, '.$1');
      filename = filename.replace(/_(large|medium|small|compact|grande|original)\.(jpg|jpeg|png|webp|gif)/i, '.$2');
      
      return filename.toLowerCase();
    }
    
    console.log('✅ Variant picker ready');
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitForSwiper);
  } else {
    waitForSwiper();
  }
})();

// Quantity Buttons
document.addEventListener('DOMContentLoaded', function() {
  const qtyInput = document.getElementById('Quantity');
  const decreaseBtn = document.querySelector('.qty-btn.decrease');
  const increaseBtn = document.querySelector('.qty-btn.increase');
  
  if (decreaseBtn && increaseBtn && qtyInput) {
    decreaseBtn.addEventListener('click', function() {
      const currentValue = parseInt(qtyInput.value);
      const minValue = parseInt(qtyInput.min);
      if (currentValue > minValue) {
        qtyInput.value = currentValue - 1;
      }
    });
    
    increaseBtn.addEventListener('click', function() {
      const currentValue = parseInt(qtyInput.value);
      const maxValue = parseInt(qtyInput.max);
      if (currentValue < maxValue) {
        qtyInput.value = currentValue + 1;
      }
    });
  }
});
</script>

