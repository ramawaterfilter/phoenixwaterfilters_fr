      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_3.jpg?v=1761219403',
      title: 'Teak Stand'
    }
  };
  
  // Global function to open Stand Guide popup
  window.openStandGuide = function() {
    console.log('📖 Opening Stand Guide...');
    
    // Find the stand option container
    const standContainer = document.querySelector('[id*="stand-"], [id*="support-"]');
    let selectedStand = 'No Stand'; // Default
    
    if (standContainer) {
      const checkedRadio = standContainer.querySelector('.variant-radio-input:checked');
      if (checkedRadio) {
        selectedStand = checkedRadio.value;
        console.log('✅ Selected stand:', selectedStand);
      }
    }
    
    // Get popup elements
    const popup = document.getElementById('standPopup');
    const image = document.getElementById('standPopupImage');
    const title = document.getElementById('standPopupTitle');
    
    if (!popup || !image || !title) {
      console.error('❌ Popup elements not found!');
      return;
    }
    
    // Find matching stand image
    let standData = standImages[selectedStand];
    
    // If exact match not found, try partial match
    if (!standData) {
      console.log('⚠️ Exact match not found, trying partial match...');
      const standKey = Object.keys(standImages).find(key => 
        selectedStand.toLowerCase().includes(key.toLowerCase()) ||
        key.toLowerCase().includes(selectedStand.toLowerCase())
      );
      standData = standImages[standKey] || standImages['No Stand'];
    }
    
    // Update popup content
    image.src = standData.url;
    title.textContent = standData.title;
    
    // Show popup with animation
    popup.classList.add('active');
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
    
    console.log('✅ Stand guide opened:', standData.title);
  };
  
  // Global function to close Stand Guide popup
  window.closeStandPopup = function() {
    console.log('❌ Closing Stand Guide...');
    const popup = document.getElementById('standPopup');
    if (popup) {
      popup.classList.remove('active');
      document.body.style.overflow = ''; // Restore scrolling
    }
  };
  
  // Close popup when clicking outside (on overlay)
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('stand-popup')) {
      closeStandPopup();
    }
  });
  
  // Close popup on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.keyCode === 27) {
      closeStandPopup();
    }
  });
  
  // Update popup image when stand selection changes
  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('variant-radio-input')) {
      const container = e.target.closest('[id*="stand-"], [id*="support-"]');
      if (container) {
        console.log('🔄 Stand selection changed:', e.target.value);
      }
    }
  });
  
  console.log('✅ Stand Guide System Ready!');
})();
</script>

