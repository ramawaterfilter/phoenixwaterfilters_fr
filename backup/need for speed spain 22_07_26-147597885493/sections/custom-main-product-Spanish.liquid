<style>

.mobile-dots {
  display: none; /* Hidden by default */
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  padding: 10px 0;
}

@media (max-width: 767px) {
  .mobile-dots {
    display: flex !important; /* Show only on mobile */
  }
}

.mobile-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #d1d5db;
  cursor: pointer;
  transition: all 0.3s ease;
}

.mobile-dot.is-active {
  background: #153a5b;
  width: 24px;
  border-radius: 4px;
}


/* Main Thumbnail Slide */
.product-thumb-slide {
  padding: 6px !important;
  height: auto !important;
}

.product-thumb-wrapper {
  border: 2px solid #e0e0e0;
  border-radius: 4px;
  overflow: hidden;
  background: white;
  transition: all 0.3s ease;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Product Image Section */
.product-thumb-image {
  background: #f5f5f7;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 140px;
  flex: 1;
}

.product-thumb-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  max-height: 160px;
}

/* Blue Banner Section */
.product-thumb-banner {
  background: linear-gradient(90deg, #2563eb 0%, #3b82f6 100%);
  padding: 10px 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 56px;
}

.banner-section {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
}

.banner-icon-circle {
  width: 32px;
  height: 32px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.banner-icon-truck {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.banner-icon-truck svg {
  filter: drop-shadow(0 1px 2px rgba(0,0,0,0.1));
}

.banner-text-wrap {
  display: flex;
  flex-direction: column;
  line-height: 1.3;
  gap: 1px;
}

.banner-text-line1 {
  color: #7dd3fc;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.banner-text-line1-alt {
  color: #7dd3fc;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.banner-text-line2 {
  color: #ffffff;
  font-size: 10.5px;
  font-weight: 600;
}

.banner-vertical-line {
  width: 1px;
  height: 32px;
  background: rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}

/* Active State */
.swiper-slide-thumb-active .product-thumb-wrapper {
  border-color: #2563eb;
  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.25);
  transform: translateY(-3px);
}

/* Hover Effect */
.product-thumb-wrapper:hover {
  border-color: #2563eb;
  box-shadow: 0 2px 12px rgba(37, 99, 235, 0.15);
  transform: translateY(-2px);
}

/* Swiper Container */
#product-slider-nav {
  padding: 12px 0;
  margin-top: 12px;
}

#product-slider-nav .swiper-wrapper {
  align-items: stretch;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .product-thumb-image {
    min-height: 120px;
    padding: 15px;
  }
  
  .product-thumb-image img {
    max-height: 140px;
  }
}

@media (max-width: 992px) {
  .product-thumb-image {
    min-height: 100px;
    padding: 12px;
  }
  
  .product-thumb-image img {
    max-height: 120px;
  }
  
  .product-thumb-banner {
    padding: 8px 6px;
    min-height: 52px;
  }
  
  .banner-icon-circle,
  .banner-icon-truck {
    width: 28px;
    height: 28px;
  }
  
  .banner-icon-circle svg,
  .banner-icon-truck svg {
    width: 18px;
    height: 18px;
  }
  
  .banner-text-line1,
  .banner-text-line1-alt,
  .banner-text-line2 {
    font-size: 9.5px;
  }
  
  .banner-vertical-line {
    height: 28px;
  }
}

@media (max-width: 768px) {
  .product-thumb-slide {
    padding: 4px !important;
  }
  
  .product-thumb-image {
    min-height: 80px;
    padding: 10px;
  }
  
  .product-thumb-image img {
    max-height: 100px;
  }
  
  .product-thumb-banner {
    padding: 7px 5px;
    min-height: 48px;
    gap: 6px;
  }
  
  .banner-section {
    gap: 5px;
  }
  
  .banner-icon-circle,
  .banner-icon-truck {
    width: 24px;
    height: 24px;
  }
  
  .banner-icon-circle svg,
  .banner-icon-truck svg {
    width: 16px;
    height: 16px;
  }
  
  .banner-text-line1,
  .banner-text-line1-alt,
  .banner-text-line2 {
    font-size: 8.5px;
  }
  
  .banner-vertical-line {
    height: 24px;
  }
}

@media (max-width: 576px) {
  .product-thumb-image {
    min-height: 70px;
    padding: 8px;
  }
  
  .product-thumb-image img {
    max-height: 85px;
  }
  
  .product-thumb-banner {
    padding: 6px 4px;
    min-height: 44px;
    gap: 4px;
  }
  
  .banner-section {
    gap: 4px;
  }
  
  .banner-icon-circle,
  .banner-icon-truck {
    width: 22px;
    height: 22px;
  }
  
  .banner-icon-circle svg,
  .banner-icon-truck svg {
    width: 14px;
    height: 14px;
  }
  
  .banner-text-line1,
  .banner-text-line1-alt,
  .banner-text-line2 {
    font-size: 7.5px;
  }
  
  .banner-vertical-line {
    height: 22px;
  }
}
</style>
