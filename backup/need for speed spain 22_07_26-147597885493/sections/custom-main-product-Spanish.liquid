<script>
(function() {
  'use strict';
  
  console.log('%c=== Variant Picker (size guide removed) Started ===', 'color: green; font-weight: bold');
  
  // Stand image mapping
  const standImages = {
    'Pas de support': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_1.jpg?v=1761219403',
      title: 'Pas de support'
    },
    'No Stand': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_1.jpg?v=1761219403',
      title: 'No Stand'
    },
    'Support en acier inoxydable': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_2.jpg?v=1761219402',
      title: 'Support en acier inoxydable'
    },
    'Stainless Steel Stand': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_2.jpg?v=1761219402',
      title: 'Stainless Steel Stand'
    },
    'Stainless': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_2.jpg?v=1761219402',
      title: 'Stainless Steel Stand'
    },
    'Support en bois de teck': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_3.jpg?v=1761219402',
      title: 'Support en bois de teck'
    },
    'Wooden Teak Stand': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_3.jpg?v=1761219402',
      title: 'Wooden Teak Stand'
    },
    'Teak Stand': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_3.jpg?v=1761219402',
      title: 'Teak Stand'
    },
    'Wooden': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_3.jpg?v=1761219402',
      title: 'Wooden Teak Stand'
    },
    'Teak': {
      url: 'https://cdn.shopify.com/s/files/1/0739/6235/6836/files/unnamed_3.jpg?v=1761219402',
      title: 'Teak Stand'
    }
  };
  
  // Global popup functions for Stand only
  window.openStandGuide = function() {
    // Get currently selected stand
    const standContainer = document.querySelector('[id*="stand-options"]');
    let selectedStand = 'No Stand';
    
    if (standContainer) {
      const checkedRadio = standContainer.querySelector('.variant-radio-input:checked');
      if (checkedRadio) {
        selectedStand = checkedRadio.value;
      }
    }
    
    console.log('Opening stand guide for:', selectedStand);
    
    const popup = document.getElementById('standPopup');
    const image = document.getElementById('standPopupImage');
    const title = document.getElementById('standPopupTitle');
    
    // Find matching stand image
    let standData = standImages[selectedStand];
    
    // If exact match not found, try partial match
    if (!standData) {
      const standKey = Object.keys(standImages).find(key => 
        selectedStand.toLowerCase().includes(key.toLowerCase()) ||
        key.toLowerCase().includes(selectedStand.toLowerCase())
      );
      standData = standImages[standKey] || standImages['No Stand'];
    }
    
    image.src = standData.url;
    title.textContent = standData.title;
    
    popup.classList.add('active');
    document.body.style.overflow = 'hidden';
    console.log('✅ Stand guide opened with image:', standData.url);
  };
  
  window.closeStandPopup = function() {
    document.getElementById('standPopup').classList.remove('active');
    document.body.style.overflow = '';
  };
  
  // Close stand popup on overlay click
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('stand-popup')) {
      closeStandPopup();
    }
  });
  
  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeStandPopup();
    }
  });
  
  function initVariantPicker() {
    const variantPicker = document.getElementById('product-variants');
    const selectElement = document.querySelector("#product-selectors");
    
    if (!variantPicker || !selectElement) {
      console.error('❌ Required elements not found');
      return;
    }

    console.log('✅ Elements found');
    
    // Add only Stand guide button
    addStandGuideButton();

    // Handle radio button changes
    variantPicker.addEventListener('change', function(event) {
      if (event.target.classList.contains('variant-radio-input')) {
        console.log('%c📻 Radio changed:', 'color: blue', event.target.value);
        
        const valueIndex = event.target.getAttribute('data-value-index');
        
        // Update displayed selected value text
        const stepElement = event.target.closest('.variant-step');
        if (stepElement) {
          const valueDisplays = stepElement.querySelectorAll('.value-display');
          valueDisplays.forEach(display => display.style.display = 'none');
          
          const targetDisplay = stepElement.querySelector('.value-' + valueIndex);
          if (targetDisplay) {
            targetDisplay.style.display = 'inline';
          }
        }
        
        // Update the main variant selector and prices
        updateVariantSelector();
      }
    });

    function addStandGuideButton() {
      // Find stand option step header
      const standStep = document.querySelector('.variant-step.step-stand, .variant-step.step-support');
      if (standStep) {
        const stepHeader = standStep.querySelector('.step-header');
        if (stepHeader && !stepHeader.querySelector('.size-guide-btn')) {
          stepHeader.classList.add('has-guide');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'size-guide-btn';
          button.textContent = 'SIZE GUIDE';
          button.onclick = openStandGuide;
          stepHeader.appendChild(button);
          console.log('✅ Stand guide button added');
        }
      }
    }

    function updateVariantSelector() {
      console.log('%c🔄 Updating variant...', 'color: orange; font-weight: bold');
      
      // Collect all selected option values in correct order
      const selectedOptions = [];
      const optionContainers = document.querySelectorAll('.variant-options-grid[data-option-position]');
      
      console.log(`Found ${optionContainers.length} option groups`);
      
      // Collect selected values in correct order
      optionContainers.forEach((container, index) => {
        const position = container.getAttribute('data-option-position');
        const checkedRadio = container.querySelector('.variant-radio-input:checked');
        if (checkedRadio) {
          selectedOptions[position] = checkedRadio.value;
          console.log(`Option ${parseInt(position) + 1}:`, checkedRadio.value);
        }
      });
      
      console.log('📋 All selected options:', selectedOptions);
      
      // Find matching variant from window.product
      if (!window.product || !window.product.variants) {
        console.error('❌ window.product not available yet, waiting...');
        setTimeout(updateVariantSelector, 200);
        return;
      }
      
      const matchingVariant = window.product.variants.find(variant => {
        return selectedOptions.every((value, index) => {
          return variant.options[index] === value;
        });
      });
      
      if (!matchingVariant) {
        console.error('❌ No matching variant found for:', selectedOptions);
        return;
      }
      
      console.log('✅ Found matching variant:', matchingVariant.title, 'ID:', matchingVariant.id);
      
      // Update hidden select dropdown
      selectElement.value = matchingVariant.id;
      
      // Trigger events
      const changeEvent = new Event('change', { bubbles: true });
      selectElement.dispatchEvent(changeEvent);
      
      if (typeof jQuery !== 'undefined') {
        jQuery(selectElement).trigger('change');
      }
      
      // Update prices directly
      updatePrices(matchingVariant);
    }

    function updatePrices(variant) {
      console.log('%c💰 Updating prices', 'color: purple; font-weight: bold');
      console.log('Price:', variant.price, 'Compare:', variant.compare_at_price);
      
      // Update main price
      const priceElements = [
        document.querySelector('.product-dyn-price'),
        document.querySelector('.priceline [data-price]'),
        document.querySelector('[data-price]:not(option)')
      ];
      
      const priceDisplay = priceElements.find(el => el !== null);
      
      if (priceDisplay) {
        const formattedPrice = formatMoney(variant.price);
        priceDisplay.textContent = formattedPrice;
        console.log('✅ Updated price to:', formattedPrice);
      } else {
        console.error('❌ Price display not found');
      }
      
      // Update compare price
      const compareDisplay = document.querySelector('[data-compare]');
      if (compareDisplay) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          const formattedCompare = formatMoney(variant.compare_at_price);
          compareDisplay.innerHTML = '<s>' + formattedCompare + '</s>';
          console.log('✅ Updated compare price to:', formattedCompare);
        } else {
          compareDisplay.innerHTML = '';
          console.log('✅ Cleared compare price');
        }
      }
    }

    
    
    // Initialize after a delay
    console.log('⏰ Waiting for complete page load...');
    setTimeout(() => {
      console.log('🚀 Initializing variant selector...');
      updateVariantSelector();
      console.log('✅ Initialization complete');
    }, 1000);
  }
  
  // Wait for window.product to be available
  function waitForProduct() {
    if (window.product && window.product.variants) {
      console.log('✅ window.product available');
      initVariantPicker();
    } else {
      console.log('⏰ Waiting for window.product...');
      setTimeout(waitForProduct, 200);
    }
  }
  
  // Start when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitForProduct);
  } else {
    waitForProduct();
  }
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const variantPicker = document.getElementById('product-variants');
  const selectElement = document.querySelector("#product-selectors");
  const priceElement = document.querySelector('[data-price]');
  const compareElement = document.querySelector('[data-compare]');
  
  if (!variantPicker || !selectElement) return;

  // Initialize: set first variant on load
  setTimeout(() => {
    updateVariantSelector();
  }, 100);

  // Handle radio button changes
  variantPicker.addEventListener('change', function(event) {
    if (event.target.classList.contains('variant-radio-input')) {
      const valueIndex = event.target.getAttribute('data-value-index');
      const optionPosition = event.target.getAttribute('data-option-position');
      
      // Update displayed selected value
      const stepElement = event.target.closest('.variant-step');
      if (stepElement) {
        const valueDisplays = stepElement.querySelectorAll('.value-display');
        valueDisplays.forEach(display => {
          display.style.display = 'none';
        });
        
        const targetDisplay = stepElement.querySelector('.value-' + valueIndex);
        if (targetDisplay) {
          targetDisplay.style.display = 'inline';
        }
      }
      
      // Update the main variant selector
      updateVariantSelector();
    }
  });

  function updateVariantSelector() {
    // Collect all selected option values in order
    const selectedOptions = [];
    
    // Get product options count
    const optionContainers = document.querySelectorAll('[data-option-position]');
    const optionsCount = optionContainers.length;
    
    // Collect selected values in correct order
    for (let i = 0; i < optionsCount; i++) {
      const container = document.querySelector(`[data-option-position="${i}"]`);
      if (container) {
        const checkedRadio = container.querySelector('.variant-radio-input:checked');
        if (checkedRadio) {
          selectedOptions[i] = checkedRadio.value;
        }
      }
    }
    
    // Find matching variant
    if (window.product && window.product.variants) {
      const matchingVariant = window.product.variants.find(variant => {
        return selectedOptions.every((value, index) => {
          return variant.options[index] === value;
        });
      });
      
      if (matchingVariant) {
        // Update hidden select
        selectElement.value = matchingVariant.id;
        selectElement.dispatchEvent(new Event('change', { bubbles: true }));
        
        // Update price display
        if (priceElement) {
          priceElement.textContent = formatMoney(matchingVariant.price);
        }
        
        // Update compare at price
        if (compareElement) {
          if (matchingVariant.compare_at_price && matchingVariant.compare_at_price > matchingVariant.price) {
            compareElement.innerHTML = '<s>' + formatMoney(matchingVariant.compare_at_price) + '</s>';
          } else {
            compareElement.innerHTML = '';
          }
        }
      }
    }
  }

 
});


</script>


