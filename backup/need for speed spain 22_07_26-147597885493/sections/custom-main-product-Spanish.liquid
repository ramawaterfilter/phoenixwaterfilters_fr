<script>
(function(){
  if (typeof Swiper === 'undefined') {
    console.warn('Swiper not found: ensure Swiper library is loaded before this script.');
    return;
  }

  let mainSwiper = null;
  let thumbSwiper = null;
  let lastMode = null; // 'mobile' or 'desktop'

  function safeDestroy(sw) {
    try { if (sw && typeof sw.destroy === 'function') sw.destroy(true, true); } catch(e) {}
  }

  function initMobile() {
    safeDestroy(thumbSwiper);
    safeDestroy(mainSwiper);

    // Mobile: show dots pagination, no thumbs
    mainSwiper = new Swiper('#product-slider', {
      spaceBetween: 10,
      slidesPerView: 1,
      loop: false,
      pagination: {
        el: '#product-slider .swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '#product-slider .swiper-button-next',
        prevEl: '#product-slider .swiper-button-prev'
      },
      // disable thumbs linking
      thumbs: false
    });

    window.productMainSwiper = mainSwiper;
    lastMode = 'mobile';
    console.log('Swiper: initialised MOBILE mode (pagination dots enabled).');
  }

  function initDesktop() {
    safeDestroy(thumbSwiper);
    safeDestroy(mainSwiper);

    thumbSwiper = new Swiper('#product-slider-nav', {
      spaceBetween: 8,
      slidesPerView: 4,
      watchSlidesVisibility: true,
      watchSlidesProgress: true,
      centeredSlides: false,
      slideToClickedSlide: true,
      breakpoints: {
        0: { slidesPerView: 4, spaceBetween: 8 },
        480: { slidesPerView: 5, spaceBetween: 8 },
        768: { slidesPerView: 5, spaceBetween: 10 },
        1024: { slidesPerView: 6, spaceBetween: 12 }
      },
      pagination: false,
      navigation: false
    });

    mainSwiper = new Swiper('#product-slider', {
      spaceBetween: 10,
      slidesPerView: 1,
      loop: false,
      navigation: {
        nextEl: '#product-slider .swiper-button-next',
        prevEl: '#product-slider .swiper-button-prev'
      },
      pagination: {
        el: '#product-slider .swiper-pagination',
        clickable: true
      },
      thumbs: {
        swiper: thumbSwiper
      }
    });

    // link controllers as fallback
    try {
      mainSwiper.controller = mainSwiper.controller || {};
      thumbSwiper.controller = thumbSwiper.controller || {};
      mainSwiper.controller.control = thumbSwiper;
      thumbSwiper.controller.control = mainSwiper;
    } catch(e) {}

    window.productMainSwiper = mainSwiper;
    window.productThumbSwiper = thumbSwiper;
    lastMode = 'desktop';
    console.log('Swiper: initialised DESKTOP mode (thumbnails enabled).');
  }

  function handleInit() {
    const isMobile = window.innerWidth <= 768;
    if (isMobile && lastMode !== 'mobile') initMobile();
    if (!isMobile && lastMode !== 'desktop') initDesktop();
  }

  // initialise once DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleInit);
  } else {
    handleInit();
  }

  // re-evaluate on resize (debounced)
  let resizeTimer = null;
  window.addEventListener('resize', function(){
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(handleInit, 250);
  });

})();
</script>




