<script>
(function() {
  'use strict';
  
  console.log('%c=== Variant Image Switcher Started ===', 'color: green; font-weight: bold');
  
  let mainSwiperInstance = null;
  let thumbSwiperInstance = null;
  let isReady = false;
  
  function waitForSwiper() {
    const productSlider = document.getElementById('product-slider');
    const thumbSlider = document.getElementById('product-slider-nav');
    
    if (!productSlider || !thumbSlider) {
      setTimeout(waitForSwiper, 300);
      return;
    }
    
    // Check if Swiper instances are available
    if (window.productSwiper) {
      mainSwiperInstance = window.productSwiper;
      thumbSwiperInstance = window.productSwiperNav;
      isReady = true;
      console.log('✅ Swiper instances found via window');
    } else if (productSlider.swiper) {
      mainSwiperInstance = productSlider.swiper;
      thumbSwiperInstance = thumbSlider.swiper;
      isReady = true;
      console.log('✅ Swiper instances found via element');
    } else {
      setTimeout(waitForSwiper, 300);
      return;
    }
    
    setupVariantImageSwitcher();
  }
  
  function setupVariantImageSwitcher() {
    console.log('🔧 Setting up variant image switcher');
    
    const variantPicker = document.getElementById('product-variants');
    const selectElement = document.querySelector("#product-selectors");
    
    if (!variantPicker || !selectElement) {
      console.error('❌ Required elements not found');
      return;
    }
    
    // Listen to the hidden select element changes
    selectElement.addEventListener('change', function(event) {
      const selectedVariantId = parseInt(event.target.value);
      console.log('%c🔄 Variant changed to ID:', 'color: blue', selectedVariantId);
      switchToVariantImage(selectedVariantId);
    });
    
    // Also listen to radio button changes
    variantPicker.addEventListener('change', function(event) {
      if (event.target.classList.contains('variant-radio-input')) {
        setTimeout(() => {
          const selectedVariantId = parseInt(selectElement.value);
          console.log('%c🔄 Radio changed, variant ID:', 'color: blue', selectedVariantId);
          switchToVariantImage(selectedVariantId);
        }, 100);
      }
    });
    
    console.log('✅ Variant image switcher ready');
  }
  
  function switchToVariantImage(variantId) {
    if (!isReady || !mainSwiperInstance) {
      console.log('⏰ Swiper not ready yet');
      return;
    }
    
    if (!window.product || !window.product.variants) {
      console.error('❌ Product data not available');
      return;
    }
    
    // Find the variant
    const variant = window.product.variants.find(v => v.id === variantId);
    
    if (!variant) {
      console.error('❌ Variant not found:', variantId);
      return;
    }
    
    console.log('✅ Found variant:', variant.title);
    
    // Check if variant has a featured image
    if (!variant.featured_image || !variant.featured_image.src) {
      console.log('ℹ️ Variant has no specific image');
      return;
    }
    
    const variantImageSrc = variant.featured_image.src;
    console.log('🎯 Looking for image:', variantImageSrc);
    
    // Find matching slide by comparing image sources
    const slides = document.querySelectorAll('#product-slider .swiper-slide');
    let targetIndex = -1;
    
    slides.forEach((slide, index) => {
      const img = slide.querySelector('img');
      if (img && img.src) {
        // Extract base filename without size parameters
        const imgBase = extractImageBase(img.src);
        const variantBase = extractImageBase(variantImageSrc);
        
        if (imgBase === variantBase) {
          targetIndex = index;
          console.log('✅ Found matching slide at index:', index);
        }
      }
    });
    
    // Switch to the target slide
    if (targetIndex !== -1) {
      console.log('🔄 Switching to slide:', targetIndex);
      
      if (mainSwiperInstance.slideTo) {
        mainSwiperInstance.slideTo(targetIndex, 300);
      }
      
      if (thumbSwiperInstance && thumbSwiperInstance.slideTo) {
        thumbSwiperInstance.slideTo(targetIndex, 300);
      }
      
      console.log('✅ Image switched successfully!');
    } else {
      console.log('⚠️ No matching slide found');
    }
  }
  
  function extractImageBase(url) {
    if (!url) return '';
    
    // Remove protocol and domain
    let path = url.split('?')[0]; // Remove query params
    
    // Get the filename
    const parts = path.split('/');
    let filename = parts[parts.length - 1];
    
    // Remove Shopify size parameters (e.g., _1200x, _large, etc.)
    filename = filename.replace(/_\d+x\d*\.(jpg|jpeg|png|webp|gif)/i, '.$1');
    filename = filename.replace(/_(large|medium|small|compact|grande|original)\.(jpg|jpeg|png|webp|gif)/i, '.$2');
    
    return filename.toLowerCase();
  }
  
  // Start initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitForSwiper);
  } else {
    waitForSwiper();
  }
})();
</script>



