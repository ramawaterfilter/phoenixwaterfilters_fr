              {% endfor %}                
            </div>
          </div>
        <!-- Replace the existing thumbnail swiper section with this code -->

 <div class="mobile-dots show-mobile-only"></div> 

<script>
(function () {

  function initMobileDots(swiper) {
    if (window.innerWidth > 767) return;

    const paginationEl = document.querySelector('.mobile-dots');
    if (!paginationEl) return;

    // Clear existing dots
    paginationEl.innerHTML = '';

    const slideCount = swiper.slides.length;

    for (let i = 0; i < slideCount; i++) {
      const dot = document.createElement('span');
      dot.className = 'mobile-dot';
      dot.dataset.index = i;
      paginationEl.appendChild(dot);

      dot.addEventListener('click', () => {
        swiper.slideTo(i);
      });
    }

    updateActiveMobileDot(swiper);
  }

  function updateActiveMobileDot(swiper) {
    const dots = document.querySelectorAll('.mobile-dot');
    dots.forEach(dot => dot.classList.remove('is-active'));

    if (dots[swiper.realIndex]) {
      dots[swiper.realIndex].classList.add('is-active');
    }
  }

  function setup() {
    const sliderEl = document.querySelector('#product-slider');
    if (!sliderEl || !sliderEl.swiper) return;

    const swiper = sliderEl.swiper;

    // Initial dots
    initMobileDots(swiper);

    // Update active dot on slide change
    swiper.on('slideChange', () => {
      updateActiveMobileDot(swiper);
    });

    // Rebuild dots on variant change
    document.addEventListener('variant:change', () => {
      setTimeout(() => {
        swiper.slideTo(0, 0);
        initMobileDots(swiper);
      }, 100);
    });
  }

  const waitForSwiper = setInterval(() => {
    const el = document.querySelector('#product-slider');
    if (el && el.swiper) {
      clearInterval(waitForSwiper);
      setup();
    }
  }, 100);

})();
</script>



        
