          "settings": {
            "question": "¿Puedo suscribirme a mis elementos filtrantes?",
            "answer": "<p>Sí, ofrecemos un servicio de suscripción para reemplazar sus artículos para ahorrarle tiempo y tranquilidad.</p>"
          }
