      "settings": {
        "custom_html": "<section class=\"filter-setup\">\n  <div class=\"filter-header\">\n    <h1>Cómo instalar tu filtro</h1>\n  </div>\n\n  <ul class=\"filter-list\">\n    <li><a href=\"#\" data-target=\".ai-embed-section-ad0o4ywvpukdxm05mqaigenblock66d3bc2wgthdr\">Instalación de su sistema de filtración por gravedad Phoenix.</a></li>\n    <li><a href=\"#\" data-target=\".ai-embed-section-ayvevnffnqw1mnmfsnaigenblock66d3bc2bnxhgk\">Cómo instalar sus cartuchos de carbón.</a></li>\n    <li><a href=\"#\" data-target=\".ai-embed-section-aajlqyjdjqwrhuehnsaigenblock66d3bc2twntlj\">Cómo instalar sus cartuchos POSTreat Steel (Reducción de Fluoruro y Arsénico)</a></li>\n    <li><a href=\"#\" data-target=\".ai-embed-section-ats8wzdnhvkyztxbrwaigenblock66d3bc2aegjny\">Instalación de sus cartuchos de Acero al Carbono y POSTreat (Fluoruro y Arsénico)</a></li>\n    <li><a href=\"#\" data-target=\".ai-embed-section-aswvdmwprbenmum9fuaigenblock66d3bc26r97ew\">Cómo cebar sus cartuchos de carbón.</a></li>\n    <li><a href=\"#\" data-target=\".ai-embed-section-ac0oxa281amrsug45raigenblock66d3bc2btmtwb\">Cómo instalar su grifo de acero inoxidable</a></li>\n  </ul>\n</section>",
        "custom_css": ".filter-setup {\n  padding: 50px 0 20px 0;\n  color: #153A5B;\n  max-width: 1400px;\n  margin: 0 auto;\n  background-color: #fff;\n}\n\n.filter-header {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  margin-bottom: 25px;\n}\n\n.filter-icon {\n  width: 60px;\n  height: 60px;\n}\n\n.filter-header h2 {\n  font-size: 36px;\n  font-weight: 700;\n  color: #153A5B;\n  margin: 0;\n}\n\n/* List styling */\n.filter-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.filter-list li {\n  margin: 15px 0;\n}\n\n.filter-list a {\n  text-decoration: none;\n  color: #153A5B;\n  font-size: 18px;\n  transition: color 0.3s ease, text-decoration 0.3s ease;\n}\n\n.filter-list a:hover {\n  color: #0e2d46;\n  text-decoration: underline;\n}\n\n@media (max-width: 768px) {\n  .filter-setup {\n    padding: 30px 20px;\n  }\n\n  .filter-header {\n    flex-direction: row;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .filter-icon {\n    width: 50px;\n    height: 50px;\n  }\n\n  .filter-header h2 {\n    font-size: 26px;\n  }\n\n  .filter-list {\n    margin-top: 15px;\n  }\n\n  .filter-list a {\n    font-size: 16px;\n  }\n}",
        "custom_js": "document.addEventListener(\"DOMContentLoaded\", () => {\n  document.querySelectorAll(\".filter-list a\").forEach(link => {\n    link.addEventListener(\"click\", e => {\n      e.preventDefault();\n      const targetSelector = link.getAttribute(\"data-target\");\n      const targetElement = document.querySelector(targetSelector);\n\n      if (targetElement) {\n        const yOffset = -100; // adjust if you have a sticky header\n        const y = targetElement.getBoundingClientRect().top + window.pageYOffset + yOffset;\n        window.scrollTo({ top: y, behavior: \"smooth\" });\n      }\n    });\n  });\n});"
      }
