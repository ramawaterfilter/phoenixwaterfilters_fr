      "settings": {
        "custom_html": "<div class=\"warranty-section\">\n  <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/10_years_1.png?v=1758890447&width=100\" alt=\"icono de garantía de 10 años\" width=\"50\" height=\"50\" loading=\"lazy\" decoding=\"async\">\n  <span>10 años de garantía</span>\n</div>",
        "custom_css": ".warranty-section {\n      background-color: #f5f3f1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n      gap: 10px;\n      margin-bottom: 30px;\n    }\n\n    .warranty-section img {\n      width: 50px;\n      height: 50px;\n      aspect-ratio: 1 / 1;\n      object-fit: contain;\n    }\n\n    .warranty-section span {\n      font-size: 30px;\n      font-weight: bold;\n      color: #153a5b;\n    }",
