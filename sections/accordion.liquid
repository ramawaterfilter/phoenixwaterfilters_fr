<div class="mb-4 accordion-item" id="accordion-desc">
  <dt class="accordion-item__title">Description</dt>
  <dd class="accordion-item__content">
    <div class="accordion-item__inner">
      <div class="variant-description">
        {{ product.selected_or_first_available_variant.metafields.custom.short_description | metafield_tag }}
      </div>
    </div>
  </dd>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const accordion = document.getElementById('accordion-desc');
  if (!accordion) return;

  const variantSelect = document.querySelector('select[name="id"]');
  const variantDescription = accordion.querySelector('.variant-description');
  if (!variantSelect || !variantDescription) return;

  // Rendered HTML metafields for each variant
  const variantData = {
    {% for variant in product.variants %}
      "{{ variant.id }}": `{{ variant.metafields.custom.short_description | metafield_tag | strip_newlines }}`,
    {% endfor %}
  };

  function updateVariantBox() {
    const selectedVariantId = variantSelect.value;
    let newContent = variantData[selectedVariantId];

    if (!newContent || newContent.trim() === '') {
      newContent = '<p>No details available for this variant.</p>';
    }

    variantDescription.innerHTML = newContent;
  }

  updateVariantBox();
  variantSelect.addEventListener('change', updateVariantBox);
  document.addEventListener('product:variant-change', updateVariantBox);
});
</script>

{% endif %}

