<script>
  document.addEventListener('DOMContentLoaded', function() {
    const postreatItem = document.querySelector('.postreat-item');

    function updatePostreatVisibility() {
      // Variant IDs that include POSTreat
      const postreatVariantIds = ['41868949291051']; // ← You can add more variant IDs here

      const selectedRadio = document.querySelector('input[name="filter type"]:checked');

      if (selectedRadio && postreatVariantIds.includes(selectedRadio.dataset.variantId)) {
        postreatItem.style.display = 'list-item';
      } else {
        postreatItem.style.display = 'none';
      }
    }

    // On page load
    updatePostreatVisibility();

    // Add change listener to radio buttons
    document.querySelectorAll('input[name="filter type"]').forEach(function(radio) {
      radio.addEventListener('change', updatePostreatVisibility);
    });
  });
</script>






<script>
document.addEventListener("DOMContentLoaded", function () {

  // Get the variant select element (Shopify default)
  const variantSelect = document.querySelector('select[name="id"]');

  // Function to show the correct "What's in Box" content
  function updateWhatsInBoxAccordion() {
    if (!variantSelect) return;
    const selectedVariantId = variantSelect.value;

    document.querySelectorAll(".my-variant-accordion .my-variant-container").forEach(container => {
      if(container.dataset.variantId === selectedVariantId) {
        container.style.display = "block"; // Show matching variant
      } else {
        container.style.display = "none";  // Hide others
      }
    });
  }

  // Run on page load
  updateWhatsInBoxAccordion();

  // Run whenever the variant changes
  if(variantSelect) {
    variantSelect.addEventListener("change", updateWhatsInBoxAccordion);
  }

});
</script>




<script>
  document.addEventListener("DOMContentLoaded", function () {
    let currentId = null;

    function updateAccordionContent() {
      const select = document.querySelector('form[action*="/cart/add"] select[name="id"]');
      const newId = select ? select.value : null;

      if (newId !== currentId) {
        currentId = newId;
        document.querySelectorAll(".accordion-stand").forEach(el => {
          const id = el.getAttribute("data-variant-id");
          el.style.display = (id === currentId) ? "block" : "none";
        });
      }
    }

    setInterval(updateAccordionContent, 300); // Check every 300ms
  });
</script>




