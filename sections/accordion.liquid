
 {% assign description = product.metafields.custom.product_description %}
{% assign specifications = product.metafields.custom.specifications %}




{% assign return_policy = product.metafields.custom.product_return_policy %}
{% if return_policy == blank %}
  {% assign return_policy = shop['refund_policy'].body %}
{% endif %}


{% assign row_styles = 'row justify-content-center mb-5' %}
{% assign column_styles = 'col-11 col-md-12' %}
{% if section.settings.accordion_styles == 'center' %}
  {% assign row_styles = 'row justify-content-center mb-5 accordion-padding' %}
  {% assign column_styles = 'col-11 col-md-8' %}
{% endif %}

<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
  <div class="container">

    <div class="{{ row_styles }}">




      
      {% if section.settings.content != blank or section.settings.heading != blank %}
        <div class="col-12 text-center">
          {% if section.settings.heading %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {{ section.settings.content }}
        </div>
      {% endif %}

      <div class="{{ column_styles }}">
        <dl class="accordion">

          {% comment %} {% if description != blank %}
            <div class="mb-4 accordion-item">
              <dt>
                {{ 'products.product.description' | t }}</dt>
              <dd>
                <div class="accordion-item__inner">
                  {{ description | metafield_tag }}
                </div>
              </dd>
            </div>
          {% endif %} {% endcomment %}
           {% if description != blank and product.handle != 'phoenix-gravity-carbon-filter-elements-this-product-not-for-sale' %}
      <div class="mb-4 accordion-item">
        <dt>{{ 'products.product.description' | t }}</dt>
        <dd>
          <div class="accordion-item__inner">
            {{ description | metafield_tag }}
          </div>
        </dd>
      </div>
    {% endif %}

{% if product.title contains 'Le filtre à eau par gravité Phoenix' %}
<div class="mb-4 accordion-item">
  <dt>Description</dt>
  <dd class="mb-4 accordion-spec">
    <div class="tech-accordion-wrapper">

      <!-- PRODUCT DESCRIPTION -->
      <div class="product-description">
        {{ product.description }}
      </div>

    </div>
  </dd>
</div>
{% endif %}

