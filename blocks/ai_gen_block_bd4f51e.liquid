{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  .ai-banner-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.slider_height_desktop }}px;
  }

  .ai-banner-slider__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .ai-banner-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-banner-slider__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-banner-slider__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-banner-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-slider__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.dot_spacing }}px;
    margin-top: {{ block.settings.dots_margin_top }}px;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dot_hover_color }};
    transform: scale(1.2);
  }

  .ai-banner-slider__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.3);
  }

  @media screen and (max-width: 749px) {
    .ai-banner-slider-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
    }

    .ai-banner-slider__wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.slider_height_mobile }}px;
    }

    .ai-banner-slider__dot-{{ ai_gen_id }} {
      width: {{ block.settings.dot_size_mobile }}px;
      height: {{ block.settings.dot_size_mobile }}px;
    }

    .ai-banner-slider__dots-{{ ai_gen_id }} {
      gap: {{ block.settings.dot_spacing_mobile }}px;
      margin-top: {{ block.settings.dots_margin_top_mobile }}px;
    }
  }
{% endstyle %}

<banner-slider-{{ ai_gen_id }} class="ai-banner-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-slider__wrapper-{{ ai_gen_id }}">
    <div class="ai-banner-slider__track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'banner_image_' | append: i
          assign image = block.settings[image_key]
        %}
        <div class="ai-banner-slider__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 40 }}"
              data-src="{{ image | image_url: width: 1600 }}"
              data-srcset="
                {{ image | image_url: width: 480 }} 480w,
                {{ image | image_url: width: 750 }} 750w,
                {{ image | image_url: width: 1100 }} 1100w,
                {{ image | image_url: width: 1600 }} 1600w
              "
              sizes="100vw"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-banner-slider__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-banner-slider__placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="ai-banner-slider__dots-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      <button
        class="ai-banner-slider__dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
        data-slide="{{ i }}"
        aria-label="Go to slide {{ i }}"
      ></button>
    {% endfor %}
  </div>
</banner-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = 5;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-banner-slider__track-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-banner-slider__dot-{{ ai_gen_id }}');
        this.autoplayEnabled = {{ block.settings.enable_autoplay | json }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed | times: 1000 }};

        this.setupEventListeners();
        this.observeSlider();
      }

      observeSlider() {
        if (!('IntersectionObserver' in window)) {
          this.loadSlide(1);
          if (this.autoplayEnabled) this.startAutoplay();
          return;
        }

        this.preloadObserver = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              this.preloadObserver.disconnect();
              this.loadSlide(1);
            }
          },
          { rootMargin: '600px 0px' }
        );

        this.preloadObserver.observe(this);

        if (this.autoplayEnabled) {
          this.visibilityObserver = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                this.startAutoplay();
              } else if (this.autoplayInterval) {
                clearInterval(this.autoplayInterval);
                this.autoplayInterval = null;
              }
            },
            { threshold: 0.1 }
          );

          this.visibilityObserver.observe(this);
        }
      }

      loadSlide(slideNumber) {
        const slide = this.querySelector(`[data-slide="${slideNumber}"]`);
        const image = slide?.querySelector('img[data-src]');

        if (!image) return;

        image.src = image.dataset.src;
        image.srcset = image.dataset.srcset;
        image.removeAttribute('data-src');
        image.removeAttribute('data-srcset');
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.dataset.slide);
            this.goToSlide(slideNumber);
            if (this.autoplayEnabled) {
              this.resetAutoplay();
            }
          });
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.track.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        this.track.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe(touchStartX, touchEndX);
        });
      }

      handleSwipe(startX, endX) {
        const swipeThreshold = 50;
        const diff = startX - endX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.prevSlide();
          }
          if (this.autoplayEnabled) {
            this.resetAutoplay();
          }
        }
      }

      goToSlide(slideNumber) {
        this.currentSlide = slideNumber;
        this.loadSlide(slideNumber);
        this.loadSlide(slideNumber >= this.totalSlides ? 1 : slideNumber + 1);
        const offset = (slideNumber - 1) * -100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index + 1 === slideNumber) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      nextSlide() {
        this.currentSlide = this.currentSlide >= this.totalSlides ? 1 : this.currentSlide + 1;
        this.goToSlide(this.currentSlide);
      }

      prevSlide() {
        this.currentSlide = this.currentSlide <= 1 ? this.totalSlides : this.currentSlide - 1;
        this.goToSlide(this.currentSlide);
      }

      startAutoplay() {
        if (this.autoplayInterval) return;
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.preloadObserver) this.preloadObserver.disconnect();
        if (this.visibilityObserver) this.visibilityObserver.disconnect();
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('banner-slider-{{ ai_gen_id }}', BannerSlider{{ ai_gen_id }});
  })();
</script>

