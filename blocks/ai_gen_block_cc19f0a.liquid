{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 40px 20px;
  }

  .ai-video-gallery__outer-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.container_background }};
    border-radius: {{ block.settings.container_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-video-gallery__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: {{ block.settings.card_gap }}px;
    width: 100%;
  }

  .ai-video-gallery__card-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: visible;
    background-color: {{ block.settings.card_background }};
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    display: flex;
    flex-direction: column;
    transform: scale(1);
    z-index: 1;
  }

  .ai-video-gallery__card-{{ ai_gen_id }}.is-active {
    transform: scale({{ block.settings.active_zoom_scale }});
    z-index: 10;
  }

  .ai-video-gallery__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 12px 0;
    z-index: 15;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {{ block.settings.heading_transform }};
    padding: 0 4px;
  }

  .ai-video-gallery__card-inner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    flex: 1;
    border-radius: {{ block.settings.inner_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-gallery__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #000000;
  }

  .ai-video-gallery__video-wrapper-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-gallery__dots-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }

  .ai-video-gallery__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-video-gallery__dot-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.dot_active_color }};
    opacity: 0.7;
  }

  .ai-video-gallery__dot-{{ ai_gen_id }}.is-active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.3);
  }

  {{ block.settings.custom_css }}

  @media screen and (max-width: 989px) {
    .ai-video-gallery__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-video-gallery-{{ ai_gen_id }} {
      padding: 20px 0 10px;
    }

    .ai-video-gallery__outer-container-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_container_padding }}px;
      border-radius: 0;
    }

    .ai-video-gallery__container-{{ ai_gen_id }} {
      display: flex;
      gap: {{ block.settings.mobile_card_gap }}px;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding: 0 {{ block.settings.mobile_side_padding }}px;
      scrollbar-width: none;
    }

    .ai-video-gallery__container-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-video-gallery__card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_card_width }}%;
      scroll-snap-align: center;
      padding: 0;
      border: none;
    }

    .ai-video-gallery__card-{{ ai_gen_id }}.is-active {
      transform: scale({{ block.settings.mobile_zoom_scale }});
    }

    .ai-video-gallery__dots-{{ ai_gen_id }} {
      display: flex;
      margin-top: 16px;
    }

    .ai-video-gallery__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
      margin-bottom: 8px;
    }
  }
{% endstyle %}

<video-gallery-{{ ai_gen_id }}
  class="ai-video-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-gallery__outer-container-{{ ai_gen_id }}">
    <div class="ai-video-gallery__container-{{ ai_gen_id }}">
      {% assign video_count = 0 %}
      {% for i in (1..6) %}
        {% liquid
          assign video_key = 'video_' | append: i
          assign heading_key = 'heading_' | append: i
          
          assign video_embed = block.settings[video_key]
          assign heading = block.settings[heading_key]
        %}

        {% if video_embed != blank %}
          {% assign video_count = video_count | plus: 1 %}
          <div
            class="ai-video-gallery__card-{{ ai_gen_id }} {% if video_count == 1 %}is-active{% endif %}"
            data-video-index="{{ video_count | minus: 1 }}"
          >
            {% if heading != blank %}
              <h3 class="ai-video-gallery__heading-{{ ai_gen_id }}">{{ heading }}</h3>
            {% endif %}

            <div class="ai-video-gallery__card-inner-{{ ai_gen_id }}">
              <div class="ai-video-gallery__video-wrapper-{{ ai_gen_id }}">
                {{ video_embed }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if video_count > 1 %}
      <div class="ai-video-gallery__dots-{{ ai_gen_id }}">
        {% for i in (1..video_count) %}
          <button
            class="ai-video-gallery__dot-{{ ai_gen_id }} {% if forloop.first %}is-active{% endif %}"
            data-dot-index="{{ forloop.index | minus: 1 }}"
            aria-label="View video {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</video-gallery-{{ ai_gen_id }}>

<script>
  (function () {
    class VideoGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = [];
        this.videos = [];
        this.activeIndex = 0;
        this.isMobile = window.innerWidth <= 749;
        this.isScrolling = false;
        this.scrollTimeout = null;
      }

      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('.ai-video-gallery__card-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-video-gallery__dot-{{ ai_gen_id }}'));
        this.container = this.querySelector('.ai-video-gallery__container-{{ ai_gen_id }}');

        if (this.cards.length === 0) return;

        this.initializeVideos();
        this.setupEventListeners();

        if (this.isMobile) {
          this.setupMobileScroll();
        }
      }

      initializeVideos() {
        this.cards.forEach((card, index) => {
          const iframe = card.querySelector('iframe');
          if (!iframe) return;

          const videoData = {
            iframe: iframe,
            card: card,
            isPlaying: false,
            isMuted: true,
          };

          this.videos.push(videoData);

          if (index === 0) {
            this.playVideo(videoData);
          }
        });
      }

      setupEventListeners() {
        this.cards.forEach((card, index) => {
          card.addEventListener('click', () => {
            this.activateCard(index);
          });
        });

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', (e) => {
            e.preventDefault();
            this.activateCard(index);
            if (this.isMobile) {
              this.scrollToCard(index);
            }
          });
        });
      }

      setupMobileScroll() {
        this.container.addEventListener('scroll', () => {
          if (this.isScrolling) {
            clearTimeout(this.scrollTimeout);
          }
          
          this.isScrolling = true;
          
          this.scrollTimeout = setTimeout(() => {
            this.updateActiveCardFromScroll();
            this.isScrolling = false;
          }, 150);
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.container.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        this.container.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe(touchStartX, touchEndX);
        }, { passive: true });
      }

      handleSwipe(startX, endX) {
        const swipeThreshold = 50;
        const diff = startX - endX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0 && this.activeIndex < this.cards.length - 1) {
            this.activateCard(this.activeIndex + 1);
            this.scrollToCard(this.activeIndex);
          } else if (diff < 0 && this.activeIndex > 0) {
            this.activateCard(this.activeIndex - 1);
            this.scrollToCard(this.activeIndex);
          }
        }
      }

      updateActiveCardFromScroll() {
        const containerRect = this.container.getBoundingClientRect();
        const containerCenter = containerRect.left + containerRect.width / 2;

        let closestIndex = 0;
        let closestDistance = Infinity;

        this.cards.forEach((card, index) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const distance = Math.abs(cardCenter - containerCenter);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        if (closestIndex !== this.activeIndex) {
          this.activateCard(closestIndex);
        }
      }

      scrollToCard(index) {
        const card = this.cards[index];
        if (!card) return;

        const containerRect = this.container.getBoundingClientRect();
        const cardRect = card.getBoundingClientRect();
        const scrollLeft = this.container.scrollLeft;
        const offset = cardRect.left - containerRect.left;
        const targetScroll = scrollLeft + offset - (containerRect.width - cardRect.width) / 2;

        this.container.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
      }

      activateCard(index) {
        if (index === this.activeIndex) return;

        this.cards.forEach((card, i) => {
          if (i === index) {
            card.classList.add('is-active');
          } else {
            card.classList.remove('is-active');
          }
        });

        this.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('is-active');
          } else {
            dot.classList.remove('is-active');
          }
        });

        this.videos.forEach((videoData, i) => {
          if (i === index) {
            this.playVideo(videoData);
          } else {
            this.pauseVideo(videoData);
          }
        });

        this.activeIndex = index;
      }

      playVideo(videoData) {
        const iframe = videoData.iframe;
        iframe.contentWindow.postMessage(
          JSON.stringify({ method: 'play' }),
          '*'
        );
        videoData.isPlaying = true;
      }

      pauseVideo(videoData) {
        const iframe = videoData.iframe;
        iframe.contentWindow.postMessage(
          JSON.stringify({ method: 'pause' }),
          '*'
        );
        videoData.isPlaying = false;
      }
    }

    customElements.define('video-gallery-{{ ai_gen_id }}', VideoGallery{{ ai_gen_id }});
  })();
</script>

