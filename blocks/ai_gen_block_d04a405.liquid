
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .hero-banner__background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-banner__background-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-banner__background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .hero-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 2;
  }

  .hero-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1200px;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    text-align: {{ block.settings.text_alignment }};
  }

  .hero-banner__text-block-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .hero-banner__heading-{{ ai_gen_id }} {
    margin: 0;
    line-height: 1.2;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
  }

  .hero-banner__subheading-{{ ai_gen_id }} {
    margin: 0;
    line-height: 1.4;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size_mobile }}px;
  }

  .hero-banner__description-{{ ai_gen_id }} {
    margin: 0;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size_mobile }}px;
  }

  .hero-banner__button-block-{{ ai_gen_id }} {
    display: inline-flex;
  }

  .hero-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    text-decoration: none;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    transition: opacity 0.3s ease;
  }

  .hero-banner__button-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .hero-banner-{{ ai_gen_id }} {
      min-height: 400px;
    }

    .hero-banner__background-image-desktop-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .hero-banner__background-image-mobile-{{ ai_gen_id }} {
      display: none;
    }

    .hero-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .hero-banner__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }

    .hero-banner__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="hero-banner__background-{{ ai_gen_id }}">
    {% if block.settings.background_image_desktop or block.settings.background_image_mobile %}
      {% if block.settings.background_image_desktop %}
        <img
          src="{{ block.settings.background_image_desktop | image_url: width: 2000 }}"
          alt="{{ block.settings.background_image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.background_image_desktop.width }}"
          height="{{ block.settings.background_image_desktop.height }}"
          class="hero-banner__background-image-{{ ai_gen_id }} hero-banner__background-image-desktop-{{ ai_gen_id }}"
        >
      {% endif %}
      {% if block.settings.background_image_mobile %}
        <img
          src="{{ block.settings.background_image_mobile | image_url: width: 1000 }}"
          alt="{{ block.settings.background_image_mobile.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.background_image_mobile.width }}"
          height="{{ block.settings.background_image_mobile.height }}"
          class="hero-banner__background-image-{{ ai_gen_id }} hero-banner__background-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}
    {% else %}
      <div class="hero-banner__background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_overlay %}
    <div class="hero-banner__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="hero-banner__content-{{ ai_gen_id }}">
    <div class="hero-banner__text-block-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="hero-banner__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <h2 class="hero-banner__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="hero-banner__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </p>
      {% endif %}
    </div>

    {% if block.settings.button_label != blank %}
      <div class="hero-banner__button-block-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="hero-banner__button-{{ ai_gen_id }}">
          {{ block.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": null,
  "class": "hero-banner-block",
  "settings": [
    {
      "type": "header",
      "content": "Background images"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Desktop background"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show dark overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover amazing products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Shop our latest collection and find exactly what you need"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Desktop font sizes"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "label": "Description",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Mobile font sizes"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description",
      "min": 10,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
